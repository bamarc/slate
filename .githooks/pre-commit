#!/usr/bin/env bash
# Git pre-commit hook: run security scan (and sync reference tfvars if present)
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

if [ -x "$ROOT_DIR/reference/infrastructure/layers/sync_tfvars.py" ]; then
  "$ROOT_DIR/reference/infrastructure/layers/sync_tfvars.py"
fi

"$ROOT_DIR/scripts/security-scan.sh"
