import { SlateTheme } from "../components/theme.slint";
import { SlateHeaderBar } from "../components/header_bar.slint";

export component SlateWindow inherits Window {
    title: "Slate App";
    in property <string> subtitle: "";
    in property <bool> show-header: true;

    background: SlateTheme.background;
    default-font-family: "Inter, Cantarell, Ubuntu, sans-serif";
    min-width: 640px;
    min-height: 480px;

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        if root.show-header : SlateHeaderBar {
            title: root.title;
            subtitle: root.subtitle;
        }

        @children
    }
}
