import { SlateTheme } from "../components/theme.slint";
import { SlateHomeIcon, SlateShieldIcon, SlateGridIcon, SlatePaletteIcon } from "../components/icons.slint";

export struct SlateWebNavItem {
    label: string,
    // 0: home, 1: shield, 2: grid
    icon: int,
}

export component SlateWebCard {
    in property <string> title: "";
    in property <string> description: "";

    // Web design sizes without a SlateTheme token
    property <length> title-size: 16px;
    property <length> description-size: 14px;

    Rectangle {
        background: SlateTheme.surface-1;
        border-radius: SlateTheme.radius-md;
        border-width: 1px;
        border-color: SlateTheme.border-subtle;

        VerticalLayout {
            padding: SlateTheme.spacing-lg;
            spacing: SlateTheme.spacing-md;
            alignment: start;

            if root.title != "" || root.description != "" : VerticalLayout {
                spacing: SlateTheme.spacing-xs;
                if root.title != "" : Text {
                    text: root.title;
                    font-size: root.title-size;
                    font-weight: 600;
                    color: SlateTheme.text-primary;
                }
                if root.description != "" : Text {
                    text: root.description;
                    font-size: root.description-size;
                    color: SlateTheme.text-muted;
                }
            }

            @children
        }
    }
}

// One entry of the user dropdown.
component UserMenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> destructive: false;
    callback clicked();

    height: 32px;
    border-radius: SlateTheme.radius-xs;
    background: touch.pressed ? SlateTheme.surface-active
        : touch.has-hover ? SlateTheme.surface-hover : Colors.transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        accessible-role: list-item;
        accessible-label: root.text;
        accessible-action-default => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: SlateTheme.spacing-sm + SlateTheme.spacing-xs;
        padding-right: SlateTheme.spacing-sm + SlateTheme.spacing-xs;

        Text {
            text: root.text;
            font-size: SlateTheme.font-sm;
            color: root.destructive ? SlateTheme.status-error : SlateTheme.text-primary;
            vertical-alignment: center;
        }
    }
}

// Full-width bar with a 1px bottom divider; children are laid out in a padded row.
component ShellBar inherits Rectangle {
    Rectangle {
        y: root.height - 1px;
        height: 1px;
        background: SlateTheme.border-subtle;
    }

    HorizontalLayout {
        padding-left: SlateTheme.spacing-xl;
        padding-right: SlateTheme.spacing-xl;
        alignment: space-between;

        @children
    }
}

// Filled rounded square / circle containing short text (logo, avatar).
component InitialsBadge inherits Rectangle {
    in property <string> text;
    in property <length> font-size;
    background: SlateTheme.accent-primary;

    Text {
        text: root.text;
        color: SlateTheme.accent-text;
        font-size: root.font-size;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One entry of the top navigation.
component NavLink inherits Rectangle {
    in property <string> label;
    in property <int> icon;
    in property <bool> active;
    callback clicked();

    // Web design metrics without a SlateTheme token
    property <length> link-height: 34px;
    property <length> link-padding: 12px;
    property <length> icon-gap: 6px;

    height: root.link-height;
    border-radius: SlateTheme.radius-sm;
    background: root.active ? SlateTheme.surface-2
        : touch.has-hover ? SlateTheme.surface-hover : Colors.transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
        accessible-role: tab;
        accessible-label: root.label;
        accessible-item-selectable: true;
        accessible-item-selected: root.active;
        accessible-action-default => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: root.link-padding;
        padding-right: root.link-padding;
        spacing: root.icon-gap;
        alignment: center;

        VerticalLayout {
            alignment: center;

            if root.icon == 0 : SlateHomeIcon { icon-color: SlateTheme.text-secondary; }
            if root.icon == 1 : SlateShieldIcon { icon-color: SlateTheme.text-secondary; }
            if root.icon == 2 : SlateGridIcon { icon-color: SlateTheme.text-secondary; }
        }

        Text {
            text: root.label;
            font-size: SlateTheme.font-sm;
            font-weight: root.active ? 600 : 500;
            color: root.active ? SlateTheme.text-primary : SlateTheme.text-secondary;
            vertical-alignment: center;
        }
    }
}

// One option of the design switch pill (radio-like: exactly one option is active).
component SwitchOption inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    // Web design metrics without a SlateTheme token
    property <length> option-height: 24px;
    property <length> padding-active: 8px;
    property <length> padding-idle: 6px;

    height: root.option-height;
    border-radius: SlateTheme.radius-xs;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: SlateTheme.focus-ring;
    background: root.active ? SlateTheme.surface-3
        : touch.pressed ? SlateTheme.surface-active
        : touch.has-hover ? SlateTheme.surface-hover : Colors.transparent;

    focus := FocusScope {
        accessible-role: radio-button;
        accessible-label: root.text;
        accessible-checkable: true;
        accessible-checked: root.active;
        accessible-action-default => { root.clicked(); }
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: root.active ? root.padding-active : root.padding-idle;
        padding-right: root.active ? root.padding-active : root.padding-idle;
        alignment: center;

        Text {
            text: root.text;
            font-size: SlateTheme.font-xs;
            font-weight: root.active ? 600 : 500;
            color: root.active ? SlateTheme.text-primary : SlateTheme.text-muted;
            vertical-alignment: center;
        }
    }
}

export component SlateWebAppLayout {
    in property <string> app-name: "Fullstack Template";
    in property <string> app-description: "React + Vite + Tailwind + FastAPI";
    in property <string> user-name: "Test Developer";
    in property <string> user-role: "Administrator";
    in property <string> user-initials: "TD";
    in property <string> page-title: "Component Showcase";
    in property <string> page-badge: "44+ components";

    in-out property <int> active-nav: 2; // index into nav-items (default: Komponenten)
    in-out property <int> active-tab: 0;
    in property <[SlateWebNavItem]> nav-items: [
        { label: "Dashboard", icon: 0 },
        { label: "Admin", icon: 1 },
        { label: "Komponenten", icon: 2 },
    ];
    in property <[string]> tabs: [
        "Buttons & Badges",
        "Forms & Inputs",
        "Data Display",
        "Feedback",
        "Navigation",
        "Overlays",
        "Components"
    ];

    // Whether the user dropdown is open
    in-out property <bool> user-menu-open: false;
    // Labels of the design switch: [light, dark]
    in property <[string]> design-labels: ["Light", "Dark"];
    // Labels of the user dropdown entries; the theme entry (index 2) reflects the current design
    in property <[string]> user-menu-items: ["Profile", "Settings", SlateTheme.is-dark ? "Light mode" : "Dark mode", "Sign out"];
    // Tab strip is only shown on the tabbed showcase page (nav index 2)
    in property <bool> show-tabs: root.active-nav == 2;
    in property <string> status-text: "Web Mirror Mode";

    callback tab-selected(int);
    callback nav-selected(int);
    // Fired when the design switch asks for the other design (light <-> dark)
    callback toggle-design();
    // Fired with the index of the clicked user menu entry (0 profile, 1 settings, 2 theme, 3 sign out)
    callback user-menu-selected(int);

    // Web design metrics (mirroring the React AppLayout) without a SlateTheme token
    property <length> header-height: 64px;
    property <length> subheader-height: 48px;
    property <length> logo-size: 40px;
    property <length> brand-title-size: 17px;
    property <length> brand-subtitle-size: 12px;
    property <length> title-gap: 2px;
    property <length> nav-gap: 4px;
    property <length> switch-height: 32px;
    property <length> switch-padding-left: 8px;
    property <length> switch-padding-right: 4px;
    property <length> switch-gap: 6px;
    property <length> user-height: 38px;
    property <length> user-padding: 8px;
    property <length> avatar-size: 32px;
    property <length> user-text-gap: 1px;
    property <length> badge-height: 22px;
    property <length> badge-padding: 8px;
    property <length> status-dot: 8px;
    property <length> tab-strip-height: 40px;
    property <length> tab-strip-padding: 4px;
    property <length> tab-height: 32px;
    property <length> tab-padding: 14px;
    property <length> menu-width: 200px;

    width: 100%;
    height: 100%;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        // 1. Top app header matching web AppLayout
        ShellBar {
            height: root.header-height;
            vertical-stretch: 0;
            background: SlateTheme.surface-1;

            // Left: Logo & Brand + Top Nav
            HorizontalLayout {
                spacing: SlateTheme.spacing-xl;
                alignment: start;

                // Brand: Logo + Title + Subtitle
                HorizontalLayout {
                    spacing: SlateTheme.spacing-sm + SlateTheme.spacing-xs;
                    alignment: center;

                    InitialsBadge {
                        width: root.logo-size;
                        height: root.logo-size;
                        border-radius: SlateTheme.radius-md;
                        text: "T";
                        font-size: SlateTheme.font-lg;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: root.title-gap;

                        Text {
                            text: root.app-name;
                            font-size: root.brand-title-size;
                            font-weight: 700;
                            color: SlateTheme.text-primary;
                        }

                        Text {
                            text: root.app-description;
                            font-size: root.brand-subtitle-size;
                            color: SlateTheme.text-muted;
                        }
                    }
                }

                // Top horizontal nav links
                HorizontalLayout {
                    spacing: root.nav-gap;
                    alignment: center;

                    for item[idx] in root.nav-items : NavLink {
                        label: item.label;
                        icon: item.icon;
                        active: root.active-nav == idx;
                        clicked => {
                            root.active-nav = idx;
                            root.nav-selected(idx);
                        }
                    }
                }
            }

            // Right: Design switch + User Profile
            HorizontalLayout {
                spacing: SlateTheme.spacing-md;
                alignment: center;

                // Design switch: [palette | Light | Dark]
                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        height: root.switch-height;
                        border-radius: SlateTheme.radius-sm;
                        border-width: 1px;
                        border-color: SlateTheme.border-subtle;
                        background: SlateTheme.background;
                        accessible-role: groupbox;
                        accessible-label: "Design";

                        HorizontalLayout {
                            padding-left: root.switch-padding-left;
                            padding-right: root.switch-padding-right;
                            padding-top: 3px;
                            padding-bottom: 3px;
                            spacing: root.switch-gap;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                SlatePaletteIcon {
                                    icon-color: SlateTheme.text-muted;
                                    width: SlateTheme.font-xs + 1px;
                                    height: SlateTheme.font-xs + 1px;
                                }
                            }

                            SwitchOption {
                                text: root.design-labels[0];
                                active: !SlateTheme.is-dark;
                                clicked => { if (SlateTheme.is-dark) { root.toggle-design(); } }
                            }
                            SwitchOption {
                                text: root.design-labels[1];
                                active: SlateTheme.is-dark;
                                clicked => { if (!SlateTheme.is-dark) { root.toggle-design(); } }
                            }
                        }
                    }
                }

                // User Profile Button
                VerticalLayout {
                    alignment: center;

                Rectangle {
                    height: root.user-height;
                    border-radius: SlateTheme.radius-sm;
                    border-width: user-focus.has-focus ? 2px : 0px;
                    border-color: SlateTheme.focus-ring;
                    background: root.user-menu-open || user-touch.pressed ? SlateTheme.surface-active
                        : user-touch.has-hover ? SlateTheme.surface-hover : Colors.transparent;

                    user-focus := FocusScope {
                        accessible-role: button;
                        accessible-label: "User menu: " + root.user-name + ", " + root.user-role;
                        accessible-expandable: true;
                        accessible-expanded: root.user-menu-open;
                        accessible-action-default => { root.user-menu-open = !root.user-menu-open; }
                        accessible-action-expand => { root.user-menu-open = true; }
                        key-pressed(event) => {
                            if (event.text == " " || event.text == Key.Return || event.text == Key.DownArrow) {
                                root.user-menu-open = true;
                                return accept;
                            }
                            return reject;
                        }
                    }

                    user-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            user-focus.focus();
                            root.user-menu-open = !root.user-menu-open;
                        }
                    }

                    HorizontalLayout {
                        padding-left: root.user-padding;
                        padding-right: root.user-padding;
                        spacing: root.user-padding;
                        alignment: center;

                        InitialsBadge {
                            width: root.avatar-size;
                            height: root.avatar-size;
                            border-radius: SlateTheme.radius-lg;
                            text: root.user-initials;
                            font-size: SlateTheme.font-xs + 1px;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: root.user-text-gap;

                            Text {
                                text: root.user-name;
                                font-size: SlateTheme.font-sm;
                                font-weight: 500;
                                color: SlateTheme.text-primary;
                            }

                            Text {
                                text: root.user-role;
                                font-size: SlateTheme.font-xs;
                                color: SlateTheme.text-muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            // Down chevron, flipped (up) while the menu is open
                            Path {
                                width: 10px;
                                height: 10px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: root.user-menu-open ? "M 5 16 L 12 8 L 19 16" : "M 5 8 L 12 16 L 19 8";
                                stroke: SlateTheme.text-muted;
                                stroke-width: 1.5px;
                                stroke-line-cap: round;
                                stroke-line-join: round;
                            }
                        }
                    }
                }
                }
            }
        }

        // 2. Subheader / page title bar matching web Component Showcase header
        ShellBar {
            height: root.subheader-height;
            vertical-stretch: 0;
            background: SlateTheme.background;

            HorizontalLayout {
                spacing: SlateTheme.spacing-md;
                alignment: start;

                Text {
                    text: root.page-title;
                    font-size: SlateTheme.font-lg;
                    font-weight: 700;
                    color: SlateTheme.text-primary;
                    vertical-alignment: center;
                }

                // Badge pill "44+ components", vertically centred next to the title
                if root.page-badge != "" : VerticalLayout {
                    alignment: center;

                    Rectangle {
                        height: root.badge-height;
                        border-radius: self.height / 2;
                        background: SlateTheme.surface-2;
                        border-width: 1px;
                        border-color: SlateTheme.border-subtle;

                        HorizontalLayout {
                            padding-left: root.badge-padding;
                            padding-right: root.badge-padding;
                            alignment: center;

                            Text {
                                text: root.page-badge;
                                font-size: SlateTheme.font-xs;
                                font-weight: 500;
                                color: SlateTheme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Status indicator: dot inline-left of its label, both vertically centred
            HorizontalLayout {
                alignment: end;
                spacing: root.switch-gap;

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: root.status-dot;
                        height: root.status-dot;
                        border-radius: root.status-dot / 2;
                        background: SlateTheme.status-success;
                    }
                }

                Text {
                    text: root.status-text;
                    font-size: SlateTheme.font-xs;
                    color: SlateTheme.text-muted;
                    vertical-alignment: center;
                }
            }
        }

        // 3. Tab Bar & Main Scrollable Content Area
        Rectangle {
            background: SlateTheme.background;
            vertical-stretch: 1;
            clip: true;

            VerticalLayout {
                padding: SlateTheme.spacing-lg;
                spacing: SlateTheme.spacing-md;

                // Horizontal Shadcn/Radix Tabs List Container
                if root.show-tabs : Rectangle {
                    height: root.tab-strip-height;
                    vertical-stretch: 0;
                    border-radius: SlateTheme.radius-md;
                    background: SlateTheme.surface-1;
                    border-width: 1px;
                    border-color: SlateTheme.border-subtle;
                    accessible-role: tab-list;

                    HorizontalLayout {
                        padding: root.tab-strip-padding;
                        spacing: root.tab-strip-padding;
                        alignment: start;

                        for tab-name[idx] in root.tabs : Rectangle {
                            height: root.tab-height;
                            border-radius: SlateTheme.radius-sm;
                            background: root.active-tab == idx ? SlateTheme.surface-2
                                : tab-touch.has-hover ? SlateTheme.surface-hover : Colors.transparent;

                            tab-touch := TouchArea {
                                clicked => {
                                    root.active-tab = idx;
                                    root.tab-selected(idx);
                                }
                                accessible-role: tab;
                                accessible-label: tab-name;
                                accessible-item-selectable: true;
                                accessible-item-selected: root.active-tab == idx;
                                accessible-item-index: idx;
                                accessible-item-count: root.tabs.length;
                                accessible-action-default => {
                                    root.active-tab = idx;
                                    root.tab-selected(idx);
                                }
                            }

                            HorizontalLayout {
                                padding-left: root.tab-padding;
                                padding-right: root.tab-padding;
                                alignment: center;

                                Text {
                                    text: tab-name;
                                    font-size: SlateTheme.font-sm;
                                    font-weight: root.active-tab == idx ? 600 : 500;
                                    color: root.active-tab == idx ? SlateTheme.text-primary : SlateTheme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Main Content View Slot
                @children
            }
        }
    }

    // User dropdown: click-away scrim + menu, closed with Escape or any selection
    if root.user-menu-open : menu-scope := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.user-menu-open = false;
                return accept;
            }
            return reject;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.user-menu-open = false; }
        }

        Rectangle {
            width: root.menu-width;
            x: root.width - self.width - SlateTheme.spacing-xl;
            y: root.header-height - SlateTheme.spacing-xs;
            background: SlateTheme.surface-1;
            border-radius: SlateTheme.radius-md;
            border-width: 1px;
            border-color: SlateTheme.border-subtle;
            height: menu-column.preferred-height;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            drop-shadow-offset-y: 4px;
            accessible-role: list;
            accessible-label: "User menu";

            menu-column := VerticalLayout {
                padding: SlateTheme.spacing-xs;
                spacing: 2px;

                for label[idx] in root.user-menu-items : UserMenuItem {
                    text: label;
                    destructive: idx == root.user-menu-items.length - 1;
                    clicked => {
                        root.user-menu-open = false;
                        root.user-menu-selected(idx);
                        if (idx == 2) { root.toggle-design(); }
                    }
                }
            }
        }
    }
}
