import { SlateTheme } from "theme.slint";
import { SlateCloseIcon, SlateSearchIcon } from "icons.slint";

export component SlateSearchInput {
    in-out property <string> text: "";
    in property <string> placeholder: "Search...";
    // Phase 3 (D3) identity contract: see SlateButton.
    in property <string> automation-id: "";
    callback edited(string);
    callback accepted(string);

    height: 36px;
    min-width: 180px;

    rect := Rectangle {
        background: SlateTheme.surface-2;
        border-radius: SlateTheme.radius-sm;
        border-width: 1px;
        border-color: input.has-focus ? SlateTheme.accent-primary : SlateTheme.border-subtle;
        animate border-color { duration: 120ms; }

        HorizontalLayout {
            padding-left: SlateTheme.spacing-sm;
            padding-right: SlateTheme.spacing-sm;
            spacing: SlateTheme.spacing-sm;

            VerticalLayout {
                alignment: center;
                SlateSearchIcon { icon-color: SlateTheme.text-muted; }
            }

            input-area := Rectangle {
                horizontal-stretch: 1;
                height: 100%;

                if root.text == "" && !input.has-focus : Text {
                    width: 100%;
                    height: 100%;
                    text: root.placeholder;
                    font-size: SlateTheme.font-sm;
                    color: SlateTheme.text-muted;
                    vertical-alignment: center;
                }

                input := TextInput {
                    width: 100%;
                    height: 100%;
                    text <=> root.text;
                    accessible-role: text-input;
                    accessible-label: root.placeholder;
                    accessible-id: root.automation-id != "" ? root.automation-id : root.placeholder;
                    accessible-placeholder-text: root.placeholder;
                    font-size: SlateTheme.font-sm;
                    color: SlateTheme.text-primary;
                    vertical-alignment: center;
                    single-line: true;
                    edited => { root.edited(root.text); }
                    accepted => { root.accepted(root.text); }
                }
            }

            if root.text != "" : TouchArea {
                width: 20px;
                clicked => {
                    root.text = "";
                    root.edited("");
                }
                accessible-role: button;
                accessible-label: "Clear";
                // W2 collision fix: derived from this input's own resolved id
                // (automation-id > placeholder), never the bare "clear"
                // constant (see SlateInput).
                accessible-id: (root.automation-id != "" ? root.automation-id : root.placeholder) + "-clear";
                accessible-action-default => {
                    root.text = "";
                    root.edited("");
                }
                VerticalLayout {
                    alignment: center;
                    SlateCloseIcon { icon-color: SlateTheme.text-muted; }
                }
            }
        }
    }
}
