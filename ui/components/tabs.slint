import { SlateTheme } from "theme.slint";

export component SlateTabs {
    in property <[string]> tabs: ["Tab 1", "Tab 2", "Tab 3"];
    in-out property <int> current-tab: 0;
    // Phase 3 (D3) identity contract: see SlateButton. Tab items derive
    // "<automation-id>-tab-<idx>" so repeated tab bars stay unique.
    in property <string> automation-id: "";
    callback tab-selected(int, string);

    height: 42px;

    accessible-role: tab-list;
    accessible-id: root.automation-id != "" ? root.automation-id : "tabs";

    function select(idx: int) {
        if (idx >= 0 && idx < root.tabs.length && idx != root.current-tab) {
            root.current-tab = idx;
            root.tab-selected(idx, root.tabs[idx]);
        }
    }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) {
                root.select(root.current-tab - 1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.select(root.current-tab + 1);
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        // Bottom divider line
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: SlateTheme.border-subtle;
        }

        HorizontalLayout {
            spacing: SlateTheme.spacing-xs;
            alignment: start;

            for tab-title[idx] in root.tabs : tab-item := Rectangle {
                accessible-role: tab;
                accessible-label: tab-title;
                accessible-id: root.automation-id != "" ? root.automation-id + "-tab-" + idx : "tab-" + idx;
                accessible-action-default => { root.select(idx); }

                touch := TouchArea {
                    clicked => {
                        fs.focus();
                        root.current-tab = idx;
                        root.tab-selected(idx, tab-title);
                    }
                }

                HorizontalLayout {
                    padding-left: SlateTheme.spacing-md;
                    padding-right: SlateTheme.spacing-md;
                    alignment: center;

                    Text {
                        text: tab-title;
                        font-size: SlateTheme.font-sm;
                        font-weight: root.current-tab == idx ? 600 : 500;
                        color: root.current-tab == idx ? SlateTheme.text-primary
                            : touch.has-hover ? SlateTheme.text-primary
                            : SlateTheme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                if fs.has-focus && root.current-tab == idx : Rectangle {
                    border-radius: SlateTheme.radius-xs;
                    border-width: 2px;
                    border-color: SlateTheme.focus-ring;
                }

                // Active indicator line
                if root.current-tab == idx : Rectangle {
                    y: parent.height - 2px;
                    height: 2px;
                    background: SlateTheme.accent-primary;
                    border-radius: SlateTheme.radius-full;
                }
            }
        }
    }
}
