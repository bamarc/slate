import { SlateTheme } from "theme.slint";
import { SlateCheckIcon, SlateCloseIcon } from "icons.slint";

export enum SlateToastVariant { default, success, error, warning, info }

export struct SlateToastItem {
    id: int,
    title: string,
    description: string,
    variant: SlateToastVariant,
}

component SlateToastCard {
    in property <SlateToastItem> item;
    callback dismiss();

    property <color> tint: item.variant == SlateToastVariant.success ? SlateTheme.status-success
        : item.variant == SlateToastVariant.error ? SlateTheme.status-error
        : item.variant == SlateToastVariant.warning ? SlateTheme.status-warning
        : item.variant == SlateToastVariant.info ? SlateTheme.status-info
        : SlateTheme.text-muted;

    height: self.preferred-height;
    accessible-role: groupbox;
    accessible-label: root.item.title;
    accessible-description: root.item.description;

    Rectangle {
        background: SlateTheme.surface-1;
        border-radius: SlateTheme.radius-md;
        border-width: 1px;
        border-color: SlateTheme.border-strong;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000070;
        drop-shadow-offset-y: 4px;

        HorizontalLayout {
            padding: SlateTheme.spacing-md;
            spacing: SlateTheme.spacing-md;

            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: SlateTheme.radius-full;
                    background: root.tint;

                    if root.item.variant == SlateToastVariant.success : SlateCheckIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 11px;
                        height: 11px;
                        icon-color: SlateTheme.accent-text;
                    }
                    if root.item.variant == SlateToastVariant.error : SlateCloseIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 9px;
                        height: 9px;
                        icon-color: SlateTheme.accent-text;
                    }
                    if root.item.variant != SlateToastVariant.success && root.item.variant != SlateToastVariant.error : Text {
                        text: root.item.variant == SlateToastVariant.warning ? "!" : "i";
                        font-size: SlateTheme.font-xs;
                        font-weight: 700;
                        color: SlateTheme.accent-text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;

                Text {
                    text: root.item.title;
                    font-size: SlateTheme.font-sm;
                    font-weight: 600;
                    color: SlateTheme.text-primary;
                    horizontal-alignment: left;
                    wrap: word-wrap;
                }

                if root.item.description != "" : Text {
                    text: root.item.description;
                    font-size: SlateTheme.font-xs;
                    color: SlateTheme.text-secondary;
                    horizontal-alignment: left;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                alignment: start;
                TouchArea {
                    width: 24px;
                    height: 24px;
                    clicked => { root.dismiss(); }
                    accessible-role: button;
                    accessible-label: "Dismiss notification";
                    accessible-action-default => { root.dismiss(); }

                    Rectangle {
                        border-radius: SlateTheme.radius-xs;
                        background: parent.has-hover ? SlateTheme.surface-hover : Colors.transparent;
                        SlateCloseIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            icon-color: SlateTheme.text-muted;
                        }
                    }
                }
            }
        }
    }
}

// Sonner-style toast stack anchored bottom-right. Place it as the LAST child of the window,
// full size; it has hit areas only on the toasts, so content beneath stays clickable.
//
// Two ways to feed it:
//  * `host.show("Title", "Description", SlateToastVariant.success)` from any handler. Toasts
//    live in internal slots, auto-dismiss after `duration`, at most `max-visible` (3) at once
//    (the oldest is replaced when full).
//  * `toasts`: a model owned by the app (e.g. a Rust VecModel). Each entry auto-dismisses after
//    `duration` and fires `dismissed(id)`; the app must remove the entry in that handler.
export component SlateToastHost {
    in-out property <[SlateToastItem]> toasts;
    in property <duration> duration: 4s;
    callback dismissed(int);

    property <int> max-visible: 3;
    property <[SlateToastItem]> slots: [{id: 0}, {id: 0}, {id: 0}];
    property <[int]> ages: [0, 0, 0];
    property <int> next-id: 1;
    property <int> next-slot: 0;
    property <int> active-slots: (slots[0].id != 0 ? 1 : 0) + (slots[1].id != 0 ? 1 : 0) + (slots[2].id != 0 ? 1 : 0);

    public function show(title: string, description: string, variant: SlateToastVariant) {
        let item = { id: root.next-id, title: title, description: description, variant: variant };
        root.next-id += 1;
        if (root.slots[0].id == 0) {
            root.slots[0] = item; root.ages[0] = 0;
        } else if (root.slots[1].id == 0) {
            root.slots[1] = item; root.ages[1] = 0;
        } else if (root.slots[2].id == 0) {
            root.slots[2] = item; root.ages[2] = 0;
        } else if (root.next-slot == 0) {
            root.slots[0] = item; root.ages[0] = 0; root.next-slot = 1;
        } else if (root.next-slot == 1) {
            root.slots[1] = item; root.ages[1] = 0; root.next-slot = 2;
        } else {
            root.slots[2] = item; root.ages[2] = 0; root.next-slot = 0;
        }
    }

    function close-slot(i: int) {
        root.slots[i] = { id: 0 };
        root.ages[i] = 0;
    }

    function tick(i: int) {
        if (root.slots[i].id != 0) {
            root.ages[i] += 200;
            if (root.ages[i] >= root.duration / 1ms) { root.close-slot(i); }
        }
    }

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;

    // Ages the slot toasts (model toasts own their timers below).
    Timer {
        interval: 200ms;
        running: root.active-slots > 0;
        triggered => {
            root.tick(0);
            root.tick(1);
            root.tick(2);
        }
    }

    stack := VerticalLayout {
        width: Math.min(root.width - 32px, 356px);
        x: root.width - self.width - 16px;
        y: root.height - self.height - 16px;
        height: self.preferred-height;
        spacing: SlateTheme.spacing-sm;
        alignment: end;

        for item[i] in root.toasts : Rectangle {
            visible: i < root.max-visible - root.active-slots;
            height: self.visible ? card.preferred-height : 0px;
            card := SlateToastCard {
                width: parent.width;
                item: item;
                dismiss => { root.dismissed(item.id); }
            }
            Timer {
                interval: root.duration;
                running: parent.visible;
                triggered => { root.dismissed(item.id); }
            }
        }

        for item[i] in root.slots : Rectangle {
            visible: item.id != 0;
            height: self.visible ? slot-card.preferred-height : 0px;
            slot-card := SlateToastCard {
                width: parent.width;
                item: item;
                dismiss => { root.close-slot(i); }
            }
        }
    }
}
