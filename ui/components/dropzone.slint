// Dropzone Component — File upload dropzone with drag-over styling, browse button,
// MCP drop-target action, and per-file upload progress queue.

import { SlateTheme } from "theme.slint";
import { SlateUploadIcon, SlateFileIcon } from "icons.slint";
import { SlateMcpDropTarget } from "mcp.slint";

export struct SlateUploadItem {
    id: string,
    name: string,
    path: string,
    size-label: string,
    progress: float, // 0.0 .. 1.0
    status: string,  // "queued" | "uploading" | "completed" | "rejected"
    error-message: string,
}

export component SlateDropzone inherits Rectangle {
    in property <string> automation-id: "dropzone";
    in property <string> title: "Drop files here or click to browse";
    in property <string> hint: "Supports PNG, PDF, CSV, JSON up to 25 MB";
    in-out property <bool> drag-over: false;
    in-out property <string> dropped-payload: "";
    in property <[SlateUploadItem]> items: [];
    in property <bool> enabled: true;

    callback files-dropped(string /* newline-or-comma-separated-paths */);
    callback browse-requested();
    callback remove-item-requested(int /* index */);
    callback clear-completed-requested();

    accessible-role: region;
    accessible-id: root.automation-id;
    accessible-label: "Upload Dropzone";
    accessible-description: "mcp:controllable,drop-receiver";

    background: Colors.transparent;

    VerticalLayout {
        spacing: SlateTheme.spacing-sm;

        // Drop target zone
        SlateMcpDropTarget {
            height: 132px;
            automation-id: root.automation-id + "-drop-target";
            label: root.title;
            enabled: root.enabled;
            border-radius: SlateTheme.radius-md;
            border-width: root.drag-over ? 2px : 1px;
            border-color: root.drag-over ? SlateTheme.accent-primary : SlateTheme.border-strong;
            background: root.drag-over ? SlateTheme.accent-primary-subtle : SlateTheme.surface-1;

            payload-dropped(payload) => {
                root.dropped-payload = payload;
                root.drag-over = false;
                root.files-dropped(payload);
            }

            VerticalLayout {
                alignment: center;
                spacing: SlateTheme.spacing-xs;
                padding: SlateTheme.spacing-md;

                Rectangle {
                    width: 36px;
                    height: 36px;
                    x: (parent.width - self.width) / 2;
                    border-radius: 18px;
                    background: SlateTheme.surface-2;

                    SlateUploadIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon-color: SlateTheme.accent-primary;
                    }
                }

                Text {
                    text: root.title;
                    color: SlateTheme.text-primary;
                    font-size: SlateTheme.font-sm;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.hint;
                    color: SlateTheme.text-secondary;
                    font-size: SlateTheme.font-xs;
                    horizontal-alignment: center;
                }

                // Browse button
                Rectangle {
                    width: 110px;
                    height: 28px;
                    x: (parent.width - self.width) / 2;
                    border-radius: SlateTheme.radius-xs;
                    background: browse-touch.has-hover ? SlateTheme.accent-primary-hover : SlateTheme.accent-primary;
                    accessible-role: button;
                    accessible-id: root.automation-id + "-browse";
                    accessible-label: "Browse Files";
                    accessible-action-default => {
                        if (root.enabled) {
                            root.browse-requested();
                        }
                    }

                    Text {
                        text: "Browse Files";
                        color: #ffffff;
                        font-size: SlateTheme.font-xs;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    browse-touch := TouchArea {
                        enabled: root.enabled;
                        mouse-cursor: pointer;
                        clicked => { root.browse-requested(); }
                    }
                }
            }
        }

        // Upload queue list
        if root.items.length > 0 : VerticalLayout {
            spacing: 6px;

            for item[idx] in root.items : Rectangle {
                height: 44px;
                border-radius: SlateTheme.radius-sm;
                background: SlateTheme.surface-1;
                border-width: 1px;
                border-color: item.status == "rejected" ? SlateTheme.status-error : SlateTheme.border-subtle;
                accessible-role: list-item;
                accessible-id: root.automation-id + "-item-" + idx;
                accessible-label: item.name + " (" + item.status + ")";
                accessible-value: item.status == "rejected" ? item.error-message : item.status;

                HorizontalLayout {
                    padding-left: SlateTheme.spacing-sm;
                    padding-right: SlateTheme.spacing-sm;
                    spacing: SlateTheme.spacing-sm;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: SlateTheme.spacing-sm;
                        horizontal-stretch: 1;

                        SlateFileIcon {
                            y: (parent.height - self.height) / 2;
                            icon-color: item.status == "rejected" ? SlateTheme.status-error
                                      : item.status == "completed" ? SlateTheme.status-success
                                      : SlateTheme.accent-primary;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: item.name;
                                    color: SlateTheme.text-primary;
                                    font-size: SlateTheme.font-xs;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: item.status == "rejected" ? item.error-message : item.size-label;
                                    color: item.status == "rejected" ? SlateTheme.status-error : SlateTheme.text-secondary;
                                    font-size: SlateTheme.font-xs;
                                }
                            }

                            // Progress bar
                            Rectangle {
                                height: 4px;
                                width: 100%;
                                border-radius: 2px;
                                background: SlateTheme.surface-3;

                                Rectangle {
                                    width: parent.width * Math.min(1.0, Math.max(0.0, item.progress));
                                    height: 100%;
                                    border-radius: 2px;
                                    background: item.status == "rejected" ? SlateTheme.status-error
                                              : item.status == "completed" ? SlateTheme.status-success
                                              : SlateTheme.accent-primary;
                                }
                            }
                        }
                    }

                    // Remove button
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        y: (parent.height - self.height) / 2;
                        border-radius: SlateTheme.radius-xs;
                        background: rm-touch.has-hover ? SlateTheme.surface-2 : transparent;
                        accessible-role: button;
                        accessible-id: root.automation-id + "-remove-" + idx;
                        accessible-label: "Remove " + item.name;
                        accessible-action-default => { root.remove-item-requested(idx); }

                        Text {
                            text: "×";
                            color: SlateTheme.text-secondary;
                            font-size: SlateTheme.font-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        rm-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.remove-item-requested(idx); }
                        }
                    }
                }
            }
        }
    }
}
