import { SlateTheme } from "theme.slint";

export component SlateSwitch {
    in-out property <bool> checked: false;
    in property <string> text: "";
    in property <string> description: "";
    in property <bool> enabled: true;
    // Phase 3 (D3) identity contract: see SlateButton.
    in property <string> automation-id: "";
    callback toggled(bool);

    horizontal-stretch: 0;

    accessible-role: switch;
    accessible-label: root.text;
    accessible-id: root.automation-id != "" ? root.automation-id : root.text;
    accessible-description: root.description;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.toggle(); }

    function toggle() {
        if (!root.enabled) { return; }
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.toggle();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            root.toggle();
        }
    }

    HorizontalLayout {
        spacing: SlateTheme.spacing-sm;
        alignment: center;

        // Switch pill track
        track := Rectangle {
            width: 38px;
            height: 20px;
            border-radius: SlateTheme.radius-full;
            background: !root.enabled ? SlateTheme.surface-2
                : root.checked ? SlateTheme.accent-primary
                : SlateTheme.surface-3;
            border-width: 1px;
            border-color: root.checked ? SlateTheme.accent-primary-active : SlateTheme.border-subtle;
            animate background { duration: 150ms; easing: ease-out; }
            animate border-color { duration: 150ms; }

            if fs.has-focus : Rectangle {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                border-radius: SlateTheme.radius-full;
                border-width: 2px;
                border-color: SlateTheme.focus-ring;
            }

            // Sliding thumb
            thumb := Rectangle {
                x: root.checked ? (parent.width - self.width - 2px) : 2px;
                y: 2px;
                width: 16px;
                height: 16px;
                border-radius: SlateTheme.radius-full;
                background: !root.enabled ? SlateTheme.text-muted : SlateTheme.thumb;
                animate x { duration: 140ms; easing: ease-out; }
            }
        }

        if root.text != "" || root.description != "" : VerticalLayout {
            spacing: 2px;
            alignment: center;

            if root.text != "" : Text {
                text: root.text;
                font-size: SlateTheme.font-sm;
                font-weight: 500;
                color: !root.enabled ? SlateTheme.text-muted
                    : (touch.has-hover ? SlateTheme.text-primary : SlateTheme.text-secondary);
                vertical-alignment: center;
            }

            if root.description != "" : Text {
                text: root.description;
                font-size: SlateTheme.font-xs;
                color: SlateTheme.text-muted;
            }
        }
    }
}
