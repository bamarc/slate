import { SlateTheme } from "theme.slint";
import { SlateChevronIcon } from "icons.slint";

export component SlateAccordion {
    in property <string> title: "Accordion Item";
    in-out property <bool> expanded: false;
    callback toggled(bool);

    function toggle() {
        root.expanded = !root.expanded;
        root.toggled(root.expanded);
    }

    Rectangle {
        background: SlateTheme.surface-1;
        border-radius: SlateTheme.radius-sm;
        border-width: 1px;
        border-color: SlateTheme.border-subtle;

        VerticalLayout {
            header := Rectangle {
                height: 44px;

                accessible-role: button;
                accessible-label: root.title;
                accessible-expandable: true;
                accessible-expanded: root.expanded;
                accessible-action-default => { root.toggle(); }

                fs := FocusScope {
                    key-pressed(event) => {
                        if (event.text == " " || event.text == Key.Return) {
                            root.toggle();
                            return accept;
                        }
                        return reject;
                    }
                }

                touch := TouchArea {
                    clicked => {
                        fs.focus();
                        root.toggle();
                    }
                }

                HorizontalLayout {
                    padding-left: SlateTheme.spacing-md;
                    padding-right: SlateTheme.spacing-md;

                    Text {
                        text: root.title;
                        font-size: SlateTheme.font-sm;
                        font-weight: 600;
                        color: touch.has-hover ? SlateTheme.text-primary : SlateTheme.text-secondary;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        SlateChevronIcon {
                            expanded: root.expanded;
                            icon-color: SlateTheme.text-muted;
                        }
                    }
                }

                if fs.has-focus : Rectangle {
                    border-radius: SlateTheme.radius-sm;
                    border-width: 2px;
                    border-color: SlateTheme.focus-ring;
                }
            }

            // @children cannot live inside `if`, so collapse by constraining the height to 0
            // (and hiding, which also disables input for the collapsed content).
            content-container := Rectangle {
                clip: true;
                visible: root.expanded;
                vertical-stretch: 0;
                min-height: 0px;
                preferred-height: root.expanded ? content-layout.preferred-height : 0px;
                max-height: root.expanded ? content-layout.preferred-height : 0px;

                content-layout := VerticalLayout {
                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: SlateTheme.border-subtle;
                    }

                    VerticalLayout {
                        padding: SlateTheme.spacing-md;
                        @children
                    }
                }
            }
        }
    }
}
