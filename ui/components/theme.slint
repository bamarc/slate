// Slate Design System Theme Tokens
// Inspired by Kirigami and Libadwaita aesthetics

export global SlateTheme {
    in-out property <bool> is-dark: true;

    // Background & Surfaces
    out property <color> background: is-dark ? #0f1117 : #f8fafc;
    out property <color> surface-1: is-dark ? #181b24 : #ffffff;
    out property <color> surface-2: is-dark ? #222634 : #f1f5f9;
    out property <color> surface-3: is-dark ? #2d3345 : #e2e8f0;
    out property <color> surface-hover: is-dark ? #2a3042 : #f1f5f9;
    out property <color> surface-active: is-dark ? #353c52 : #e2e8f0;

    // Borders & Dividers
    out property <color> border-subtle: is-dark ? #262c3d : #e2e8f0;
    out property <color> border-strong: is-dark ? #3b445c : #cbd5e1;

    // Typography Colors
    out property <color> text-primary: is-dark ? #f8fafc : #0f172a;
    out property <color> text-secondary: is-dark ? #94a3b8 : #475569;
    out property <color> text-muted: is-dark ? #64748b : #94a3b8;

    // Brand & Accent Colors
    out property <color> accent-primary: #3b82f6;        // Slate Blue
    out property <color> accent-primary-hover: #60a5fa;
    out property <color> accent-primary-active: #2563eb;
    out property <color> accent-primary-subtle: is-dark ? #1e293b : #eff6ff;
    out property <color> accent-secondary: #8b5cf6;      // Modern Purple
    out property <color> accent-text: #ffffff;
    out property <color> overlay-backdrop: is-dark ? #000000b0 : #00000060;

    // Semantic Status Colors
    out property <color> status-success: #10b981;
    out property <color> status-success-bg: is-dark ? #064e3b : #d1fae5;
    out property <color> status-warning: #f59e0b;
    out property <color> status-warning-bg: is-dark ? #78350f : #fef3c7;
    out property <color> status-error: #ef4444;
    out property <color> status-error-bg: is-dark ? #7f1d1d : #fee2e2;
    out property <color> status-info: #0284c7;
    out property <color> status-info-bg: is-dark ? #0c4a6e : #e0f2fe;

    // Metrics & Radii
    out property <length> radius-xs: 4px;
    out property <length> radius-sm: 8px;
    out property <length> radius-md: 12px;
    out property <length> radius-lg: 16px;
    out property <length> radius-full: 9999px;

    // Font Sizes
    out property <length> font-xs: 11px;
    out property <length> font-sm: 13px;
    out property <length> font-md: 15px;
    out property <length> font-lg: 18px;
    out property <length> font-xl: 22px;
    out property <length> font-2xl: 28px;

    // Spacing
    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 16px;
    out property <length> spacing-lg: 24px;
    out property <length> spacing-xl: 32px;
}
