import { SlateTheme } from "theme.slint";

export component SlateRadio {
    in-out property <bool> selected: false;
    in property <string> text: "";
    in property <bool> enabled: true;
    // Phase 3 (D3) identity contract: see SlateButton.
    in property <string> automation-id: "";
    callback toggled(bool);

    horizontal-stretch: 0;

    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-id: root.automation-id != "" ? root.automation-id : root.text;
    accessible-checked: root.selected;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.select(); }

    function select() {
        if (root.enabled && !root.selected) {
            root.selected = true;
            root.toggled(true);
        }
    }

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.select();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            root.select();
        }
    }

    HorizontalLayout {
        spacing: SlateTheme.spacing-sm;
        alignment: center;

        circle := Rectangle {
            width: 18px;
            height: 18px;
            border-radius: SlateTheme.radius-full;
            background: touch.has-hover ? SlateTheme.surface-hover : SlateTheme.surface-2;
            border-width: root.selected ? 2px : 1px;
            border-color: root.selected ? SlateTheme.accent-primary
                : (touch.has-hover ? SlateTheme.border-strong : SlateTheme.border-subtle);
            animate border-color { duration: 100ms; }

            if fs.has-focus : Rectangle {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                border-radius: SlateTheme.radius-full;
                border-width: 2px;
                border-color: SlateTheme.focus-ring.transparentize(40%);
            }

            if root.selected : Rectangle {
                width: 8px;
                height: 8px;
                border-radius: SlateTheme.radius-full;
                background: SlateTheme.accent-primary;
            }
        }

        if root.text != "" : Text {
            text: root.text;
            font-size: SlateTheme.font-sm;
            color: !root.enabled ? SlateTheme.text-muted
                : (touch.has-hover ? SlateTheme.text-primary : SlateTheme.text-secondary);
            vertical-alignment: center;
        }
    }
}
