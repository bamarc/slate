import { SlateTheme } from "theme.slint";
import { SlateCheckIcon, SlateMinusIcon } from "icons.slint";

export component SlateCheckbox {
    in-out property <bool> checked: false;
    in-out property <bool> indeterminate: false;
    in property <string> text: "";
    in property <bool> enabled: true;
    callback toggled(bool);

    horizontal-stretch: 0;

    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.toggle(); }

    function toggle() {
        if (!root.enabled) { return; }
        if root.indeterminate {
            root.indeterminate = false;
            root.checked = true;
        } else {
            root.checked = !root.checked;
        }
        root.toggled(root.checked);
    }

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.toggle();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            root.toggle();
        }
    }

    HorizontalLayout {
        spacing: SlateTheme.spacing-sm;
        alignment: center;

        box := Rectangle {
            width: 18px;
            height: 18px;
            border-radius: SlateTheme.radius-xs;
            background: !root.enabled ? SlateTheme.surface-2
                : (root.checked || root.indeterminate) ? (touch.has-hover ? SlateTheme.accent-primary-hover : SlateTheme.accent-primary)
                : (touch.has-hover ? SlateTheme.surface-hover : SlateTheme.surface-2);
            border-width: 1px;
            border-color: (root.checked || root.indeterminate) ? Colors.transparent
                : (touch.has-hover ? SlateTheme.border-strong : SlateTheme.border-subtle);
            animate background { duration: 100ms; }

            if root.checked && !root.indeterminate : SlateCheckIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 12px;
                height: 12px;
                icon-color: SlateTheme.accent-text;
            }

            if root.indeterminate : SlateMinusIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 12px;
                height: 12px;
                icon-color: SlateTheme.accent-text;
            }

            if fs.has-focus : Rectangle {
                border-radius: SlateTheme.radius-xs;
                border-width: 2px;
                border-color: SlateTheme.focus-ring;
            }
        }

        if root.text != "" : Text {
            text: root.text;
            font-size: SlateTheme.font-sm;
            color: !root.enabled ? SlateTheme.text-muted
                : (touch.has-hover ? SlateTheme.text-primary : SlateTheme.text-secondary);
            vertical-alignment: center;
        }
    }
}
