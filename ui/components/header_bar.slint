import { SlateTheme } from "theme.slint";

export component SlateHeaderBar {
    in property <string> title: "Slate Application";
    in property <string> subtitle: "";

    height: 48px;

    Rectangle {
        background: SlateTheme.surface-1;

        HorizontalLayout {
            padding-left: SlateTheme.spacing-md;
            padding-right: SlateTheme.spacing-md;
            alignment: center;
            spacing: SlateTheme.spacing-md;

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                Text {
                    text: root.title;
                    font-size: SlateTheme.font-md;
                    font-weight: 600;
                    color: SlateTheme.text-primary;
                }

                if root.subtitle != "" : Text {
                    text: root.subtitle;
                    font-size: SlateTheme.font-xs;
                    color: SlateTheme.text-muted;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            @children
        }

        // Bottom divider border
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: SlateTheme.border-subtle;
        }
    }
}
