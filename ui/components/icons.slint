// Chevron pointing right, or down when expanded.
export component SlateChevronIcon inherits Path {
    in property <color> icon-color: #94a3b8;
    in property <bool> expanded: false;
    in property <length> thickness: 1.5px;
    width: 10px;
    height: 10px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.expanded ? "M 5 8 L 12 16 L 19 8" : "M 8 5 L 16 12 L 8 19";
    stroke: root.icon-color;
    stroke-width: root.thickness;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// Spinning three-quarter arc (end points are recomputed from the animation tick,
// since Path has no rotation-angle).
export component SlateSpinner inherits Path {
    in property <color> icon-color: #94a3b8;
    in property <length> thickness: 2px;
    width: 14px;
    height: 14px;
    viewbox-width: 24;
    viewbox-height: 24;
    property <angle> turn: Math.mod(animation-tick() / 1s, 1.0) * 360deg;
    property <float> start-x: 12 + 9 * Math.sin(turn);
    property <float> start-y: 12 - 9 * Math.cos(turn);
    property <float> end-x: 12 + 9 * Math.sin(turn + 270deg);
    property <float> end-y: 12 - 9 * Math.cos(turn + 270deg);
    commands: "M \{start-x} \{start-y} A 9 9 0 1 1 \{end-x} \{end-y}";
    stroke: root.icon-color;
    stroke-width: root.thickness;
    stroke-line-cap: round;
}

