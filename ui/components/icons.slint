// Drawn icons (no dependency on emoji / symbol fonts).
// All icons are 24x24 viewbox paths; size them via width/height.

export component SlateCheckIcon inherits Path {
    in property <color> icon-color: #ffffff;
    in property <length> thickness: 2px;
    width: 12px;
    height: 12px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: "M 4 12.5 L 9.5 18 L 20 6";
    stroke: root.icon-color;
    stroke-width: root.thickness;
    stroke-line-cap: round;
    stroke-line-join: round;
}

