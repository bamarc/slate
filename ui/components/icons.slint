export component SlateSortIcon inherits Path {
    in property <color> icon-color: #94a3b8;
    in property <string> direction: "none"; // "none", "asc", "desc"
    in property <length> thickness: 1.5px;
    width: 12px;
    height: 12px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.direction == "asc"
        ? "M 7 15 L 12 9 L 17 15"
        : (root.direction == "desc" ? "M 7 9 L 12 15 L 17 9" : "M 8 9 L 12 5 L 16 9 M 8 15 L 12 19 L 16 15");
    stroke: root.icon-color;
    stroke-width: root.thickness;
    stroke-line-cap: round;
    stroke-line-join: round;
}

