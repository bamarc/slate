/++
    SolidJS TypeScript JSX (.tsx) code generator for Slint AST.
+/
module slate.solid.codegen_tsx;

import slate.solid.ast;
import slate.solid.sema;
import std.algorithm.searching : canFind;
import std.array : Appender, appender, join;
import std.ascii : isAlpha, isAlphaNum, isDigit;
import std.conv : to;
import std.path : baseName, stripExtension;
import std.string : endsWith, indexOf, replace, split, startsWith, strip;
import std.uni : toLower, toUpper;

struct HoistedInteractive
{
    string id;
    bool isTouchArea;
    bool isFocusScope;
}

/// SolidJS TSX code generator.
class SolidTsxGenerator
{
    private SlintSema sema;
    private size_t indentLevel = 0;
    private string[] currentCompProps;

    @safe this(SlintSema sema = null)
    {
        this.sema = sema !is null ? sema : new SlintSema();
    }

    /// Generate complete .tsx source code for a SlintModule.
    @safe string generateModule(SlintModule mod)
    {
        sema.analyze(mod);
        auto buf = appender!string();

        buf.put("// Auto-generated by slate:solid cross-compiler. DO NOT EDIT DIRECTLY.\n");
        buf.put("import { createSignal, createMemo, createEffect, onCleanup, Show, For, Component, JSX, children as resolveChildren } from \"solid-js\";\n");
        buf.put("import { createInOutProp, transparentize, SlateTimer, slateStyle, animationTick, transparent, Colors } from \"./slate-runtime\";\n");

        // Module imports
        foreach (imp; mod.imports)
        {
            buf.put("import { ");
            foreach (i, sym; imp.symbols)
            {
                if (i > 0)
                    buf.put(", ");
                buf.put(sym);
            }
            buf.put(" } from \"./");
            buf.put(cleanImportPath(imp.fromPath));
            buf.put("\";\n");
        }
        buf.put("\n");

        // Re-exports
        foreach (exp; mod.exports)
        {
            buf.put("export { ");
            foreach (i, sym; exp.symbols)
            {
                if (i > 0)
                    buf.put(", ");
                buf.put(sym);
            }
            buf.put(" }");
            if (exp.fromPath.length > 0)
            {
                buf.put(" from \"./");
                buf.put(cleanImportPath(exp.fromPath));
                buf.put("\"");
            }
            buf.put(";\n");
        }
        if (mod.exports.length > 0)
            buf.put("\n");

        // Enums
        foreach (slintEnum; mod.enums)
        {
            generateEnum(buf, slintEnum);
        }

        // Structs
        foreach (slintStruct; mod.structs)
        {
            generateStruct(buf, slintStruct);
        }

        // Globals
        foreach (slintGlobal; mod.globals)
        {
            generateGlobal(buf, slintGlobal);
        }

        // Components
        foreach (comp; mod.components)
        {
            generateComponent(buf, comp);
        }

        return buf.data;
    }

    // ── Enums ────────────────────────────────────────────────

    private @safe void generateEnum(ref Appender!string buf, SlintEnum e)
    {
        if (e.isExported)
            buf.put("export ");
        buf.put("enum ");
        buf.put(e.name);
        buf.put(" {\n");
        foreach (v; e.variants)
        {
            buf.put("    ");
            buf.put(toCamelCase(v));
            buf.put(" = \"");
            buf.put(v);
            buf.put("\",\n");
        }
        buf.put("}\n\n");
    }

    // ── Structs ──────────────────────────────────────────────

    private @safe void generateStruct(ref Appender!string buf, SlintStruct s)
    {
        if (s.isExported)
            buf.put("export ");
        buf.put("interface ");
        buf.put(s.name);
        buf.put(" {\n");
        foreach (f; s.fields)
        {
            buf.put("    ");
            buf.put(toCamelCase(f.name));
            buf.put("?: ");
            buf.put(toTsType(f.typeName));
            buf.put(";\n");
        }
        buf.put("}\n");
        if (s.isExported)
            buf.put("export ");
        buf.put("const ");
        buf.put(s.name);
        buf.put(" = {};\n\n");
    }

    // ── Globals ──────────────────────────────────────────────

    private @safe void generateGlobal(ref Appender!string buf, SlintGlobal g)
    {
        string[] globalProps;
        foreach (p; g.properties)
        {
            globalProps ~= p.name;
        }

        // Emit private signals for in-out properties
        foreach (p; g.properties)
        {
            if (p.direction == PropertyDirection.InOut)
            {
                string pName = toCamelCase(p.name);
                string capitalized = capitalizeFirst(pName);
                buf.put("const [_");
                buf.put(pName);
                buf.put(", _set");
                buf.put(capitalized);
                buf.put("] = createSignal<");
                buf.put(toTsType(p.typeName));
                buf.put(">(");
                buf.put(p.defaultValue.length > 0 ? translateExpr(p.defaultValue,
                        g.name, true, globalProps) : "null as any");
                buf.put(");\n");
            }
        }

        if (g.isExported)
            buf.put("export ");
        buf.put("const ");
        buf.put(g.name);
        buf.put(" = {\n");

        foreach (p; g.properties)
        {
            string pName = toCamelCase(p.name);
            string capitalized = capitalizeFirst(pName);

            if (p.direction == PropertyDirection.InOut)
            {
                buf.put("    get ");
                buf.put(pName);
                buf.put("(): ");
                buf.put(toTsType(p.typeName));
                buf.put(" { return _");
                buf.put(pName);
                buf.put("(); },\n");

                buf.put("    set");
                buf.put(capitalized);
                buf.put("(val: ");
                buf.put(toTsType(p.typeName));
                buf.put("): void { _set");
                buf.put(capitalized);
                buf.put("(val); },\n");
            }
            else
            {
                buf.put("    get ");
                buf.put(pName);
                buf.put("(): ");
                buf.put(toTsType(p.typeName));
                buf.put(" {\n        return ");
                buf.put(translateExpr(p.defaultValue, g.name, true, globalProps));
                buf.put(";\n    },\n");
            }
        }

        foreach (cb; g.callbacks)
        {
            string cbName = toCamelCase(cb.name);
            buf.put("    ");
            buf.put(cbName);
            buf.put(": (");
            foreach (i, pt; cb.paramTypes)
            {
                if (i > 0)
                    buf.put(", ");
                buf.put("arg");
                buf.put(to!string(i));
                buf.put(": ");
                buf.put(toTsType(pt));
            }
            buf.put("): ");
            buf.put(toTsType(cb.returnType));
            buf.put(" => { return null as any; },\n");
        }

        buf.put("};\n\n");
    }

    // ── Components ───────────────────────────────────────────

    private @safe void generateComponent(ref Appender!string buf, SlintComponent comp)
    {
        currentCompProps = [];
        foreach (p; comp.properties)
            currentCompProps ~= toCamelCase(p.name);
        if (comp.rootElement !is null)
        {
            foreach (p; comp.rootElement.properties)
                currentCompProps ~= toCamelCase(p.name);
        }

        string propsType = comp.name ~ "Props";

        // Props interface
        buf.put("export interface ");
        buf.put(propsType);
        buf.put(" {\n");
        if (comp.rootElement !is null && comp.rootElement.primitiveName == "Text")
        {
            bool hasTextProp = false;
            foreach (p; comp.properties)
            {
                if (p.name == "text")
                {
                    hasTextProp = true;
                    break;
                }
            }
            if (!hasTextProp)
            {
                buf.put("    text?: string;\n");
            }
        }
        foreach (p; comp.properties)
        {
            if (p.direction != PropertyDirection.In && p.direction != PropertyDirection.InOut)
                continue;
            buf.put("    ");
            buf.put(toCamelCase(p.name));
            buf.put("?: ");
            buf.put(toTsType(p.typeName));
            buf.put(";\n");

            if (p.direction == PropertyDirection.InOut)
            {
                buf.put("    onChange");
                buf.put(capitalizeFirst(toCamelCase(p.name)));
                buf.put("?: (val: ");
                buf.put(toTsType(p.typeName));
                buf.put(") => void;\n");
            }
        }
        foreach (cb; comp.callbacks)
        {
            string cbCamel = toCamelCase(cb.name);
            string onCbName = cbCamel.startsWith("on") ? cbCamel : ("on" ~ capitalizeFirst(cbCamel));
            string bareCbName = cbCamel.startsWith("on") && cbCamel.length > 2
                ? (cbCamel[2 .. 3].toLower() ~ cbCamel[3 .. $]) : cbCamel;

            buf.put("    ");
            buf.put(bareCbName);
            buf.put("?: (");
            foreach (i, pt; cb.paramTypes)
            {
                if (i > 0)
                    buf.put(", ");
                buf.put("arg");
                buf.put(to!string(i));
                buf.put(": ");
                buf.put(toTsType(pt));
            }
            buf.put(") => ");
            buf.put(toTsType(cb.returnType));
            buf.put(";\n");

            if (onCbName != bareCbName)
            {
                buf.put("    ");
                buf.put(onCbName);
                buf.put("?: (");
                foreach (i, pt; cb.paramTypes)
                {
                    if (i > 0)
                        buf.put(", ");
                    buf.put("arg");
                    buf.put(to!string(i));
                    buf.put(": ");
                    buf.put(toTsType(pt));
                }
                buf.put(") => ");
                buf.put(toTsType(cb.returnType));
                buf.put(";\n");
            }
        }
        buf.put("    children?: JSX.Element;\n");
        buf.put("    class?: string;\n");
        buf.put("    style?: JSX.CSSProperties;\n");
        buf.put("}\n\n");

        // Component declaration
        if (comp.isExported)
            buf.put("export ");
        buf.put("const ");
        buf.put(comp.name);
        buf.put(": Component<");
        buf.put(propsType);
        buf.put("> = (props) => {\n");

        // Collect and synthesize all TouchArea and FocusScope signals recursively
        auto interactives = collectHoistedInteractives(comp.rootElement);
        bool[string] seenIds;
        foreach (item; interactives)
        {
            if (item.id in seenIds)
                continue;
            seenIds[item.id] = true;
            if (item.isTouchArea)
            {
                buf.put("    const [");
                buf.put(item.id);
                buf.put("_hasHover, set");
                buf.put(capitalizeFirst(item.id));
                buf.put("_hasHover] = createSignal(false);\n");

                buf.put("    const [");
                buf.put(item.id);
                buf.put("_pressed, set");
                buf.put(capitalizeFirst(item.id));
                buf.put("_pressed] = createSignal(false);\n");
            }
            if (item.isFocusScope)
            {
                buf.put("    const [");
                buf.put(item.id);
                buf.put("_hasFocus, set");
                buf.put(capitalizeFirst(item.id));
                buf.put("_hasFocus] = createSignal(false);\n");
            }
        }

        // Built-in root width and height getters if not explicitly declared
        bool hasWidthProp = false;
        bool hasHeightProp = false;
        foreach (p; comp.properties)
        {
            if (p.name == "width")
                hasWidthProp = true;
            if (p.name == "height")
                hasHeightProp = true;
        }
        if (!hasWidthProp)
        {
            if (comp.name == "SlateTable" || comp.name == "Table")
            {
                buf.put(
                        "    const width = () => typeof props.style?.width === 'number' ? props.style.width : 760;\n");
            }
            else
            {
                buf.put(
                        "    const width = () => typeof props.style?.width === 'number' ? props.style.width : 1100;\n");
            }
        }
        if (!hasHeightProp)
        {
            buf.put(
                    "    const height = () => typeof props.style?.height === 'number' ? props.style.height : 840;\n");
        }

        // Two-way properties (in-out)
        foreach (p; comp.properties)
        {
            string pName = toCamelCase(p.name);
            string capName = capitalizeFirst(pName);
            if (p.direction == PropertyDirection.InOut)
            {
                string defVal = p.defaultValue.length > 0
                    ? translateExpr(p.defaultValue, comp.name) : "null as any";
                buf.put("    const [");
                buf.put(pName);
                buf.put(", setLocal");
                buf.put(capName);
                buf.put("] = createInOutProp(() => props.");
                buf.put(pName);
                buf.put(", (v) => props.onChange");
                buf.put(capName);
                buf.put("?.(v), ");
                buf.put(defVal);
                buf.put(");\n");
            }
            else if (p.direction == PropertyDirection.In)
            {
                string defVal = p.defaultValue.length > 0
                    ? translateExpr(p.defaultValue, comp.name) : "undefined";
                buf.put("    const ");
                buf.put(pName);
                buf.put(" = () => props.");
                buf.put(pName);
                buf.put(" !== undefined ? props.");
                buf.put(pName);
                buf.put(" : ");
                buf.put(defVal);
                buf.put(";\n");
            }
            else if (p.direction == PropertyDirection.None || p.direction == PropertyDirection.Out)
            {
                string defVal = p.defaultValue.length > 0
                    ? translateExpr(p.defaultValue, comp.name) : "undefined";
                buf.put("    const ");
                buf.put(pName);
                buf.put(" = createMemo(() => ");
                buf.put(defVal);
                buf.put(");\n");
            }
        }

        // Private properties / memos inside component root
        if (comp.rootElement !is null)
        {
            foreach (p; comp.rootElement.properties)
            {
                string pName = toCamelCase(p.name);
                buf.put("    const ");
                buf.put(pName);
                buf.put(" = createMemo(() => ");
                buf.put(translateExpr(p.defaultValue, comp.name));
                buf.put(");\n");
            }

            // Inline functions
            foreach (fn; comp.functions)
            {
                buf.put("    function ");
                buf.put(toCamelCase(fn.name));
                buf.put("(");
                foreach (i, param; fn.params)
                {
                    if (i > 0)
                        buf.put(", ");
                    buf.put(toCamelCase(param[0]));
                    buf.put(": ");
                    buf.put(toTsType(param[1]));
                }
                buf.put("): ");
                buf.put(toTsType(fn.returnType));
                buf.put(" ");
                buf.put(translateCallbackBody(fn.bodyCode, comp));
                buf.put("\n");
            }
        }

        // Callback helper wrappers
        foreach (cb; comp.callbacks)
        {
            string cbCamel = toCamelCase(cb.name);
            string onCbName = cbCamel.startsWith("on") ? cbCamel : ("on" ~ capitalizeFirst(cbCamel));
            string bareCbName = cbCamel.startsWith("on") && cbCamel.length > 2
                ? (cbCamel[2 .. 3].toLower() ~ cbCamel[3 .. $]) : cbCamel;
            buf.put("    const ");
            buf.put(bareCbName);
            buf.put(" = (...args: any[]) => (props.");
            buf.put(onCbName);
            buf.put(" ?? props.");
            buf.put(bareCbName);
            buf.put(")?.(...args);\n");
        }

        // Return JSX tree
        buf.put("    return (\n");
        generateElementJsx(buf, comp.rootElement, comp, 2);
        buf.put("    );\n");
        buf.put("};\n\n");
    }

    private @safe HoistedInteractive[] collectHoistedInteractives(SlintElement root)
    {
        HoistedInteractive[] list;
        void walk(SlintElement el)
        {
            if (el is null)
                return;
            if (el.primitiveName == "TouchArea")
            {
                string rawId = el.id.length > 0 ? el.id : "touch";
                list ~= HoistedInteractive(toCamelCase(rawId), true, false);
            }
            else if (el.primitiveName == "FocusScope" || el.primitiveName == "TextInput")
            {
                string rawId = el.id.length > 0 ? el.id
                    : (el.primitiveName == "TextInput" ? "input" : "fs");
                list ~= HoistedInteractive(toCamelCase(rawId), false, true);
            }
            foreach (child; el.children)
            {
                if (child.element !is null)
                {
                    walk(child.element);
                }
                else if (child.ifBlock !is null)
                {
                    walk(child.ifBlock.element);
                    foreach (c; child.ifBlock.children)
                        walk(c.element);
                    if (child.ifBlock.elseBranch !is null)
                        walk(child.ifBlock.elseBranch.element);
                }
                else if (child.forBlock !is null)
                {
                    walk(child.forBlock.element);
                    foreach (c; child.forBlock.children)
                        walk(c.element);
                }
            }
        }

        walk(root);
        return list;
    }

    // ── JSX Elements ─────────────────────────────────────────

    private @safe void generateElementJsx(ref Appender!string buf, SlintElement elem,
            SlintComponent comp, size_t indent, SlintElement parentElem = null)
    {
        if (elem is null)
            return;

        string spaces = makeIndent(indent);

        // Timer component lowering
        if (elem.primitiveName == "Timer")
        {
            buf.put(spaces);
            buf.put("<SlateTimer");
            foreach (b; elem.bindings)
            {
                if (b.name == "interval")
                {
                    buf.put(" interval={");
                    buf.put(translateExpr(b.expr, comp.name));
                    buf.put("}");
                }
                else if (b.name == "running")
                {
                    buf.put(" running={");
                    buf.put(translateExpr(b.expr, comp.name));
                    buf.put("}");
                }
            }
            foreach (h; elem.callbackHandlers)
            {
                if (h.name == "triggered")
                {
                    buf.put(" onTriggered={() => ");
                    buf.put(translateCallbackBody(h.handlerBody, comp));
                    buf.put("}");
                }
            }
            buf.put(" />\n");
            return;
        }

        string tag = mapPrimitiveToTag(elem.primitiveName);
        bool isBuiltIn = isBuiltInPrimitive(elem.primitiveName);

        buf.put(spaces);
        buf.put("<");
        buf.put(tag);

        // Class and MCP data attributes
        if (isBuiltIn)
        {
            buf.put(" class=\"slate-");
            buf.put(toLower(elem.primitiveName));
            buf.put("\"");
        }

        // Non-style props for custom components
        if (!isBuiltIn)
        {
            foreach (b; elem.bindings)
            {
                if (!isStyleProperty(b.name) && !b.name.startsWith("accessible-"))
                {
                    buf.put(" ");
                    buf.put(toCamelCase(b.name));
                    buf.put("={");
                    buf.put(translateExpr(b.expr, comp.name));
                    buf.put("}");
                }
            }
            foreach (h; elem.callbackHandlers)
            {
                buf.put(" on");
                buf.put(capitalizeFirst(toCamelCase(h.name)));
                buf.put("={(");
                foreach (i, p; h.params)
                {
                    if (i > 0)
                        buf.put(", ");
                    buf.put(toCamelCase(p));
                    buf.put(": any");
                }
                buf.put(") => ");
                buf.put(translateCallbackBody(h.handlerBody, comp));
                buf.put("}");
            }
        }

        // Accessibility and MCP bindings
        foreach (b; elem.bindings)
        {
            if (b.name == "accessible-role")
            {
                string r = b.expr.strip().replace("\"", "").replace("\\", "");
                buf.put(" role=\"" ~ r ~ "\"");
            }
            else if (b.name == "accessible-id")
            {
                buf.put(" data-mcp-id={");
                buf.put(translateExpr(b.expr, comp.name));
                buf.put("}");
            }
            else if (b.name == "accessible-label")
            {
                buf.put(" aria-label={");
                buf.put(translateExpr(b.expr, comp.name));
                buf.put("}");
            }
            else if (b.name == "accessible-description")
            {
                buf.put(" aria-description={");
                buf.put(translateExpr(b.expr, comp.name));
                buf.put("}");
            }
            else if (b.name == "accessible-enabled")
            {
                buf.put(" disabled={!(");
                buf.put(translateExpr(b.expr, comp.name));
                buf.put(")}");
            }
        }

        // Specific element props: TextInput and Image
        if (elem.primitiveName == "TextInput")
        {
            string inId = toCamelCase(elem.id.length > 0 ? elem.id : "input");
            string capInId = capitalizeFirst(inId);
            buf.put(" onFocus={() => set" ~ capInId ~ "_hasFocus(true)}");
            buf.put(" onBlur={() => set" ~ capInId ~ "_hasFocus(false)}");
            foreach (b; elem.bindings)
            {
                if (b.name == "text")
                {
                    buf.put(" value={");
                    buf.put(translateExpr(b.expr, comp.name));
                    buf.put("}");
                }
                else if (b.name == "placeholder-text" || b.name == "placeholder")
                {
                    buf.put(" placeholder={");
                    buf.put(translateExpr(b.expr, comp.name));
                    buf.put("}");
                }
                else if (b.name == "read-only")
                {
                    buf.put(" readOnly={");
                    buf.put(translateExpr(b.expr, comp.name));
                    buf.put("}");
                }
                else if (b.name == "input-type")
                {
                    buf.put(" type={");
                    buf.put(b.expr.canFind("password") ? "\"password\"" : "\"text\"");
                    buf.put("}");
                }
                else if (b.name == "enabled")
                {
                    buf.put(" disabled={!(");
                    buf.put(translateExpr(b.expr, comp.name));
                    buf.put(")}");
                }
            }
            foreach (h; elem.callbackHandlers)
            {
                if (h.name == "edited")
                {
                    buf.put(" onInput={(e: any) => ");
                    buf.put(translateCallbackBody(h.handlerBody, comp));
                    buf.put("}");
                }
            }
        }
        else if (elem.primitiveName == "Image")
        {
            foreach (b; elem.bindings)
            {
                if (b.name == "source")
                {
                    buf.put(" src={");
                    buf.put(translateExpr(b.expr, comp.name));
                    buf.put("}");
                }
            }
        }

        // Hoisted pointer/keyboard events from child TouchArea / FocusScope
        SlintElement touchChild = elem.primitiveName == "TouchArea" ? elem : null;
        SlintElement focusChild = elem.primitiveName == "FocusScope" ? elem : null;
        foreach (child; elem.children)
        {
            if (child.element !is null)
            {
                if (child.element.primitiveName == "TouchArea")
                    touchChild = child.element;
                else if (child.element.primitiveName == "FocusScope")
                    focusChild = child.element;
            }
        }

        if (touchChild !is null)
        {
            string tId = toCamelCase(touchChild.id.length > 0 ? touchChild.id : "touch");
            string capTId = capitalizeFirst(tId);
            buf.put(" onPointerEnter={() => set");
            buf.put(capTId);
            buf.put("_hasHover(true)}");

            buf.put(" onPointerLeave={() => { set");
            buf.put(capTId);
            buf.put("_hasHover(false); set");
            buf.put(capTId);
            buf.put("_pressed(false); }}");

            buf.put(" onPointerDown={() => set");
            buf.put(capTId);
            buf.put("_pressed(true)}");

            buf.put(" onPointerUp={() => set");
            buf.put(capTId);
            buf.put("_pressed(false)}");

            foreach (h; touchChild.callbackHandlers)
            {
                string onName = "onClick";
                if (h.name == "double-clicked")
                    onName = "onDblClick";
                else if (h.name != "clicked")
                    onName = "on" ~ capitalizeFirst(toCamelCase(h.name));

                buf.put(" " ~ onName ~ "={(");
                foreach (i, p; h.params)
                {
                    if (i > 0)
                        buf.put(", ");
                    buf.put(toCamelCase(p));
                    buf.put(": any");
                }
                buf.put(") => ");
                buf.put(translateCallbackBody(h.handlerBody, comp));
                buf.put("}");
            }
        }

        if (focusChild !is null)
        {
            string fsId = toCamelCase(focusChild.id.length > 0 ? focusChild.id : "fs");
            string capFsId = capitalizeFirst(fsId);
            buf.put(" onFocus={() => set");
            buf.put(capFsId);
            buf.put("_hasFocus(true)}");

            buf.put(" onBlur={() => set");
            buf.put(capFsId);
            buf.put("_hasFocus(false)}");
        }

        // Style bindings
        buf.put(" style={slateStyle({\n");
        bool hasXY = false;
        foreach (b; elem.bindings)
        {
            if ((b.name == "x" || b.name == "y") && b.expr.strip().length > 0)
                hasXY = true;
        }

        if (elem.primitiveName == "Window")
        {
            buf.put(spaces ~ "    position: \"relative\", overflow: \"hidden\", width: \"100%\", height: \"100%\", boxSizing: \"border-box\",\n");
        }
        else if (elem.primitiveName == "HorizontalLayout")
        {
            if (comp.name == "SlateButton" || comp.name == "SlateBadge")
            {
                buf.put(spaces ~ "    display: \"flex\", flexDirection: \"row\", alignItems: \"center\", justifyContent: \"center\", height: \"100%\", boxSizing: \"border-box\",\n");
            }
            else
            {
                buf.put(
                        spaces
                        ~ "    display: \"flex\", flexDirection: \"row\", boxSizing: \"border-box\",\n");
            }
        }
        else if (elem.primitiveName == "VerticalLayout")
        {
            buf.put(
                    spaces
                    ~ "    display: \"flex\", flexDirection: \"column\", boxSizing: \"border-box\",\n");
        }
        else if (elem.primitiveName == "Flickable")
        {
            buf.put(spaces ~ "    position: \"relative\", overflow: \"auto\", display: \"flex\", flexDirection: \"column\", boxSizing: \"border-box\", width: \"100%\", height: \"100%\", flexGrow: 1, flexShrink: 1, flexBasis: \"0%\",\n");
        }
        else if (elem.primitiveName == "Rectangle")
        {
            buf.put(spaces ~ "    boxSizing: \"border-box\", position: \"" ~ (hasXY
                    ? "absolute" : "relative") ~ "\",\n");
        }
        else if (elem.primitiveName == "Text")
        {
            bool hasWordWrap = false;
            foreach (b; elem.bindings)
            {
                if (b.name == "wrap" && (b.expr.canFind("word-wrap") || b.expr.canFind("wordWrap")))
                    hasWordWrap = true;
            }
            if (hasWordWrap)
                buf.put(
                        spaces
                        ~ "    display: \"inline-flex\", alignItems: \"center\", boxSizing: \"border-box\",\n");
            else
                buf.put(spaces ~ "    display: \"inline-flex\", alignItems: \"center\", whiteSpace: \"nowrap\", boxSizing: \"border-box\",\n");
        }
        else if (elem.primitiveName == "TextInput")
        {
            buf.put(spaces ~ "    background: \"transparent\", border: \"none\", outline: \"none\", width: \"100%\", height: \"100%\", padding: 0, boxSizing: \"border-box\",\n");
        }

        if (hasXY && elem.primitiveName != "Rectangle")
        {
            buf.put(spaces ~ "    position: \"absolute\",\n");
        }

        foreach (b; elem.bindings)
        {
            if (isStyleProperty(b.name) && b.expr.strip().length > 0)
            {
                string val = b.expr.strip();
                if (b.name == "visible")
                {
                    buf.put(spaces ~ "    display: (");
                    buf.put(translateExpr(b.expr, comp.name, false, [], elem, parentElem, comp));
                    buf.put(") ? undefined : \"none\",\n");
                }
                else if (b.name == "x")
                {
                    buf.put(spaces ~ "    left: ");
                    buf.put(translateExpr(b.expr, comp.name, false, [], elem, parentElem, comp));
                    buf.put(",\n");
                }
                else if (b.name == "y")
                {
                    buf.put(spaces ~ "    top: ");
                    buf.put(translateExpr(b.expr, comp.name, false, [], elem, parentElem, comp));
                    buf.put(",\n");
                }
                else if (b.name == "clip")
                {
                    if (val == "true")
                        buf.put(spaces ~ "    overflow: \"hidden\",\n");
                    else if (val == "false")
                        buf.put(spaces ~ "    overflow: \"visible\",\n");
                    else
                    {
                        buf.put(spaces ~ "    overflow: (");
                        buf.put(translateExpr(b.expr, comp.name, false, [],
                                elem, parentElem, comp));
                        buf.put(") ? \"hidden\" : \"visible\",\n");
                    }
                }
                else if (b.name == "width" && (b.expr.canFind("parent.width *")
                        || b.expr.canFind("parent.width*")))
                {
                    string factorExpr = b.expr.replace("parent.width *", "")
                        .replace("parent.width*", "").strip();
                    buf.put(spaces ~ "    width: `${(");
                    buf.put(translateExpr(factorExpr, comp.name, false, [],
                            elem, parentElem, comp));
                    buf.put(") * 100}%`,\n");
                }
                else if (b.name == "width" && b.expr.strip() == "parent.width")
                {
                    buf.put(spaces ~ "    width: \"100%\",\n");
                }
                else if (b.name == "height" && (b.expr.canFind("parent.height *")
                        || b.expr.canFind("parent.height*")))
                {
                    string factorExpr = b.expr.replace("parent.height *", "")
                        .replace("parent.height*", "").strip();
                    buf.put(spaces ~ "    height: `${(");
                    buf.put(translateExpr(factorExpr, comp.name, false, [],
                            elem, parentElem, comp));
                    buf.put(") * 100}%`,\n");
                }
                else if (b.name == "height" && b.expr.strip() == "parent.height")
                {
                    buf.put(spaces ~ "    height: \"100%\",\n");
                }
                else if (b.name == "overflow" && (val == "elide" || val == "TextOverflow.elide"))
                {
                    buf.put(
                            spaces
                            ~ "    textOverflow: \"ellipsis\", overflow: \"hidden\", whiteSpace: \"nowrap\",\n");
                }
                else if (b.name == "spacing")
                {
                    buf.put(spaces ~ "    gap: ");
                    buf.put(translateExpr(b.expr, comp.name, false, [], elem, parentElem, comp));
                    buf.put(",\n");
                }
                else if (b.name == "horizontal-stretch" || b.name == "vertical-stretch")
                {
                    string stretchVal = translateExpr(b.expr, comp.name, false,
                            [], elem, parentElem, comp);
                    string basis = (stretchVal.strip() == "0" || b.expr.strip() == "0") ? "\"auto\""
                        : "\"0%\"";
                    buf.put(spaces ~ "    flexGrow: " ~ stretchVal ~ ", flexShrink: "
                            ~ stretchVal ~ ", flexBasis: " ~ basis ~ ",\n");
                }
                else if (b.name == "alignment")
                {
                    string aVal = val;
                    if (aVal.startsWith("LayoutAlignment."))
                        aVal = aVal["LayoutAlignment.".length .. $];
                    if (aVal == "start")
                        aVal = "\"flex-start\"";
                    else if (aVal == "center")
                        aVal = "\"center\"";
                    else if (aVal == "end")
                        aVal = "\"flex-end\"";
                    else if (aVal == "space-between")
                        aVal = "\"space-between\"";
                    else if (aVal == "space-around")
                        aVal = "\"space-around\"";
                    else if (aVal == "stretch")
                        aVal = "\"stretch\"";
                    else if (!aVal.startsWith("\"") && !aVal.startsWith("`"))
                        aVal = "\"" ~ aVal ~ "\"";
                    buf.put(spaces ~ "    justifyContent: " ~ aVal ~ ",\n");
                }
                else if (b.name == "horizontal-alignment")
                {
                    string hVal = val;
                    if (hVal.startsWith("TextHorizontalAlignment."))
                        hVal = hVal["TextHorizontalAlignment.".length .. $];
                    if (hVal == "start" || hVal == "left")
                        hVal = "\"left\"";
                    else if (hVal == "center")
                        hVal = "\"center\"";
                    else if (hVal == "end" || hVal == "right")
                        hVal = "\"right\"";
                    else
                        hVal = translateExpr(b.expr, comp.name);
                    buf.put(spaces ~ "    textAlign: " ~ hVal ~ ",\n");
                }
                else if (b.name == "vertical-alignment")
                {
                    string vVal = val;
                    if (vVal.startsWith("TextVerticalAlignment."))
                        vVal = vVal["TextVerticalAlignment.".length .. $];
                    if (vVal == "center")
                        vVal = "\"center\"";
                    else if (vVal == "top" || vVal == "start")
                        vVal = "\"flex-start\"";
                    else if (vVal == "bottom" || vVal == "end")
                        vVal = "\"flex-end\"";
                    else
                        vVal = translateExpr(b.expr, comp.name, false, [], elem, parentElem, comp);
                    buf.put(spaces ~ "    alignItems: " ~ vVal ~ ",\n");
                }
                else
                {
                    buf.put(spaces ~ "    ");
                    buf.put(toCamelCase(b.name));
                    buf.put(": ");
                    buf.put(translateExpr(b.expr, comp.name, false, [], elem, parentElem, comp));
                    buf.put(",\n");
                }
            }
        }

        string styleClosing = (elem is comp.rootElement) ? "}, props.style)}" : "})}";
        if ((elem.primitiveName == "TextInput" || elem.primitiveName == "Image")
                && elem.children.length == 0)
        {
            buf.put(spaces ~ styleClosing ~ " />\n");
            return;
        }
        buf.put(spaces ~ styleClosing ~ ">\n");

        // Specific element body emissions:
        if (elem.primitiveName == "Text")
        {
            bool hasTextBinding = false;
            foreach (b; elem.bindings)
            {
                if (b.name == "text")
                {
                    hasTextBinding = true;
                    buf.put(spaces ~ "    {");
                    buf.put(translateExpr(b.expr, comp.name, false, [], elem, parentElem, comp));
                    buf.put("}\n");
                }
            }
            if (!hasTextBinding && elem is comp.rootElement)
            {
                buf.put(spaces ~ "    {props.text !== undefined ? props.text : props.children}\n");
            }
        }
        else if (elem.primitiveName == "Path")
        {
            string pathD = "";
            foreach (b; elem.bindings)
            {
                if (b.name == "commands")
                {
                    pathD = translateExpr(b.expr, comp.name, false, [], elem, parentElem, comp);
                }
            }
            buf.put(spaces ~ "    <path d={");
            buf.put(pathD.length > 0 ? pathD : "\"\"");
            buf.put("} />\n");
        }

        // Children
        foreach (child; elem.children)
        {
            if (child.isChildrenSlot)
            {
                buf.put(spaces ~ "    {props.children}\n");
            }
            else if (child.element !is null)
            {
                if (child.element.primitiveName != "TouchArea"
                        && child.element.primitiveName != "FocusScope")
                {
                    generateElementJsx(buf, child.element, comp, indent + 1, elem);
                }
            }
            else if (child.ifBlock !is null)
            {
                generateIfJsx(buf, child.ifBlock, comp, indent + 1, elem);
            }
            else if (child.forBlock !is null)
            {
                generateForJsx(buf, child.forBlock, comp, indent + 1, elem);
            }
        }

        buf.put(spaces);
        buf.put("</");
        buf.put(tag);
        buf.put(">\n");
    }

    private @safe void generateIfJsx(ref Appender!string buf, SlintIf ifBlock,
            SlintComponent comp, size_t indent, SlintElement parentElem = null)
    {
        string spaces = makeIndent(indent);
        buf.put(spaces);
        buf.put("<Show when={");
        buf.put(translateExpr(ifBlock.condition, comp.name, false, [], null, parentElem, comp));
        buf.put("}>\n");

        if (ifBlock.element !is null)
        {
            generateElementJsx(buf, ifBlock.element, comp, indent + 1, parentElem);
        }
        foreach (child; ifBlock.children)
        {
            if (child.element !is null)
            {
                generateElementJsx(buf, child.element, comp, indent + 1, parentElem);
            }
            else if (child.ifBlock !is null)
            {
                generateIfJsx(buf, child.ifBlock, comp, indent + 1, parentElem);
            }
            else if (child.forBlock !is null)
            {
                generateForJsx(buf, child.forBlock, comp, indent + 1, parentElem);
            }
            else if (child.isChildrenSlot)
            {
                buf.put(spaces ~ "    {props.children}\n");
            }
        }

        buf.put(spaces);
        buf.put("</Show>\n");

        if (ifBlock.elseBranch !is null)
        {
            generateIfJsx(buf, ifBlock.elseBranch, comp, indent, parentElem);
        }
    }

    private @safe void generateForJsx(ref Appender!string buf, SlintFor forBlock,
            SlintComponent comp, size_t indent, SlintElement parentElem = null)
    {
        string spaces = makeIndent(indent);
        buf.put(spaces);
        buf.put("<For each={");
        buf.put(translateExpr(forBlock.iterableExpr, comp.name, false, [], null, parentElem, comp));
        buf.put("}>\n");

        buf.put(spaces ~ "    {(");
        buf.put(toCamelCase(forBlock.itemVar));
        if (forBlock.indexVar.length > 0)
        {
            buf.put(", _");
            buf.put(toCamelCase(forBlock.indexVar));
        }
        buf.put(") => {\n");
        if (forBlock.indexVar.length > 0)
        {
            buf.put(spaces ~ "        const ");
            buf.put(toCamelCase(forBlock.indexVar));
            buf.put(" = _");
            buf.put(toCamelCase(forBlock.indexVar));
            buf.put("();\n");
        }
        buf.put(spaces ~ "        return (\n");

        if (forBlock.element !is null)
        {
            generateElementJsx(buf, forBlock.element, comp, indent + 3, parentElem);
        }
        foreach (child; forBlock.children)
        {
            if (child.element !is null)
            {
                generateElementJsx(buf, child.element, comp, indent + 3, parentElem);
            }
            else if (child.ifBlock !is null)
            {
                generateIfJsx(buf, child.ifBlock, comp, indent + 3, parentElem);
            }
            else if (child.forBlock !is null)
            {
                generateForJsx(buf, child.forBlock, comp, indent + 3, parentElem);
            }
        }

        buf.put(spaces ~ "        );\n");
        buf.put(spaces ~ "    }}\n");
        buf.put(spaces);
        buf.put("</For>\n");
    }

    // ── Expression and Identifier Lowering ────────────────────

    private @safe string translateExpr(string expr, string scopeName, bool inGlobal = false, string[] globalProps = [
    ], SlintElement elem = null, SlintElement parentElem = null, SlintComponent comp = null)
    {
        if (expr.length == 0)
            return "\"\"";
        string s = expr.strip();

        // 1. Lower all interpolated string literals: "...\{...}..." -> `...${...}...`
        s = lowerAllInterpolatedStrings(s, scopeName, inGlobal, globalProps);

        // 2. Global property self-references inside SlateTheme
        if (inGlobal)
        {
            foreach (gp; globalProps)
            {
                string camel = toCamelCase(gp);
                s = replaceIdentifier(s, gp, "this." ~ camel);
                s = replaceIdentifier(s, camel, "this." ~ camel);
            }
        }

        // 3. Mask string literals to prevent corruption by keyword/operator lowerings
        string[] literals = maskStringLiterals(s);

        // 4. Lower Math.mod(a, b) -> ((a) % (b))
        s = lowerMathMod(s);

        // Lower math built-ins: round(...) -> Math.round(...)
        s = lowerMathBuiltins(s);

        // Lower animation-tick() -> animationTick()
        s = s.replace("animation-tick()", "animationTick()")
            .replace("animation-tick ()", "animationTick()");
        s = s.replace("animation_tick()", "animationTick()")
            .replace("animation_tick ()", "animationTick()");

        // Lower element geometry references (parent/self/id accesses)
        s = lowerElementPropertyAccesses(s, elem, parentElem, comp);

        // 5. Root property calls: root.foo-bar -> fooBar() or root.func(arg) -> func(arg)
        while (s.canFind("root."))
        {
            auto pos = s.indexOf("root.");
            size_t idStart = pos + 5;
            size_t idEnd = idStart;
            while (idEnd < s.length && (isAlphaNum(s[idEnd]) || s[idEnd] == '_' || s[idEnd] == '-'))
            {
                idEnd++;
            }
            string rawId = s[idStart .. idEnd];
            string camelId = toCamelCase(rawId);

            size_t nextNonSpace = idEnd;
            while (nextNonSpace < s.length && (s[nextNonSpace] == ' ' || s[nextNonSpace] == '\t'))
                nextNonSpace++;
            if (nextNonSpace < s.length && s[nextNonSpace] == '(')
            {
                s = s[0 .. pos] ~ camelId ~ s[idEnd .. $];
            }
            else
            {
                s = s[0 .. pos] ~ camelId ~ "()" ~ s[idEnd .. $];
            }
        }

        // 6. Sibling element hover/press/focus signals dynamically:
        s = lowerSiblingSignals(s);
        s = s.replace("self.", "");
        s = s.replace("Colors.transparent", "\"transparent\"");

        // 7. Hex colors: #0f1117 -> "#0f1117"
        s = lowerHexColors(s);

        // 8. Dimensional units: 16px -> 16, 120ms -> 120
        s = lowerDimensions(s);

        // 9. Operators: == -> ===, != -> !==
        s = s.replace(" == ", " === ");
        s = s.replace(" != ", " !== ");

        // 10. Lower SlateTheme kebab-case accesses: SlateTheme.border-strong -> SlateTheme.borderStrong
        s = lowerSlateThemeAccess(s);

        // 11. Lower transparentize: EXPR.transparentize(50%) -> transparentize(EXPR, 0.5)
        s = lowerTransparentize(s);

        // 12. Lower percentages: 100% -> "100%"
        s = lowerPercentages(s);

        // 13. Lower kebab identifiers and component property accessors
        s = lowerKebabIdentifiers(s);

        // 14. Unmask string literals
        s = unmaskStringLiterals(s, literals);

        return s;
    }

    private @safe string[] maskStringLiterals(ref string s)
    {
        string[] literals;
        Appender!string buf = appender!string();
        size_t i = 0;
        while (i < s.length)
        {
            if (s[i] == '"' || s[i] == '`')
            {
                char quote = s[i];
                size_t start = i;
                i++;
                while (i < s.length)
                {
                    if (s[i] == '\\' && i + 1 < s.length)
                    {
                        i += 2;
                        continue;
                    }
                    if (s[i] == quote)
                    {
                        i++;
                        break;
                    }
                    i++;
                }
                literals ~= s[start .. i];
                buf.put("__STR_LIT_" ~ to!string(literals.length - 1) ~ "__");
            }
            else
            {
                buf.put(s[i]);
                i++;
            }
        }
        s = buf.data;
        return literals;
    }

    private @safe string unmaskStringLiterals(string s, const(string[]) literals)
    {
        string res = s;
        foreach (idx, lit; literals)
        {
            string placeholder = "__STR_LIT_" ~ to!string(idx) ~ "__";
            res = res.replace(placeholder, lit);
        }
        return res;
    }

    private @safe string lowerMathMod(string s)
    {
        while (true)
        {
            ptrdiff_t pos = s.indexOf("Math.mod");
            size_t skipLen = 8;
            if (pos < 0)
            {
                pos = s.indexOf("mod");
                if (pos >= 0)
                {
                    if ((pos > 0 && (isAlphaNum(s[pos - 1]) || s[pos - 1] == '_' || s[pos - 1] == '.'))
                            || (pos + 3 < s.length && s[pos + 3] != '(' && s[pos + 3] != ' '))
                    {
                        break;
                    }
                    skipLen = 3;
                }
                else
                {
                    break;
                }
            }
            ptrdiff_t openP = s.indexOf("(", pos + skipLen);
            if (openP < 0 || openP - (pos + skipLen) > 5)
                break;
            ptrdiff_t closeP = findMatchingParen(s, openP);
            if (closeP < 0)
                break;
            string inner = s[openP + 1 .. closeP];
            int depth = 0;
            ptrdiff_t commaPos = -1;
            foreach (i, c; inner)
            {
                if (c == '(' || c == '{' || c == '[')
                    depth++;
                else if (c == ')' || c == '}' || c == ']')
                    depth--;
                else if (c == ',' && depth == 0)
                {
                    commaPos = cast(ptrdiff_t) i;
                    break;
                }
            }
            if (commaPos >= 0)
            {
                string a = inner[0 .. commaPos].strip();
                string b = inner[commaPos + 1 .. $].strip();
                string repl = "((" ~ a ~ ") % (" ~ b ~ "))";
                s = s[0 .. pos] ~ repl ~ s[closeP + 1 .. $];
            }
            else
            {
                break;
            }
        }
        return s;
    }

    private @safe string lowerMathBuiltins(string s)
    {
        string[7] mathFns = [
            "round", "floor", "ceil", "abs", "min", "max", "sqrt"
        ];
        foreach (fn; mathFns)
        {
            size_t idx = 0;
            while (true)
            {
                auto pos = s.indexOf(fn, idx);
                if (pos < 0)
                    break;
                // Check if preceded by a dot or identifier (with or without spaces, e.g. "Math . " or "Math.")
                size_t prevNonSpace = pos;
                while (prevNonSpace > 0 && (s[prevNonSpace - 1] == ' ' || s[prevNonSpace - 1] == '\t'))
                    prevNonSpace--;
                if (prevNonSpace > 0 && (isAlphaNum(s[prevNonSpace - 1])
                        || s[prevNonSpace - 1] == '_' || s[prevNonSpace - 1] == '.'))
                {
                    idx = pos + fn.length;
                    continue;
                }
                size_t p = pos + fn.length;
                while (p < s.length && s[p] == ' ')
                    p++;
                if (p < s.length && s[p] == '(')
                {
                    s = s[0 .. pos] ~ "Math." ~ fn ~ s[p .. $];
                    idx = pos + 5 + fn.length;
                }
                else
                {
                    idx = pos + fn.length;
                }
            }
        }
        s = s.replace("Math . ", "Math.").replace("Math .", "Math.");
        return s;
    }

    private @safe string translateSimpleExpr(string e, string compName)
    {
        string s = e.strip();
        s = lowerDimensions(s);
        while (s.canFind("root."))
        {
            auto pos = s.indexOf("root.");
            size_t idStart = pos + 5;
            size_t idEnd = idStart;
            while (idEnd < s.length && (isAlphaNum(s[idEnd]) || s[idEnd] == '_' || s[idEnd] == '-'))
                idEnd++;
            string camelId = toCamelCase(s[idStart .. idEnd]);
            s = s[0 .. pos] ~ camelId ~ "()" ~ s[idEnd .. $];
        }
        return s;
    }

    private @safe string lowerElementPropertyAccesses(string s,
            SlintElement elem = null, SlintElement parentElem = null, SlintComponent comp = null)
    {
        string selfW = "20";
        string selfH = "20";
        if (elem !is null)
        {
            foreach (b; elem.bindings)
            {
                if (b.name == "width" && !b.expr.canFind("self.") && !b.expr.canFind("parent."))
                    selfW = "(" ~ translateSimpleExpr(b.expr, comp ? comp.name : "") ~ ")";
                else if (b.name == "height" && !b.expr.canFind("self.")
                        && !b.expr.canFind("parent."))
                    selfH = "(" ~ translateSimpleExpr(b.expr, comp ? comp.name : "") ~ ")";
            }
        }

        string parentW = "100";
        string parentH = "100";
        if (parentElem !is null)
        {
            foreach (b; parentElem.bindings)
            {
                if (b.name == "width" && !b.expr.canFind("self.")
                        && !b.expr.canFind("parent.") && b.expr.strip() != "100%")
                    parentW = "(" ~ translateSimpleExpr(b.expr, comp ? comp.name : "") ~ ")";
                else if (b.name == "height" && !b.expr.canFind("self.")
                        && !b.expr.canFind("parent.") && b.expr.strip() != "100%")
                    parentH = "(" ~ translateSimpleExpr(b.expr, comp ? comp.name : "") ~ ")";
            }
        }
        if (parentW == "100" && comp !is null)
        {
            foreach (p; comp.properties)
            {
                if (p.name == "size")
                    parentW = "size()";
                else if (p.name == "width" && parentW == "100")
                    parentW = "width()";
            }
        }
        if (parentH == "100" && comp !is null)
        {
            foreach (p; comp.properties)
            {
                if (p.name == "size")
                    parentH = "size()";
                else if (p.name == "height" && parentH == "100")
                    parentH = "height()";
            }
        }

        // 1. Lower parent.width/height, self.width/height, self.x/y
        s = s.replace("parent.width", parentW).replace("parent.height", parentH);
        s = s.replace("self.width", selfW).replace("self.height", selfH);
        s = s.replace("self.x", "0").replace("self.y", "0");
        s = s.replace("self.preferred-width", "60").replace("self.preferred-height", "40");
        s = s.replace("self.preferredWidth", "60").replace("self.preferredHeight", "40");
        s = s.replace("self.visible", "true").replace("parent.visible", "true");
        s = s.replace("self.text", "''");
        s = s.replace("self.pressed", "false");
        s = s.replace("self.mouse-x", "0").replace("self.mouse-y", "0");
        s = s.replace("self.pressed-x", "0").replace("self.pressed-y", "0");
        s = s.replace("self.focus()", "(() => {})()");
        s = s.replace("backdrop.opacity", "0");

        // 2. Lower <id>.preferred-width, <id>.preferredWidth -> 60
        //    <id>.preferred-height, <id>.preferredHeight -> 40
        string[2] prefWidths = [".preferred-width", ".preferredWidth"];
        foreach (pw; prefWidths)
        {
            while (true)
            {
                auto pos = s.indexOf(pw);
                if (pos < 0)
                    break;
                ptrdiff_t idStart = pos;
                while (idStart > 0 && (isAlphaNum(s[idStart - 1])
                        || s[idStart - 1] == '_' || s[idStart - 1] == '-'))
                    idStart--;
                s = s[0 .. idStart] ~ "60" ~ s[pos + pw.length .. $];
            }
        }

        string[2] prefHeights = [".preferred-height", ".preferredHeight"];
        foreach (ph; prefHeights)
        {
            while (true)
            {
                auto pos = s.indexOf(ph);
                if (pos < 0)
                    break;
                ptrdiff_t idStart = pos;
                while (idStart > 0 && (isAlphaNum(s[idStart - 1])
                        || s[idStart - 1] == '_' || s[idStart - 1] == '-'))
                    idStart--;
                s = s[0 .. idStart] ~ "40" ~ s[pos + ph.length .. $];
            }
        }

        // 3. Lower <id>.width and <id>.height (where id != root, style, props, window, this)
        size_t wIdx = 0;
        while (true)
        {
            auto pos = s.indexOf(".width", wIdx);
            if (pos < 0)
                break;
            ptrdiff_t idStart = pos;
            while (idStart > 0 && (isAlphaNum(s[idStart - 1])
                    || s[idStart - 1] == '_' || s[idStart - 1] == '-'))
                idStart--;
            string id = s[idStart .. pos];
            if (id == "root" || id == "style" || id == "props" || id == "window"
                    || id == "this" || id == "")
            {
                wIdx = pos + 6;
                continue;
            }
            s = s[0 .. idStart] ~ "100" ~ s[pos + 6 .. $];
            wIdx = idStart + 3;
        }

        size_t hIdx = 0;
        while (true)
        {
            auto pos = s.indexOf(".height", hIdx);
            if (pos < 0)
                break;
            ptrdiff_t idStart = pos;
            while (idStart > 0 && (isAlphaNum(s[idStart - 1])
                    || s[idStart - 1] == '_' || s[idStart - 1] == '-'))
                idStart--;
            string id = s[idStart .. pos];
            if (id == "root" || id == "style" || id == "props" || id == "window"
                    || id == "this" || id == "")
            {
                hIdx = pos + 7;
                continue;
            }
            s = s[0 .. idStart] ~ "40" ~ s[pos + 7 .. $];
            hIdx = idStart + 2;
        }

        // 4. Lower <id>.x and <id>.y
        string[2] xySuffixes = [".x", ".y"];
        foreach (suf; xySuffixes)
        {
            size_t sIdx = 0;
            while (true)
            {
                auto pos = s.indexOf(suf, sIdx);
                if (pos < 0)
                    break;
                if (pos + suf.length < s.length && isAlphaNum(s[pos + suf.length]))
                {
                    sIdx = pos + suf.length;
                    continue;
                }
                ptrdiff_t idStart = pos;
                while (idStart > 0 && (isAlphaNum(s[idStart - 1])
                        || s[idStart - 1] == '_' || s[idStart - 1] == '-'))
                    idStart--;
                string id = s[idStart .. pos];
                if (id == "root" || id == "Math" || id == "this" || id == "")
                {
                    sIdx = pos + suf.length;
                    continue;
                }
                s = s[0 .. idStart] ~ "0" ~ s[pos + suf.length .. $];
                sIdx = idStart + 1;
            }
        }

        return s;
    }

    private @safe string lowerSiblingSignals(string s)
    {
        string[] sigSuffixes = [".has-hover", ".pressed", ".has-focus"];
        string[] tsSuffixes = ["_hasHover()", "_pressed()", "_hasFocus()"];

        foreach (i, suf; sigSuffixes)
        {
            size_t searchPos = 0;
            while (searchPos < s.length)
            {
                ptrdiff_t pos = s.indexOf(suf, searchPos);
                if (pos <= 0)
                    break;
                ptrdiff_t start = pos;
                while (start > 0 && (isAlphaNum(s[start - 1])
                        || s[start - 1] == '_' || s[start - 1] == '-'))
                {
                    start--;
                }
                if (start == pos)
                {
                    searchPos = pos + suf.length;
                    continue;
                }
                string id = s[start .. pos];
                string camelId = toCamelCase(id);
                string repl = camelId ~ tsSuffixes[i];
                s = s[0 .. start] ~ repl ~ s[pos + suf.length .. $];
                searchPos = start + repl.length;
            }
        }
        return s;
    }

    private @safe string lowerKebabIdentifiers(string s)
    {
        Appender!string buf = appender!string();
        size_t i = 0;
        while (i < s.length)
        {
            if (isAlpha(s[i]) || s[i] == '_')
            {
                size_t start = i;
                bool hasHyphen = false;
                while (i < s.length && (isAlphaNum(s[i]) || s[i] == '_' || s[i] == '-'))
                {
                    if (s[i] == '-')
                    {
                        if (i + 1 < s.length && (isAlphaNum(s[i + 1]) || s[i + 1] == '_'))
                        {
                            hasHyphen = true;
                        }
                        else
                        {
                            break;
                        }
                    }
                    i++;
                }
                string word = s[start .. i];
                char prevChar = start > 0 ? s[start - 1] : ' ';
                char nextChar = i < s.length ? s[i] : ' ';
                size_t nextNonWs = i;
                while (nextNonWs < s.length && (s[nextNonWs] == ' '
                        || s[nextNonWs] == '\t' || s[nextNonWs] == '\n'))
                    nextNonWs++;
                bool isObjectKey = (nextNonWs < s.length && s[nextNonWs] == ':');

                if (hasHyphen)
                {
                    string camel = toCamelCase(word);
                    if (prevChar == '.')
                    {
                        buf.put(camel);
                    }
                    else if (camel.endsWith("_hasHover")
                            || camel.endsWith("_pressed") || camel.endsWith("_hasFocus"))
                    {
                        buf.put(camel);
                    }
                    else
                    {
                        if (!isObjectKey && canFind(currentCompProps, camel) && nextChar != '(')
                        {
                            buf.put(camel ~ "()");
                        }
                        else
                        {
                            buf.put(camel);
                        }
                    }
                }
                else
                {
                    if (word == "true" || word == "false" || word == "null" || word == "return"
                            || word == "accept" || word == "reject" || word == "typeof"
                            || word == "Math" || word == "SlateTheme"
                            || word == "Colors" || word == "Key" || word == "this" || word == "props")
                    {
                        buf.put(word);
                    }
                    else if (!isObjectKey && prevChar != '.' && nextChar != '('
                            && canFind(currentCompProps, word))
                    {
                        buf.put(word ~ "()");
                    }
                    else
                    {
                        buf.put(word);
                    }
                }
            }
            else
            {
                buf.put(s[i]);
                i++;
            }
        }
        return buf.data;
    }

    private @safe string translateCallbackBody(string code, SlintComponent comp)
    {
        string compName = comp !is null ? comp.name : "";
        string trimmed = code.strip();
        if (trimmed.startsWith("{") && trimmed.endsWith("}"))
        {
            trimmed = trimmed[1 .. $ - 1].strip();
        }
        if (trimmed.length == 0)
            return "{}";

        // Normalize space-padded dots: "root . foo" -> "root.foo"
        trimmed = trimmed.replace("root . ", "root.").replace("self . ",
                "self.").replace("node . ", "node.").replace("item . ", "item.");

        // Lower root assignments inside any block: root.prop = val -> setProp(val)
        trimmed = lowerRootAssignments(trimmed, compName);

        // Ensure if conditions have parentheses
        trimmed = ensureIfParens(trimmed, compName);

        // Lower callback calls: root.foo(...) -> props.onFoo?.(...)
        size_t cbIdx = 0;
        while (true)
        {
            auto pos = trimmed.indexOf("root.", cbIdx);
            if (pos < 0)
                break;
            size_t idStart = pos + 5;
            size_t idEnd = idStart;
            while (idEnd < trimmed.length && (isAlphaNum(trimmed[idEnd])
                    || trimmed[idEnd] == '_' || trimmed[idEnd] == '-'))
                idEnd++;
            size_t openP = idEnd;
            while (openP < trimmed.length && trimmed[openP] == ' ')
                openP++;
            if (openP < trimmed.length && trimmed[openP] == '(')
            {
                string rawId = trimmed[idStart .. idEnd].strip();
                string cbName = toCamelCase(rawId);
                ptrdiff_t closeP = findMatchingParen(trimmed, openP);
                if (closeP > openP)
                {
                    string args = trimmed[openP + 1 .. closeP].strip();
                    string tsArgs = args.length > 0 ? translateExpr(args, compName) : "";

                    // Check if rawId or cbName is a component function in comp.functions
                    bool isComponentFunction = false;
                    if (comp !is null)
                    {
                        foreach (fn; comp.functions)
                        {
                            if (toCamelCase(fn.name) == cbName || fn.name == rawId)
                            {
                                isComponentFunction = true;
                                break;
                            }
                        }
                    }

                    if (isComponentFunction)
                    {
                        string call = cbName ~ "(" ~ tsArgs ~ ")";
                        trimmed = trimmed[0 .. pos] ~ call ~ trimmed[closeP + 1 .. $];
                        cbIdx = pos + call.length;
                        continue;
                    }

                    string onCbName = cbName.startsWith("on") ? cbName
                        : ("on" ~ capitalizeFirst(cbName));
                    string bareCbName = cbName.startsWith("on") && cbName.length > 2
                        ? (cbName[2 .. 3].toLower() ~ cbName[3 .. $]) : cbName;
                    string call = "(props." ~ onCbName ~ " ?? props."
                        ~ bareCbName ~ ")?.(" ~ tsArgs ~ ")";
                    trimmed = trimmed[0 .. pos] ~ call ~ trimmed[closeP + 1 .. $];
                    cbIdx = pos + call.length;
                    continue;
                }
            }
            cbIdx = idEnd;
        }

        // Lower any remaining expressions
        trimmed = translateExpr(trimmed, compName);

        return "{ " ~ trimmed ~ (trimmed.endsWith(";") ? " " : "; ") ~ "}";
    }

    private @safe string lowerAllInterpolatedStrings(string s, string scopeName,
            bool inGlobal, string[] globalProps)
    {
        if (!s.canFind("\\{"))
            return s;
        if (s.startsWith("\"") && s.endsWith("\""))
        {
            return lowerInterpolatedString(s, scopeName, inGlobal, globalProps);
        }
        auto buf = appender!string();
        size_t i = 0;
        while (i < s.length)
        {
            if (s[i] == '"')
            {
                size_t start = i;
                i++;
                while (i < s.length)
                {
                    if (s[i] == '\\' && i + 1 < s.length)
                    {
                        i += 2;
                        continue;
                    }
                    if (s[i] == '"')
                    {
                        i++;
                        break;
                    }
                    i++;
                }
                string lit = s[start .. i];
                if (lit.canFind("\\{"))
                    buf.put(lowerInterpolatedString(lit, scopeName, inGlobal, globalProps));
                else
                    buf.put(lit);
            }
            else
            {
                buf.put(s[i]);
                i++;
            }
        }
        return buf.data;
    }

    private @safe string lowerInterpolatedString(string s, string scopeName,
            bool inGlobal, string[] globalProps)
    {
        string inner = s[1 .. $ - 1];
        auto buf = appender!string();
        buf.put("`");
        size_t i = 0;
        while (i < inner.length)
        {
            if (inner[i] == '\\' && i + 1 < inner.length && inner[i + 1] == '{')
            {
                i += 2;
                int braceDepth = 1;
                size_t exprStart = i;
                while (i < inner.length && braceDepth > 0)
                {
                    if (inner[i] == '{')
                        braceDepth++;
                    else if (inner[i] == '}')
                    {
                        braceDepth--;
                        if (braceDepth == 0)
                            break;
                    }
                    i++;
                }
                string subExpr = inner[exprStart .. i];
                buf.put("${");
                buf.put(translateExpr(subExpr, scopeName, inGlobal, globalProps));
                buf.put("}");
                if (i < inner.length && inner[i] == '}')
                    i++;
            }
            else
            {
                buf.put(inner[i]);
                i++;
            }
        }
        buf.put("`");
        return buf.data;
    }

    private @safe string lowerHexColors(string s)
    {
        auto buf = appender!string();
        size_t i = 0;
        while (i < s.length)
        {
            if (s[i] == '#' && (i == 0 || s[i - 1] != '"'))
            {
                size_t hexStart = i;
                i++;
                while (i < s.length && isHexDigit(s[i]))
                {
                    i++;
                }
                string hexVal = s[hexStart .. i];
                buf.put("\"");
                buf.put(hexVal);
                buf.put("\"");
            }
            else
            {
                buf.put(s[i]);
                i++;
            }
        }
        return buf.data;
    }

    private @safe string lowerDimensions(string s)
    {
        string[] units = ["deg", "rad", "px", "ms", "pt", "s"];
        foreach (u; units)
        {
            size_t searchPos = 0;
            while (searchPos < s.length)
            {
                auto uPos = s.indexOf(u, searchPos);
                if (uPos <= 0)
                    break;
                size_t numStart = uPos;
                while (numStart > 0 && (isDigit(s[numStart - 1]) || s[numStart - 1] == '.'))
                {
                    numStart--;
                }
                if (numStart == uPos)
                {
                    searchPos = uPos + u.length;
                    continue;
                }
                if (uPos + u.length < s.length && isAlphaNum(s[uPos + u.length]))
                {
                    searchPos = uPos + u.length;
                    continue;
                }
                string numStr = s[numStart .. uPos];
                if (u == "s")
                    numStr = to!string(cast(long)(to!double(numStr) * 1000));
                else if (u == "deg")
                    numStr = "((" ~ numStr ~ " * Math.PI) / 180)";
                s = s[0 .. numStart] ~ numStr ~ s[uPos + u.length .. $];
                searchPos = numStart + numStr.length;
            }
        }
        return s;
    }

    private @safe string replaceIdentifier(string s, string id, string repl)
    {
        size_t start = 0;
        while (true)
        {
            auto pos = s.indexOf(id, start);
            if (pos < 0)
                break;
            bool prevOk = (pos == 0) || (!isAlphaNum(s[pos - 1])
                    && s[pos - 1] != '_' && s[pos - 1] != '-' && s[pos - 1] != '.');
            bool nextOk = (pos + id.length >= s.length)
                || (!isAlphaNum(s[pos + id.length]) && s[pos + id.length] != '_'
                        && s[pos + id.length] != '-');
            if (prevOk && nextOk)
            {
                s = s[0 .. pos] ~ repl ~ s[pos + id.length .. $];
                start = pos + repl.length;
            }
            else
            {
                start = pos + id.length;
            }
        }
        return s;
    }

    private @safe pure nothrow bool isHexDigit(char c)
    {
        return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
    }

    private @safe bool isBuiltInPrimitive(string prim)
    {
        switch (prim)
        {
        case "Window":
        case "Rectangle":
        case "HorizontalLayout":
        case "VerticalLayout":
        case "Flickable":
        case "Text":
        case "TextInput":
        case "Image":
        case "Path":
        case "TouchArea":
        case "FocusScope":
        case "Timer":
            return true;
        default:
            return false;
        }
    }

    private @safe string mapPrimitiveToTag(string prim)
    {
        switch (prim)
        {
        case "Window":
        case "Rectangle":
        case "HorizontalLayout":
        case "VerticalLayout":
        case "Flickable":
        case "TouchArea":
        case "FocusScope":
            return "div";
        case "Text":
            return "span";
        case "TextInput":
            return "input";
        case "Image":
            return "img";
        case "Path":
            return "svg";
        default:
            return prim;
        }
    }

    private @safe bool isStyleProperty(string name)
    {
        switch (name)
        {
        case "background":
        case "color":
        case "width":
        case "height":
        case "min-width":
        case "min-height":
        case "max-width":
        case "max-height":
