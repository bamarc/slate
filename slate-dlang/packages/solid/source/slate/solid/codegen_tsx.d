    private @safe string toTsType(string slintType)
    {
        if (slintType.startsWith("[") && slintType.endsWith("]"))
        {
            return toTsType(slintType[1 .. $ - 1]) ~ "[]";
        }
        switch (slintType)
        {
        case "bool":
            return "boolean";
        case "int":
        case "float":
        case "length":
        case "duration":
            return "number";
        case "string":
            return "string";
        case "color":
        case "image":
            return "string";
        case "void":
            return "void";
        default:
            return slintType;
        }
    }

    private @safe string toCamelCase(string s)
    {
        if (s.length == 0)
            return "";
        auto parts = s.split("-");
        if (parts.length == 1)
            return s;

        string result = parts[0];
        foreach (part; parts[1 .. $])
        {
            if (part.length > 0)
            {
                result ~= cast(char) toUpper(part[0]) ~ part[1 .. $];
            }
        }
        return result;
    }

    private @safe string capitalizeFirst(string s)
    {
        if (s.length == 0)
            return "";
        return cast(char) toUpper(s[0]) ~ s[1 .. $];
    }

    private @safe string makeIndent(size_t level)
    {
        string res = "";
        foreach (_; 0 .. level * 4)
        {
            res ~= " ";
        }
        return res;
    }

    private @safe string cleanImportPath(string p)
    {
        string cleaned = p.replace("\"", "").replace("'", "").replace("\\", "/");
        return baseName(cleaned).stripExtension();
    }

    private @safe string lowerSlateThemeAccess(string s)
    {
        size_t stIdx = 0;
        while (true)
        {
            auto pos = s.indexOf("SlateTheme.", stIdx);
            if (pos < 0)
                break;
            size_t idStart = pos + 11;
            size_t idEnd = idStart;
            while (idEnd < s.length && (isAlphaNum(s[idEnd]) || s[idEnd] == '_' || s[idEnd] == '-'))
            {
                idEnd++;
            }
            string rawId = s[idStart .. idEnd];
            string camelId = toCamelCase(rawId);
            s = s[0 .. pos] ~ "SlateTheme." ~ camelId ~ s[idEnd .. $];
            stIdx = pos + 11 + camelId.length;
        }
        return s;
    }

    private @safe string lowerTransparentize(string s)
    {
        while (s.canFind(".transparentize"))
        {
            auto tPos = s.indexOf(".transparentize");
            ptrdiff_t exprStart = cast(ptrdiff_t) tPos - 1;
            while (exprStart >= 0 && s[exprStart] == ' ')
                exprStart--;
            if (exprStart >= 0 && s[exprStart] == ')')
            {
                exprStart = findMatchingParenBackwards(s, exprStart);
                if (exprStart > 0)
                    exprStart--;
            }
            while (exprStart > 0 && (isAlphaNum(s[exprStart - 1])
                    || s[exprStart - 1] == '_' || s[exprStart - 1] == '.' || s[exprStart - 1] == '-'))
                exprStart--;
            if (exprStart < 0)
                exprStart = 0;
            string targetColor = s[exprStart .. tPos].strip();

            auto openP = s.indexOf("(", tPos);
            if (openP < 0)
                break;
            auto closeP = s.indexOf(")", openP);
            if (closeP < 0)
                break;
            if (openP > tPos && closeP > openP)
            {
                string argStr = s[openP + 1 .. closeP].strip();
                string factorStr = "0.5";
                if (argStr.endsWith("%"))
                {
                    string numPart = argStr[0 .. $ - 1].strip();
                    factorStr = (to!double(numPart) / 100.0).to!string;
                }
                else if (argStr.length > 0)
                {
                    factorStr = argStr;
                }
                s = s[0 .. exprStart] ~ "transparentize(" ~ targetColor ~ ", "
                    ~ factorStr ~ ")" ~ s[closeP + 1 .. $];
            }
            else
                break;
        }
        return s;
    }

    private @safe string lowerRootAssignments(string code, string compName)
    {
        string s = code;
        size_t idx = 0;
        while (true)
        {
            auto pos = s.indexOf("root.", idx);
            if (pos < 0)
                break;
            size_t idStart = pos + 5;
            size_t idEnd = idStart;
            while (idEnd < s.length && (isAlphaNum(s[idEnd]) || s[idEnd] == '_' || s[idEnd] == '-'))
                idEnd++;
            string propName = s[idStart .. idEnd];
            size_t afterId = idEnd;
            while (afterId < s.length && s[afterId] == ' ')
                afterId++;
            bool isAssign = false;
            string op = "=";
            size_t valStart = afterId;

            if (afterId + 1 < s.length && s[afterId .. afterId + 2] == "+=")
            {
                isAssign = true;
                op = "+=";
                valStart = afterId + 2;
            }
            else if (afterId + 1 < s.length && s[afterId .. afterId + 2] == "-=")
            {
                isAssign = true;
                op = "-=";
                valStart = afterId + 2;
            }
            else if (afterId < s.length && s[afterId] == '='
                    && (afterId + 1 == s.length || s[afterId + 1] != '='))
            {
                isAssign = true;
                op = "=";
                valStart = afterId + 1;
            }

            if (isAssign)
            {
                while (valStart < s.length && s[valStart] == ' ')
                    valStart++;
                size_t valEnd = valStart;
                int parenDepth = 0;
                while (valEnd < s.length)
                {
                    if (s[valEnd] == '(')
                        parenDepth++;
                    else if (s[valEnd] == ')')
                        parenDepth--;
                    else if (parenDepth == 0 && (s[valEnd] == ';' || s[valEnd] == '}'))
                        break;
                    valEnd++;
                }
                string valExpr = s[valStart .. valEnd].strip();
                string getter = toCamelCase(propName) ~ "()";
                string finalVal = translateExpr(valExpr, compName);
                if (op == "+=")
                    finalVal = getter ~ " + " ~ finalVal;
                else if (op == "-=")
                    finalVal = getter ~ " - " ~ finalVal;

                string setterCall = "setLocal" ~ capitalizeFirst(
                        toCamelCase(propName)) ~ "(" ~ finalVal ~ ")";
                s = s[0 .. pos] ~ setterCall ~ s[valEnd .. $];
                idx = pos + setterCall.length;
            }
            else
            {
                idx = idEnd;
            }
        }
        return s;
    }

    private @safe string ensureIfParens(string s, string compName)
    {
        size_t idx = 0;
        while (true)
        {
            auto pos = s.indexOf("if ", idx);
            if (pos < 0)
                break;
            size_t condStart = pos + 3;
            while (condStart < s.length && s[condStart] == ' ')
                condStart++;
            if (condStart < s.length && s[condStart] != '(')
            {
                auto bracePos = s.indexOf("{", condStart);
                if (bracePos > condStart)
                {
                    string cond = s[condStart .. bracePos].strip();
                    string tsCond = translateExpr(cond, compName);
                    s = s[0 .. pos] ~ "if (" ~ tsCond ~ ") " ~ s[bracePos .. $];
                    idx = pos + 4 + tsCond.length + 2;
                    continue;
                }
            }
            idx = pos + 3;
        }
        return s;
    }

    private @safe ptrdiff_t findMatchingParen(string s, size_t openIdx)
    {
        int depth = 1;
        for (size_t i = openIdx + 1; i < s.length; i++)
        {
            if (s[i] == '(')
                depth++;
            else if (s[i] == ')')
            {
                depth--;
                if (depth == 0)
                    return i;
            }
        }
        return -1;
    }

    private @safe string lowerPercentages(string s)
    {
        string trimmed = s.strip();
        if (trimmed.startsWith("(") && trimmed.endsWith(")"))
            trimmed = trimmed[1 .. $ - 1].strip();
        if (trimmed.endsWith("%"))
        {
            bool allNum = true;
            foreach (char c; trimmed[0 .. $ - 1])
            {
                if (!isDigit(c) && c != '.')
                {
                    allNum = false;
                    break;
                }
            }
            if (allNum && trimmed.length > 1)
            {
                return "\"" ~ trimmed ~ "\"";
            }
        }
        return s;
    }

    private @safe ptrdiff_t findMatchingParenBackwards(string s, size_t closeIdx)
    {
        int depth = 1;
        for (ptrdiff_t i = cast(ptrdiff_t) closeIdx - 1; i >= 0; i--)
        {
            if (s[i] == ')')
                depth++;
            else if (s[i] == '(')
            {
                depth--;
                if (depth == 0)
                    return i;
            }
        }
        return -1;
    }
}
