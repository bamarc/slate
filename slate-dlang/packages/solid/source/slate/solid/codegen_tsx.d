        case "padding-right":
        case "padding-top":
        case "padding-bottom":
        case "spacing":
        case "font-size":
        case "font-weight":
        case "opacity":
        case "overflow":
        case "horizontal-stretch":
        case "vertical-stretch":
        case "alignment":
        case "horizontal-alignment":
        case "vertical-alignment":
        case "visible":
        case "clip":
