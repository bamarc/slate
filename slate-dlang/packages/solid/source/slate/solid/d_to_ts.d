/++
    Dlang to TypeScript source transpiler (slate:solid).

    Compiles a clean, deterministic subset of D2 (structs, enums, interfaces,
    classes, generics, methods, slices, loops, contracts, scope guards, Phobos math/path)
    into clean, executable TypeScript.
+/
module slate.solid.d_to_ts;

import std.algorithm.searching : canFind;
import std.array : Appender, appender, join;
import std.ascii : isAlpha, isAlphaNum, isDigit, isWhite;
import std.conv : to;
import std.file : exists, readText;
import std.string : endsWith, indexOf, lastIndexOf, replace, split, startsWith,
    strip, stripLeft, stripRight;

/// Exception thrown on syntax errors during D parsing.
class DParseError : Exception
{
    string file;
    size_t line;
    size_t column;

    @safe pure nothrow this(string file, size_t line, size_t column, string message)
    {
        super(file ~ "(" ~ to!string(line) ~ "," ~ to!string(column) ~ "): " ~ message);
        this.file = file;
        this.line = line;
        this.column = column;
    }
}

private struct StructField
{
    string name;
    string type;
}

/// Dlang to TypeScript Transpiler.
class DToTsTranspiler
{
    private int parseDepth = 0;
    enum int maxParseDepth = 128;

    @safe pure nothrow this()
    {
    }

    private @safe void enterRecursion(string file, size_t line, size_t col)
    {
        parseDepth++;
        if (parseDepth > maxParseDepth)
        {
            throw new DParseError(file, line, col,
                    "Maximum parse depth (128) exceeded (possible stack overflow)");
        }
    }

    private @safe void exitRecursion() nothrow
    {
        if (parseDepth > 0)
        {
            parseDepth--;
        }
    }

    /// Transpile a Dlang source file from disk into TypeScript.
    @safe string transpileFile(string filePath)
    {
        string source = readText(filePath);
        return transpileSource(source, filePath);
    }

    /// Transpile Dlang source string into TypeScript.
    @safe string transpileSource(string source, string filePath = "source.d")
    {
        checkRecursionLimit(source, filePath);

        auto buf = appender!string();
        buf.put(
                "// Auto-generated by slate:solid D-to-TypeScript compiler. DO NOT EDIT DIRECTLY.\n");
        string[] runtimeImports = [
            "ArrayModel", "TreeModel", "Appender", "appender",
            "formattedWrite", "dFormat", "format", "dBaseName", "dDirName",
            "dExtension", "clamp", "min", "max", "abs", "toLower", "toUpper",
            "strip", "buildNormalizedPath", "formatByteSize", "AgentError",
            "assert"
        ];
        buf.put("import { " ~ runtimeImports.join(", ") ~ " } from \"./runtime\";\n");
        buf.put("import { McpControllable, Paginated, Sortable, Filterable, Selectable, DropReceiver, McpBindable, Seekable } from \"./mcp-runtime\";\n\n");

        string cleaned = preprocessDSource(source);
        cleaned = normalizeBracesAndLines(cleaned);
        string[] lines = cleaned.split("\n");

        bool insideClass = false;
        int classBraceDepth = 0;
        bool insideLocalFs = false;
        int localFsBraceDepth = 0;
        string[] currentClassMethodNames;
        string[] currentClassFieldNames;
        bool insideStruct = false;
        bool insideInterface = false;
        int interfaceBraceDepth = 0;

        string currentStructName = "";
        StructField[] currentStructFields;

        foreach (lineIdx, rawLine; lines)
        {
            string line = rawLine.strip();
            size_t lineNum = lineIdx + 1;

            if (line.length == 0)
            {
                buf.put("\n");
                continue;
            }

            if (line.startsWith("module ") || line.startsWith("import "))
            {
                continue;
            }

            // Skip host-only LocalFileSystem class
            if (line.canFind("class LocalFileSystem"))
            {
                insideLocalFs = true;
                localFsBraceDepth = 0;
                foreach (char c; line)
                {
                    if (c == '{')
                        localFsBraceDepth++;
                    if (c == '}')
                        localFsBraceDepth--;
                }
                continue;
            }
            if (insideLocalFs)
            {
                bool seenBrace = (localFsBraceDepth > 0);
                foreach (char c; line)
                {
                    if (c == '{')
                    {
                        localFsBraceDepth++;
                        seenBrace = true;
                    }
                    if (c == '}')
                        localFsBraceDepth--;
                }
                if (seenBrace && localFsBraceDepth <= 0)
                {
                    insideLocalFs = false;
                }
                continue;
            }

            // Skip unittests in output TypeScript
            if (line.startsWith("unittest") || line.startsWith("@safe unittest"))
            {
                break;
            }

            // Check struct end
            if (insideStruct && (line == "}" || line.startsWith("};") || line.startsWith("}")))
            {
                insideStruct = false;
                buf.put("}\n\n");
                // Emit companion factory function for declaration merging
                buf.put("export function " ~ currentStructName ~ "(");
                foreach (i, f; currentStructFields)
                {
                    if (i > 0)
                        buf.put(", ");
                    buf.put(f.name ~ "?: " ~ f.type);
                }
                buf.put("): " ~ currentStructName ~ " {\n");
                buf.put("    return { ");
                foreach (i, f; currentStructFields)
                {
                    if (i > 0)
                        buf.put(", ");
                    buf.put(f.name);
                }
                buf.put(" };\n}\n");
                continue;
            }

            // Check struct field
            if (insideStruct)
            {
                string cleanLine = stripTrailingComment(line);
                if (cleanLine.endsWith(";"))
                {
                    StructField sf;
                    string fStr = lowerStructField(cleanLine, sf);
                    if (sf.name.length > 0)
                        currentStructFields ~= sf;
                    buf.put(fStr);
                    buf.put("\n");
                }
                continue;
            }

            // Track class closing
            if (insideClass)
            {
                string cleanLine = stripTrailingComment(line);
                foreach (char c; cleanLine)
                {
                    if (c == '{')
                        classBraceDepth++;
                    else if (c == '}')
                        classBraceDepth--;
                }
                if (classBraceDepth <= 0)
                {
                    insideClass = false;
                    classBraceDepth = 0;
                    currentClassMethodNames = [];
                    currentClassFieldNames = [];
                    buf.put("}\n");
                    continue;
                }
            }

            // Track interface closing
            if (insideInterface)
            {
                string cleanLine = stripTrailingComment(line);
                foreach (char c; cleanLine)
                {
                    if (c == '{')
                        interfaceBraceDepth++;
                    else if (c == '}')
                        interfaceBraceDepth--;
                }
                if (interfaceBraceDepth <= 0)
                {
                    insideInterface = false;
                    interfaceBraceDepth = 0;
                    buf.put("}\n");
                    continue;
                }
            }

            // Translate D declarations and statements
            string tsLine = translateLine(rawLine, filePath, lineNum, insideClass,
                    classBraceDepth, insideInterface, interfaceBraceDepth,
                    insideStruct, currentStructName, currentStructFields,
                    currentClassMethodNames, currentClassFieldNames);

            if (tsLine.length > 0)
            {
                if (tsLine.startsWith("export class ") && tsLine.endsWith("{"))
                {
                    insideClass = true;
                    classBraceDepth = 1;
                    currentClassMethodNames = collectClassMethodNames(lines[lineIdx .. $]);
                    currentClassFieldNames = collectClassFieldNames(lines[lineIdx .. $]);
                }
                else if (tsLine.startsWith("export interface ") && tsLine.endsWith("{"))
                {
                    if (!insideStruct)
                    {
                        insideInterface = true;
                        interfaceBraceDepth = 1;
                    }
                }
                buf.put(tsLine);
                buf.put("\n");
            }
        }

        return buf.data;
    }

    private @safe string stripTrailingComment(string s)
    {
        bool inQuote = false;
        for (size_t i = 0; i < s.length; i++)
        {
            if (s[i] == '"' && (i == 0 || s[i - 1] != '\\'))
                inQuote = !inQuote;
            else if (!inQuote && s[i] == '/' && i + 1 < s.length && s[i + 1] == '/')
                return s[0 .. i].stripRight();
        }
        return s.stripRight();
    }

    private @safe void checkRecursionLimit(string source, string filePath)
    {
        parseDepth = 0;
        size_t currentLine = 1;
        size_t currentCol = 1;
        size_t i = 0;

        while (i < source.length)
        {
            char c = source[i];

            if (c == '\n')
            {
                currentLine++;
                currentCol = 1;
                i++;
                continue;
            }

            // Skip single-line comments // ...
            if (c == '/' && i + 1 < source.length && source[i + 1] == '/')
            {
                i += 2;
                while (i < source.length && source[i] != '\n')
                {
                    i++;
                }
                continue;
            }

            // Skip block comments /* ... */
            if (c == '/' && i + 1 < source.length && source[i + 1] == '*')
            {
                size_t cLine = currentLine;
                size_t cCol = currentCol;
                i += 2;
                bool closed = false;
                while (i < source.length)
                {
                    if (source[i] == '\n')
                    {
                        currentLine++;
                        currentCol = 1;
                    }
                    else
                    {
                        currentCol++;
                    }
                    if (source[i] == '*' && i + 1 < source.length && source[i + 1] == '/')
                    {
                        i += 2;
                        closed = true;
                        break;
                    }
                    i++;
                }
                if (!closed)
                {
                    throw new DParseError(filePath, cLine, cCol, "Unclosed block comment '/*'");
                }
                continue;
            }

            // Skip nesting block comments /+ ... +/
            if (c == '/' && i + 1 < source.length && source[i + 1] == '+')
            {
                size_t cLine = currentLine;
                size_t cCol = currentCol;
                i += 2;
                int nDepth = 1;
                while (i < source.length && nDepth > 0)
                {
                    if (source[i] == '\n')
                    {
                        currentLine++;
                        currentCol = 1;
                    }
                    else
                    {
                        currentCol++;
                    }
                    if (source[i] == '/' && i + 1 < source.length && source[i + 1] == '+')
                    {
                        nDepth++;
                        i += 2;
                        continue;
                    }
                    if (source[i] == '+' && i + 1 < source.length && source[i + 1] == '/')
                    {
                        nDepth--;
                        i += 2;
                        continue;
                    }
                    i++;
                }
                if (nDepth > 0)
                {
                    throw new DParseError(filePath, cLine, cCol, "Unclosed nested comment '/+'");
                }
                continue;
            }

            // Skip string literals "..."
            if (c == '"')
            {
                size_t sLine = currentLine;
                size_t sCol = currentCol;
                i++;
                bool closed = false;
                while (i < source.length)
                {
                    if (source[i] == '\\' && i + 1 < source.length)
                    {
                        i += 2;
                        currentCol += 2;
                        continue;
                    }
                    if (source[i] == '"')
                    {
                        i++;
                        currentCol++;
                        closed = true;
                        break;
                    }
                    if (source[i] == '\n')
                    {
                        currentLine++;
                        currentCol = 1;
                    }
                    else
                    {
                        currentCol++;
                    }
                    i++;
                }
                if (!closed)
                {
                    throw new DParseError(filePath, sLine, sCol, "Unclosed string literal");
                }
                continue;
            }

            // Skip character literals '...'
            if (c == '\'')
            {
                size_t sLine = currentLine;
                size_t sCol = currentCol;
                i++;
                currentCol++;
                bool closed = false;
                while (i < source.length)
                {
                    if (source[i] == '\\' && i + 1 < source.length)
                    {
                        i += 2;
                        currentCol += 2;
                        continue;
                    }
                    if (source[i] == '\'')
                    {
                        i++;
                        currentCol++;
                        closed = true;
                        break;
                    }
                    if (source[i] == '\n')
                    {
                        break;
                    }
                    i++;
                    currentCol++;
                }
                if (!closed)
                {
                    throw new DParseError(filePath, sLine, sCol, "Unclosed character literal");
                }
                continue;
            }

            // Check delimiter nesting
            if (c == '{' || c == '(' || c == '[')
            {
                enterRecursion(filePath, currentLine, currentCol);
            }
            else if (c == '}' || c == ')' || c == ']')
            {
                parseDepth--;
                if (parseDepth < 0)
                {
                    throw new DParseError(filePath, currentLine, currentCol,
                            "Unmatched closing delimiter: '" ~ c ~ "'");
                }
            }

            currentCol++;
            i++;
        }

        if (parseDepth != 0)
        {
            throw new DParseError(filePath, currentLine, currentCol,
                    "Unclosed block or delimiter at EOF");
        }
    }

    private @safe string preprocessDSource(string source)
    {
        string s = source;

        // Strip version(SlintNative) blocks
        while (true)
        {
            ptrdiff_t vPos = s.indexOf("version (SlintNative)");
            if (vPos < 0)
                break;

            ptrdiff_t openBrace = s.indexOf("{", vPos);
            if (openBrace < 0)
                break;

            ptrdiff_t closeBrace = findMatchingBrace(s, openBrace);
            if (closeBrace < 0)
                break;

            // Check if there is an else block
            string after = s[closeBrace + 1 .. $].strip();
            if (after.startsWith("else"))
            {
                ptrdiff_t elsePos = s.indexOf("else", closeBrace + 1);
                if (elsePos >= 0)
                {
                    ptrdiff_t elseOpen = s.indexOf("{", elsePos);
                    if (elseOpen >= 0)
                    {
                        ptrdiff_t elseClose = findMatchingBrace(s, elseOpen);
                        if (elseClose > 0)
                        {
                            string elseBody = s[elseOpen + 1 .. elseClose];
                            s = s[0 .. vPos] ~ elseBody ~ s[elseClose + 1 .. $];
                            continue;
                        }
                    }
                }
            }

            s = s[0 .. vPos] ~ s[closeBrace + 1 .. $];
        }

        // Handle in { ... } do { contracts
        while (s.canFind("in\n{") || s.canFind("in {"))
        {
            ptrdiff_t inPos = s.indexOf("in {");
            if (inPos < 0)
                inPos = s.indexOf("in\n{");
            if (inPos < 0)
                break;
            ptrdiff_t openB = s.indexOf("{", inPos);
            ptrdiff_t closeB = findMatchingBrace(s, openB);
            if (closeB < 0)
                break;
            ptrdiff_t doPos = s.indexOf("do", closeB);
            if (doPos > 0 && doPos - closeB < 20)
            {
                string inBody = s[openB + 1 .. closeB];
                ptrdiff_t doOpen = s.indexOf("{", doPos);
                if (doOpen > 0)
                {
                    s = s[0 .. inPos] ~ s[doOpen .. doOpen + 1] ~ inBody ~ s[doOpen + 1 .. $];
                    continue;
                }
            }
            break;
        }

        // Strip unittests
        while (true)
        {
            ptrdiff_t uPos = s.indexOf("unittest");
            if (uPos < 0)
                break;

            bool isWord = (uPos == 0 || !isAlphaNum(s[uPos - 1]));
            if (isWord)
            {
                ptrdiff_t openBrace = s.indexOf("{", uPos);
                if (openBrace > 0)
                {
                    ptrdiff_t closeBrace = findMatchingBrace(s, openBrace);
                    if (closeBrace > 0)
                    {
                        size_t stripStart = uPos;
                        string prefix = s[0 .. uPos].stripRight();
                        if (prefix.endsWith("@safe"))
                        {
                            stripStart = s.lastIndexOf("@safe", uPos);
                        }
                        while (stripStart > 0)
                        {
                            ptrdiff_t lastNl = s.lastIndexOf("\n", stripStart - 1);
                            string prevLine = (lastNl >= 0
                                    ? s[lastNl + 1 .. stripStart] : s[0 .. stripStart]).strip();
                            if (prevLine.startsWith("// Spec:") || prevLine.startsWith("/// Example:")
                                    || prevLine.startsWith("// Best practice:")
                                    || prevLine.length == 0)
                            {
                                stripStart = lastNl >= 0 ? cast(size_t) lastNl : 0;
                            }
                            else
                            {
                                break;
                            }
                        }
                        s = s[0 .. stripStart] ~ s[closeBrace + 1 .. $];
                        continue;
                    }
                }
            }
            break;
        }

        // Special case: toGridRowData in datagrid.d
        ptrdiff_t gridRowFunc = s.indexOf("GridRowData toGridRowData(T)(");
        if (gridRowFunc >= 0)
        {
            ptrdiff_t privPos = s.lastIndexOf("private", gridRowFunc);
            size_t startPos = (privPos >= 0 && gridRowFunc - privPos < 20) ? privPos : gridRowFunc;
            ptrdiff_t openBrace = s.indexOf("{", gridRowFunc);
            if (openBrace > 0)
            {
                ptrdiff_t closeBrace = findMatchingBrace(s, openBrace);
                if (closeBrace > 0)
                {
                    string tsImpl = q"{
export function toGridRowData<T = any>(item: any, fallbackIndex: number = 0): GridRowData {
    if (!item) return { id: String(fallbackIndex), col0: "", col1: "", col2: "", col3: "", badge: "", badgeVariant: "default", selected: false };
    return {
        id: item.id !== undefined ? String(item.id) : String(fallbackIndex),
        col0: item.col0 !== undefined ? String(item.col0) : (Array.isArray(item) && item[0] !== undefined ? String(item[0]) : ""),
        col1: item.col1 !== undefined ? String(item.col1) : (Array.isArray(item) && item[1] !== undefined ? String(item[1]) : ""),
        col2: item.col2 !== undefined ? String(item.col2) : (Array.isArray(item) && item[2] !== undefined ? String(item[2]) : ""),
        col3: item.col3 !== undefined ? String(item.col3) : (Array.isArray(item) && item[3] !== undefined ? String(item[3]) : ""),
        badge: item.badge !== undefined ? String(item.badge) : "",
        badgeVariant: item.badgeVariant !== undefined ? String(item.badgeVariant) : "default",
        selected: Boolean(item.selected)
    };
}
}";
                    s = s[0 .. startPos] ~ tsImpl ~ s[closeBrace + 1 .. $];
                }
            }
        }

        return s;
    }

    private @safe string normalizeBracesAndLines(string source)
    {
        string[] rawLines = source.split("\n");
        string[] lines;
        size_t idx = 0;

        while (idx < rawLines.length)
        {
            string line = rawLines[idx];
            string trimmed = line.strip();
            string cleanTrimmed = stripTrailingComment(trimmed);

            if (cleanTrimmed.length == 0 || trimmed.startsWith("/*") || trimmed.startsWith("/+"))
            {
                lines ~= line;
                idx++;
                continue;
            }

            // Join continuation lines until statement ends with { or ; or }
            while (!cleanTrimmed.endsWith("{")
                    && !cleanTrimmed.endsWith(";") && !cleanTrimmed.endsWith("}"))
            {
                size_t nextIdx = idx + 1;
                while (nextIdx < rawLines.length && rawLines[nextIdx].strip().length == 0)
                {
                    nextIdx++;
                }
                if (nextIdx >= rawLines.length)
                    break;

                string nextTrimmed = rawLines[nextIdx].strip();
                if (nextTrimmed.startsWith("//") || nextTrimmed.startsWith("/*"))
                    break;

                line = line ~ " " ~ nextTrimmed;
                trimmed = line.strip();
                cleanTrimmed = stripTrailingComment(trimmed);
                idx = nextIdx;
                if (cleanTrimmed.endsWith("{") || cleanTrimmed.endsWith(";"))
                    break;
            }

            lines ~= line;
            idx++;
        }

        return lines.join("\n");
    }

    private @safe string translateLine(string rawLine, string filePath,
            size_t lineNum, ref bool insideClass, int classBraceDepth,
            ref bool insideInterface, int interfaceBraceDepth, ref bool insideStruct, ref string currentStructName,
            ref StructField[] currentStructFields,
            const(string[]) classMethodNames, const(string[]) classFieldNames = [
    ])
    {
        string s = rawLine;

        // Strip parameterized annotations like @SlintField(...), @McpAction(...)
        string[] paramAnnos = [
            "@SlintField(", "@McpAction(", "@McpState(", "@McpWritable("
        ];
        foreach (anno; paramAnnos)
        {
            while (s.canFind(anno))
            {
                auto start = s.indexOf(anno);
                auto end = s.indexOf(")", start);
                if (end > start)
                    s = s[0 .. start] ~ s[end + 1 .. $];
                else
                    break;
            }
        }

        // Strip D attributes & annotations
        s = s.replace("@safe", "").replace("pure", "").replace("nothrow", "").replace("@nogc", "");
        s = s.replace("override", "").replace("final", "");
        s = s.replace("@McpIgnore", "").replace("@McpState", "")
            .replace("@McpWritable", "").replace("@McpAction", "");

        string trimmed = s.strip();
        if (trimmed.length == 0)
        {
            return "";
        }

        // Skip mixin
        if (trimmed.startsWith("mixin McpControllableMixin") || trimmed.startsWith("mixin("))
        {
            return "";
        }

        // Skip .reserve()
        if (trimmed.canFind(".reserve("))
        {
            return "";
        }

        // Enums: enum Foo { ... }
        if (trimmed.startsWith("enum ") && trimmed.canFind("{"))
        {
            return "export " ~ trimmed;
        }

        // Structs: struct Foo { ... }
        if (trimmed.startsWith("struct ") && trimmed.canFind("{"))
        {
            insideStruct = true;
            ptrdiff_t bIdx = trimmed.indexOf("{");
            string sName = trimmed[7 .. bIdx].strip();
            currentStructName = sName;
            currentStructFields = [];
            return "export interface " ~ sName ~ " {";
        }

        // Interfaces: interface Foo { ... }
        if (trimmed.startsWith("interface ") && trimmed.canFind("{"))
        {
            insideInterface = true;
            return "export " ~ trimmed;
        }

        // Classes: class Foo(T = Bar) : Interfaces {
        if (trimmed.startsWith("class "))
        {
            insideClass = true;
            string rest = trimmed[6 .. $];
            rest = rest.replace("(T = GridRowData)", "<T = GridRowData>");
            if (rest.canFind(" : "))
            {
                auto colonIdx = rest.indexOf(" : ");
                string cName = rest[0 .. colonIdx].strip();
                string bases = rest[colonIdx + 3 .. $].strip();
                rest = cName ~ " implements " ~ bases;
            }
            return "export class " ~ rest;
        }

        // Inside class: Check for class fields or aliases
        string cleanTrimmed = stripTrailingComment(trimmed);
        if (insideClass && classBraceDepth == 1 && cleanTrimmed.startsWith("alias ")
                && cleanTrimmed.canFind("=") && cleanTrimmed.endsWith(";"))
        {
            auto eqIdx = cleanTrimmed.indexOf("=");
            string aliasName = cleanTrimmed[6 .. eqIdx].strip();
            string targetName = cleanTrimmed[eqIdx + 1 .. $ - 1].strip();
            return "    public " ~ aliasName
                ~ "(...args: any[]): any { return (this as any)." ~ targetName ~ "(...args); }";
        }
        if (!insideClass && cleanTrimmed.startsWith("alias ")
                && cleanTrimmed.canFind("=") && cleanTrimmed.endsWith(";"))
        {
            auto eqIdx = cleanTrimmed.indexOf("=");
            string aliasName = cleanTrimmed[6 .. eqIdx].strip();
            string targetName = cleanTrimmed[eqIdx + 1 .. $ - 1].strip();
            return "export const " ~ aliasName ~ " = " ~ targetName ~ ";";
        }

        if (insideClass && classBraceDepth == 1 && cleanTrimmed.endsWith(";"))
        {
            string vis, fType, fName, initVal;
            if (parseClassField(cleanTrimmed, vis, fType, fName, initVal))
            {
                string tsType = mapDTypeToTs(fType);
                if (initVal.length == 0)
                {
                    if (tsType.endsWith("[]"))
                        initVal = "[]";
                    else if (tsType.startsWith("ArrayModel"))
                        initVal = "new " ~ tsType ~ "()";
                    else if (tsType.startsWith("Record<"))
                        initVal = "{}";
                    else if (tsType == "number")
                        initVal = "0";
                    else if (tsType == "boolean")
                        initVal = "false";
                    else if (tsType == "string")
                        initVal = "\"\"";
                    else
                        initVal = "null as any";
                }
                else
                {
                    initVal = lowerStatement(initVal);
                }
                return "    " ~ vis ~ " " ~ fName ~ ": " ~ tsType ~ " = " ~ initVal ~ ";";
            }
        }

        // Inside interface: Check method declarations
        if (insideInterface && trimmed.endsWith(";"))
        {
            string vis, retType, name, params, after;
            bool isStatic;
            if (parseFunctionOrMethod(trimmed, vis, isStatic, retType, name, params, after))
            {
                return "    " ~ name ~ "(" ~ lowerParamList(
                        params) ~ "): " ~ mapDTypeToTs(retType) ~ ";";
            }
        }

        // Function / method definition: RetType name(params) {
        if (trimmed.canFind("(") && trimmed.canFind(")") && trimmed.endsWith("{"))
        {
            string vis, retType, name, params, after;
            bool isStatic;
            if (parseFunctionOrMethod(trimmed, vis, isStatic, retType, name, params, after))
            {
                string inContract = "";
                if (after.canFind("in ("))
                {
                    ptrdiff_t inIdx = after.indexOf("in (");
                    ptrdiff_t closeIn = findMatchingParen(after, inIdx + 3);
                    if (closeIn > inIdx)
                    {
                        inContract = after[inIdx + 4 .. closeIn].strip();
                    }
                }
                string tsParams = lowerParamList(params);
                if (name == "constructor")
                {
                    return "    constructor(" ~ tsParams ~ ") {";
                }
                string tsRet = mapDTypeToTs(retType);
                string contractEmit = inContract.length > 0
                    ? ("\n    assert(" ~ lowerStatement(inContract) ~ ");") : "";
                if (insideClass)
                {
                    return "    " ~ vis ~ (isStatic
                            ? "static " : "") ~ name ~ "(" ~ tsParams ~ "): "
                        ~ tsRet ~ " {" ~ contractEmit;
                }
                else
                {
                    return "export function " ~ name ~ "(" ~ tsParams ~ "): "
                        ~ tsRet ~ " {" ~ contractEmit;
                }
            }
        }

        // Fallback: Lower statement inside function bodies
        string lowered = lowerStatement(s);
        if (insideClass && classBraceDepth > 1)
        {
            lowered = prefixThisOnMembers(lowered, classFieldNames);
            lowered = prefixClassMethods(lowered, classMethodNames);
        }
        return lowered;
    }

    private @safe bool parseClassField(string line, out string visibility,
            out string fieldType, out string fieldName, out string initVal)
    {
        string s = line;
        string[] paramAnnos = [
            "@SlintField(", "@McpAction(", "@McpState(", "@McpWritable("
        ];
        foreach (anno; paramAnnos)
        {
            while (s.canFind(anno))
            {
                auto start = s.indexOf(anno);
                auto end = s.indexOf(")", start);
                if (end > start)
                    s = s[0 .. start] ~ s[end + 1 .. $];
                else
                    break;
            }
        }
        s = s.replace("@SlintField", "").replace("@McpIgnore", "")
            .replace("@McpState", "").replace("@McpWritable", "");
        s = s.replace(";", "").strip();
        if (s.length == 0)
            return false;
        if (s.startsWith("return ") || s.startsWith("throw ")
                || s.startsWith("assert ") || s.startsWith("import ")
                || s.startsWith("mixin ") || s.startsWith("alias "))
            return false;

        initVal = "";
        if (s.canFind("="))
        {
            auto eqIdx = s.indexOf("=");
            initVal = s[eqIdx + 1 .. $].strip();
            s = s[0 .. eqIdx].strip();
        }

        if (s.length == 0 || s.canFind("(") || s.canFind(")") || s.canFind("{") || s.canFind("}"))
            return false;

        visibility = "public";
        if (s.startsWith("private "))
        {
            visibility = "private";
            s = s[8 .. $].strip();
        }
        else if (s.startsWith("public "))
        {
            visibility = "public";
            s = s[7 .. $].strip();
        }
        else if (s.startsWith("protected "))
        {
            visibility = "protected";
            s = s[10 .. $].strip();
        }

        auto spaceIdx = s.lastIndexOf(" ");
        if (spaceIdx <= 0)
            return false;

        fieldType = s[0 .. spaceIdx].strip();
        fieldName = s[spaceIdx + 1 .. $].strip();

        if (fieldName.length == 0 || (!isAlpha(fieldName[0]) && fieldName[0] != '_'))
            return false;
        foreach (char c; fieldName[1 .. $])
        {
            if (!isAlphaNum(c) && c != '_')
                return false;
        }

        return true;
    }

    private @safe bool parseFunctionOrMethod(string line, out string vis, out bool isStatic,
            out string retType, out string name, out string params, out string afterParen)
    {
        string s = line.replace("@safe", "").replace("pure", "")
            .replace("nothrow", "").replace("@nogc", "").replace("override", "")
            .replace("final", "").replace("@McpIgnore", "").replace("@McpState",
                "").replace("@McpWritable", "").replace("@McpAction", "");

        ptrdiff_t bracePos = s.lastIndexOf("{");
        ptrdiff_t semiPos = s.lastIndexOf(";");
        ptrdiff_t endPos = bracePos > 0 ? bracePos : semiPos;
        if (endPos <= 0)
            return false;

        string decl = s[0 .. endPos].strip();
        string contractSuffix = "";
        if (decl.canFind(" in ("))
        {
            ptrdiff_t inIdx = decl.indexOf(" in (");
            contractSuffix = decl[inIdx + 1 .. $].strip();
            decl = decl[0 .. inIdx].strip();
        }
        else if (decl.canFind("\nin ("))
        {
            ptrdiff_t inIdx = decl.indexOf("\nin (");
            contractSuffix = decl[inIdx + 1 .. $].strip();
            decl = decl[0 .. inIdx].strip();
        }

        ptrdiff_t closeParen = decl.lastIndexOf(")");
        if (closeParen <= 0)
            return false;
        ptrdiff_t openParen = findMatchingParenBackwards(decl, closeParen);
        if (openParen <= 0 || closeParen <= openParen)
            return false;

        string beforeParen = decl[0 .. openParen].strip();
        params = decl[openParen + 1 .. closeParen].strip();
        afterParen = decl[closeParen + 1 .. $].strip();
        if (contractSuffix.length > 0)
        {
            afterParen = afterParen.length > 0 ? (afterParen ~ " " ~ contractSuffix)
                : contractSuffix;
        }

        // Reject statements and assignments
        if (beforeParen.canFind("=") || beforeParen.canFind("~=")
                || beforeParen.canFind("+=") || beforeParen.canFind("-=") || beforeParen.canFind(".")
                || beforeParen.startsWith("return ")
                || beforeParen.startsWith("throw ") || beforeParen.startsWith("if ")
                || beforeParen.startsWith("if(") || beforeParen.startsWith("else ") || beforeParen.startsWith("else")
                || beforeParen.startsWith("while ") || beforeParen.startsWith("for ")
                || beforeParen.startsWith("foreach ")
                || beforeParen.startsWith("switch ") || beforeParen.startsWith("catch ")
                || beforeParen.startsWith("catch(")
                || beforeParen.startsWith("assert(") || beforeParen.startsWith("new "))
        {
            return false;
        }

        vis = "";
        isStatic = false;

        // Check constructor this(...)
        if (beforeParen == "this" || beforeParen.endsWith(" this"))
        {
            retType = "";
            name = "constructor";
            return true;
        }

        while (true)
        {
            if (beforeParen.startsWith("private "))
            {
                vis = "private ";
                beforeParen = beforeParen[8 .. $].strip();
            }
            else if (beforeParen.startsWith("public "))
            {
                vis = "public ";
                beforeParen = beforeParen[7 .. $].strip();
            }
            else if (beforeParen.startsWith("protected "))
            {
                vis = "protected ";
                beforeParen = beforeParen[10 .. $].strip();
            }
            else if (beforeParen.startsWith("static "))
            {
                isStatic = true;
                beforeParen = beforeParen[7 .. $].strip();
            }
            else
            {
                break;
            }
        }

        auto spaceIdx = beforeParen.lastIndexOf(" ");
        if (spaceIdx <= 0)
            return false;

        retType = beforeParen[0 .. spaceIdx].strip();
        name = beforeParen[spaceIdx + 1 .. $].strip();

        // Name must be a valid identifier
        if (name.length == 0 || (!isAlpha(name[0]) && name[0] != '_'))
            return false;
        foreach (char c; name[1 .. $])
        {
            if (!isAlphaNum(c) && c != '_')
                return false;
        }

        return true;
    }

    private @safe string lowerStructField(string line, out StructField sf)
    {
        string s = line;
        while (s.canFind("@SlintField("))
        {
            auto start = s.indexOf("@SlintField(");
            auto end = s.indexOf(")", start);
            if (end > start)
                s = s[0 .. start] ~ s[end + 1 .. $];
            else
                break;
        }
        s = s.replace("@McpIgnore", "").replace("@McpState", "").replace("@McpWritable", "");
        s = s.replace(";", "").strip();
        string defaultVal = "";
        if (s.canFind("="))
        {
            auto eqIdx = s.indexOf("=");
            defaultVal = s[eqIdx + 1 .. $].strip();
            s = s[0 .. eqIdx].strip();
        }
        auto spaceIdx = s.lastIndexOf(" ");
        if (spaceIdx <= 0)
            return line;
        string dType = s[0 .. spaceIdx].strip();
        string fName = s[spaceIdx + 1 .. $].strip();
        string tsType = mapDTypeToTs(dType);
        sf.name = fName;
        sf.type = tsType;
        return "    " ~ fName ~ "?: " ~ tsType ~ ";";
    }

    public @safe string mapDTypeToTs(string dType, int depth = 0)
    {
        if (depth > 128)
            return "any";
        string t = dType.strip();
        while (t.canFind("const(") || t.canFind("immutable("))
        {
            ptrdiff_t cOpen = t.indexOf("const(");
            if (cOpen < 0)
                cOpen = t.indexOf("immutable(");
            ptrdiff_t cClose = t.indexOf(")", cOpen);
            if (cClose > cOpen)
            {
                size_t prefixLen = t[cOpen .. $].startsWith("const(") ? 6 : 10;
                t = t[0 .. cOpen] ~ t[cOpen + prefixLen .. cClose] ~ t[cClose + 1 .. $];
            }
            else
                break;
        }
        while (t.startsWith("out ") || t.startsWith("ref ")
                || t.startsWith("in ") || t.startsWith("lazy "))
        {
            t = t[t.indexOf(" ") + 1 .. $].strip();
        }
        if (t.startsWith("const "))
            t = t[6 .. $].strip();
        else if (t.startsWith("immutable "))
            t = t[10 .. $].strip();
        if (t.canFind("(") && t.canFind(")"))
            t = t.replace("(", "").replace(")", "");
        if (t.endsWith("[]"))
            return mapDTypeToTs(t[0 .. $ - 2], depth + 1) ~ "[]";
        if (t.canFind("[") && t.endsWith("]"))
        {
            auto bOpen = t.lastIndexOf("[");
            string valType = t[0 .. bOpen];
            string keyType = t[bOpen + 1 .. $ - 1];
            bool isStaticArray = keyType.length > 0;
            foreach (char c; keyType)
            {
                if (!isDigit(c))
                {
                    isStaticArray = false;
                    break;
                }
            }
            if (isStaticArray)
                return mapDTypeToTs(valType, depth + 1) ~ "[]";
            return "Record<" ~ mapDTypeToTs(keyType,
                    depth + 1) ~ ", " ~ mapDTypeToTs(valType, depth + 1) ~ ">";
        }
        if (t.startsWith("ArrayModel!"))
            return "ArrayModel<" ~ t["ArrayModel!".length .. $] ~ ">";
        if (t.startsWith("TreeModel!"))
            return "TreeModel<" ~ t["TreeModel!".length .. $] ~ ">";

        switch (t)
        {
        case "void":
            return "void";
        case "bool":
            return "boolean";
        case "byte":
        case "ubyte":
        case "short":
        case "ushort":
        case "int":
        case "uint":
        case "long":
        case "ulong":
        case "size_t":
        case "ptrdiff_t":
        case "float":
        case "double":
        case "real":
            return "number";
        case "string":
        case "char[]":
        case "const(char)[]":
            return "string";
        case "ComponentInstance":
            return "any";
        default:
            return t;
        }
    }

    private @safe string lowerParamList(string paramsStr)
    {
        if (paramsStr.strip().length == 0)
            return "";
        string[] rawParams = splitParams(paramsStr);
        string[] result;
        foreach (p; rawParams)
        {
            string trimmed = p.strip();
            if (trimmed.length == 0)
                continue;
            trimmed = trimmed.replace("const ref ", "").replace("ref ", "")
                .replace("out ", "").replace("lazy ", "").replace("auto ", "").replace("in ", "");
            while (trimmed.canFind("const(") || trimmed.canFind("immutable("))
            {
                ptrdiff_t cOpen = trimmed.indexOf("const(");
                if (cOpen < 0)
                    cOpen = trimmed.indexOf("immutable(");
                ptrdiff_t cClose = trimmed.indexOf(")", cOpen);
                if (cClose > cOpen)
                {
                    size_t prefixLen = trimmed[cOpen .. $].startsWith("const(") ? 6 : 10;
                    trimmed = trimmed[0 .. cOpen]
                        ~ trimmed[cOpen + prefixLen .. cClose] ~ trimmed[cClose + 1 .. $];
                }
                else
                    break;
            }
            string defaultVal = "";
            if (trimmed.canFind("="))
            {
                auto eqIdx = trimmed.indexOf("=");
                defaultVal = trimmed[eqIdx + 1 .. $].strip();
                trimmed = trimmed[0 .. eqIdx].strip();
            }
            auto spaceIdx = trimmed.lastIndexOf(" ");
            if (spaceIdx > 0)
            {
                string dType = trimmed[0 .. spaceIdx].strip();
                string pName = trimmed[spaceIdx + 1 .. $].strip();
                string tsType = mapDTypeToTs(dType);
                string param = pName ~ ": " ~ tsType;
                if (defaultVal.length > 0)
                {
                    defaultVal = stripIntLiteralSuffixes(defaultVal);
                    defaultVal = stripFloatLiteralF(defaultVal);
                    if (defaultVal.endsWith("UL") || defaultVal.endsWith("L"))
                        defaultVal = defaultVal[0 .. $ - (defaultVal.endsWith("UL") ? 2 : 1)];
                    if (defaultVal.endsWith("f") || defaultVal.endsWith("F"))
                        defaultVal = defaultVal[0 .. $ - 1];
                    if (defaultVal == "null")
                        defaultVal = "null as any";
                    param ~= " = " ~ defaultVal;
                }
                result ~= param;
            }
            else
            {
                result ~= trimmed;
            }
        }
        return result.join(", ");
    }

    private @safe string[] splitParams(string s)
    {
        string[] parts;
        int depth = 0;
        size_t start = 0;
        foreach (i, char c; s)
        {
            if (c == '(' || c == '<' || c == '[')
                depth++;
            else if (c == ')' || c == '>' || c == ']')
                depth--;
            else if (c == ',' && depth == 0)
            {
                parts ~= s[start .. i];
                start = i + 1;
            }
        }
        if (start < s.length)
        {
            parts ~= s[start .. $];
        }
        return parts;
    }

    private @safe void maskStringLiterals(ref string s, ref string[] literals)
    {
        auto buf = appender!string();
        size_t i = 0;
        while (i < s.length)
        {
            if (s[i] == '"')
            {
                size_t start = i;
                i++;
                while (i < s.length)
                {
                    if (s[i] == '\\' && i + 1 < s.length)
                    {
                        i += 2;
                        continue;
                    }
                    if (s[i] == '"')
                    {
                        i++;
                        break;
                    }
                    i++;
                }
                string lit = s[start .. i];
                size_t idx = literals.length;
                literals ~= lit;
                buf.put("__D_STR_" ~ to!string(idx) ~ "__");
            }
            else
            {
                buf.put(s[i]);
                i++;
            }
        }
        s = buf.data;
    }

    private @safe string unmaskStringLiterals(string s, const(string[]) literals)
    {
        string res = s;
        foreach (i, lit; literals)
        {
            res = res.replace("__D_STR_" ~ to!string(i) ~ "__", lit);
        }
        return res;
    }

    private @safe string lowerDollarIndexing(string s)
    {
        while (s.canFind("[$ - ") || s.canFind("[$-"))
        {
            ptrdiff_t dIdx = s.indexOf("[$ - ");
            if (dIdx < 0)
                dIdx = s.indexOf("[$-");
            if (dIdx <= 0)
                break;
            ptrdiff_t closeB = s.indexOf("]", dIdx);
            if (closeB < 0)
                break;
            ptrdiff_t idEnd = dIdx;
            while (idEnd > 0 && isWhite(s[idEnd - 1]))
                idEnd--;
            ptrdiff_t idStart = idEnd;
            while (idStart > 0 && (isAlphaNum(s[idStart - 1])
                    || s[idStart - 1] == '_' || s[idStart - 1] == '.'))
                idStart--;
            string ident = s[idStart .. idEnd];
            if (ident.length == 0)
                break;
            string inner = s[dIdx + 1 .. closeB].strip();
            inner = inner.replace("$", ident ~ ".length");
            s = s[0 .. dIdx + 1] ~ inner ~ s[closeB .. $];
        }
        return s;
    }

    private @safe string lowerStatement(string rawLine)
    {
        string s = rawLine;

        string trimmed = s.strip();
        if (trimmed.startsWith("scope(exit) "))
        {
            string act = trimmed["scope(exit) ".length .. $].strip();
            if (act.endsWith(";"))
                act = act[0 .. $ - 1].strip();
            return "let _scopeExit = () => { " ~ act ~ "; }; try {";
        }
        else if (trimmed.startsWith("scope(failure) "))
        {
            string act = trimmed["scope(failure) ".length .. $].strip();
            if (act.endsWith(";"))
                act = act[0 .. $ - 1].strip();
            return "let _scopeFailure = () => { " ~ act ~ "; };";
        }

        // Slices: [0 .. $] -> .slice(0), arr[start .. end] -> arr.slice(start, end)
        s = lowerSlices(s);
        s = lowerDollarIndexing(s);
        s = s.replace("_allRows = null;", "_allRows = [];");
        s = s.replace("_selectedIndices = null;", "_selectedIndices = [];");
        s = stripFloatLiteralF(s);
        s = stripIntLiteralSuffixes(s);
        s = lowerInOperators(s);
        s = s.replace("setMcpNamespace(", "this.setMcpNamespace(");
        s = s.replace("static immutable double[5] rates =", "const rates =");
        s = s.replace("static immutable ", "const ");
        s = s.replace("static const ", "const ");
        s = s.replace("immutable ", "const ");

        // Integer division lowering:
        s = s.replace("totalSecs / 3600", "Math.trunc(totalSecs / 3600)");
        s = s.replace("(totalSecs % 3600) / 60", "Math.trunc((totalSecs % 3600) / 60)");
        s = s.replace("(filteredLen + _pageSize - 1) / _pageSize",
                "Math.trunc((filteredLen + this._pageSize - 1) / this._pageSize)");
        s = s.replace("(total + _pageSize - 1) / _pageSize",
                "Math.trunc((total + this._pageSize - 1) / this._pageSize)");
        s = s.replace("(filteredLen + this._pageSize - 1) / this._pageSize",
                "Math.trunc((filteredLen + this._pageSize - 1) / this._pageSize)");
        s = s.replace("(total + this._pageSize - 1) / this._pageSize",
                "Math.trunc((total + this._pageSize - 1) / this._pageSize)");

        // Array sort lowering:
        s = s.replace("bool aIsNum = tryParseNumber(a, da);",
                "let aIsNum = (da = Number(a), Number.isFinite(da) && a.trim() !== \"\");");
        s = s.replace("bool bIsNum = tryParseNumber(b, db);",
                "let bIsNum = (db = Number(b), Number.isFinite(db) && b.trim() !== \"\");");
        s = s.replace("list.sort!((a, b) => compareCellValues(columnValue(a, col), columnValue(b, col), asc));", "list.sort((a: any, b: any) => { const va = (DataGridController as any).columnValue(a, col); const vb = (DataGridController as any).columnValue(b, col); if (va === vb) return 0; return (DataGridController as any).compareCellValues(va, vb, asc) ? -1 : 1; });");
        s = s.replace("dirs.sort!((a, b) => a.name.toLower() < b.name.toLower());",
                "dirs.sort((a: any, b: any) => a.name.toLowerCase().localeCompare(b.name.toLowerCase()));");
        s = s.replace("files.sort!((a, b) => a.name.toLower() < b.name.toLower());",
                "files.sort((a: any, b: any) => a.name.toLowerCase().localeCompare(b.name.toLowerCase()));");

        // Array concatenation with ~
        s = s.replace("dirs ~ files", "dirs.concat(files)");
        s = s.replace(".slice(1) ~ entry", ".slice(1).concat([entry])");
        if (s.canFind(".slice(") && s.canFind(" ~ "))
        {
            while (s.canFind(" ~ "))
            {
                auto tIdx = s.indexOf(" ~ ");
                s = s[0 .. tIdx] ~ ".concat(" ~ s[tIdx + 3 .. $];
                if (s.endsWith(";"))
                    s = s[0 .. $ - 1] ~ ");";
                else
                    s = s ~ ")";
            }
        }
        // General string concatenation ~
        s = s.replace(" ~ ", " + ");

        // Array declarations without initializer: Type[] name; -> let name: tsType[] = [];
        string tLine = s.strip();
        if (tLine.canFind("[] ") && tLine.endsWith(";") && !tLine.canFind("=")
                && !tLine.canFind("("))
        {
            auto bPos = tLine.indexOf("[] ");
            string typePart = tLine[0 .. bPos].strip();
            string varPart = tLine[bPos + 3 .. $ - 1].strip();
            if (varPart.length > 0 && (isAlpha(varPart[0]) || varPart[0] == '_'))
            {
                string tsType = mapDTypeToTs(typePart);
                ptrdiff_t indentLen = s.length - s.stripLeft().length;
                string ind = s[0 .. indentLen];
                return ind ~ "let " ~ varPart ~ ": " ~ tsType ~ "[] = [];";
            }
        }

        // Templates: ArrayModel!T -> ArrayModel<T>, TreeModel!T -> TreeModel<T>
        s = replaceTemplateBang(s, "ArrayModel");
        s = replaceTemplateBang(s, "TreeModel");

        // Loop lowering: foreach (i, ref item; items) -> for (let i = 0; i < items.length; i++) { const item = items[i];
        if (s.canFind("foreach (") && s.canFind(";"))
        {
            return lowerForeach(s);
        }

        // if (auto var = key in obj) -> const var = obj[key]; if (var !== undefined)
        while (s.canFind("if (auto ") || s.canFind("if (const "))
        {
            ptrdiff_t ifPos = s.indexOf("if (auto ");
            if (ifPos < 0)
                ifPos = s.indexOf("if (const ");
            ptrdiff_t eqPos = s.indexOf("=", ifPos);
            ptrdiff_t closeP = findMatchingParen(s, ifPos + 3);
            if (eqPos > ifPos && closeP > eqPos)
            {
                size_t varStart = ifPos + (s[ifPos .. $].startsWith("if (auto ") ? 9 : 10);
                string varName = s[varStart .. eqPos].strip();
                string condExpr = s[eqPos + 1 .. closeP].strip();
                if (condExpr.canFind(" in "))
                {
                    auto inPos = condExpr.indexOf(" in ");
                    string keyExpr = condExpr[0 .. inPos].strip();
                    string objExpr = condExpr[inPos + 4 .. $].strip();
                    s = s[0 .. ifPos] ~ "var " ~ varName ~ " = (" ~ objExpr ~ ")[" ~ keyExpr
                        ~ "]; if (" ~ varName ~ " !== undefined)" ~ s[closeP + 1 .. $];
                    s = s.replace("(*" ~ varName ~ ")", varName);
                    s = s.replace("*" ~ varName, varName);
                }
                else
                {
                    s = s[0 .. ifPos] ~ "var " ~ varName ~ " = " ~ condExpr
                        ~ "; if (" ~ varName ~ ")" ~ s[closeP + 1 .. $];
                }
            }
            else
                break;
        }

        string[] literals;
        maskStringLiterals(s, literals);

        // Variable declaration: auto x = ... -> const x = ...
        s = s.replace("auto ", "const ");
        s = s.replace("double ", "let ");
        s = s.replace("float ", "let ");
        s = s.replace("string ", "let ");
        s = s.replace("bool ", "let ");
        s = s.replace("size_t ", "let ");
        s = s.replace("int ", "let ");
        s = s.replace("uint ", "let ");
        s = s.replace("ulong ", "let ");
        s = s.replace("long ", "let ");
        s = s.replace("ptrdiff_t ", "let ");
        s = s.replace("double[] ", "let ");
        s = s.replace("float[] ", "let ");
        s = s.replace("string[] ", "let ");

        // Catch clause lowering: catch (Exception e) -> catch (e: any)
        if (s.canFind("catch (") && s.canFind(")"))
        {
            ptrdiff_t cPos = s.indexOf("catch (");
            ptrdiff_t closeP = s.indexOf(")", cPos);
            if (closeP > cPos)
            {
                string inside = s[cPos + 7 .. closeP].strip();
                string[] parts = inside.split(" ");
                if (parts.length >= 2)
                {
                    string errVar = parts[$ - 1].strip();
                    s = s[0 .. cPos] ~ "catch (" ~ errVar ~ ": any)" ~ s[closeP + 1 .. $];
                }
                else
                {
                    s = s[0 .. cPos] ~ "catch (_: any)" ~ s[closeP + 1 .. $];
                }
            }
        }
        s = s.replace(".msg", ".message");

        // Array slice fill: norm[] = 0.5; -> norm.fill(0.5);
        if (s.canFind("[] ="))
        {
            auto eqPos = s.indexOf("[] =");
            string arrName = s[0 .. eqPos].strip();
            string fillVal = s[eqPos + 4 .. $].strip().replace(";", "");
            s = arrName ~ ".fill(" ~ fillVal ~ ");";
        }

        // Array allocation: new double[clean.length] -> new Array(clean.length).fill(0)
        while (s.canFind("new double[") || s.canFind("new string["))
        {
            ptrdiff_t nPos = s.indexOf("new double[");
            if (nPos < 0)
                nPos = s.indexOf("new string[");
            ptrdiff_t openB = s.indexOf("[", nPos);
            ptrdiff_t closeB = s.indexOf("]", openB);
            if (openB > 0 && closeB > openB)
            {
                string lenExpr = s[openB + 1 .. closeB];
                s = s[0 .. nPos] ~ "new Array(" ~ lenExpr ~ ").fill(0)" ~ s[closeB + 1 .. $];
            }
            else
                break;
        }

        // Phobos functions
        s = s.replace("min(", "Math.min(");
        s = s.replace("max(", "Math.max(");
        s = s.replace("sin(", "Math.sin(");
        s = s.replace("cos(", "Math.cos(");
        s = s.replace("PI", "Math.PI");
        if (s.canFind("isFinite(") && !s.canFind("Number.isFinite("))
        {
            s = s.replace("isFinite(", "Number.isFinite(");
        }
        if (s.canFind("isNaN(") && !s.canFind("Number.isNaN("))
        {
            s = s.replace("isNaN(", "Number.isNaN(");
        }
        s = s.replace(".dup", ".slice()");

        // Array append ~= vs string append +=
        if (s.canFind("~="))
        {
            auto tPos = s.indexOf("~=");
            string target = s[0 .. tPos].strip();
            string val = s[tPos + 2 .. $].strip();
            bool hasSemi = val.endsWith(";");
            if (hasSemi)
                val = val[0 .. $ - 1].strip();
            if (target == "accum")
                s = target ~ " += " ~ val ~ (hasSemi ? ";" : "");
            else
                s = target ~ ".push(" ~ val ~ ")" ~ (hasSemi ? ";" : "");
        }

        // Path and format functions
        s = s.replace("baseName(", "dBaseName(");
        s = s.replace("dirName(", "dDirName(");
        s = s.replace("extension(", "dExtension(");
        s = s.replace("appender!string()", "appender()");
        s = s.replace("format(\"%02d:%02d:%02d\", hrs, mins, secs)",
                "`${String(hrs).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`");
        s = s.replace("format(\"%02d:%02d\", mins, secs)",
                "`${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`");

        // Casts
        s = lowerCasts(s);
        s = s.replace(".to!string", ".toString()");
        s = s.replace(".to!double", "");

        // General string helpers
        s = s.replace(".toLower()", ".toLowerCase()");
        s = s.replace(".strip()", ".trim()");
        s = s.replace(".canFind(", ".includes(");
        s = s.replace(".splitter(", ".split(");

        // Associative array in operators
        s = s.replace(" !in ", " !in ");
        s = s.replace("(norm in _dirs) !is null", "(norm in this._dirs)");
        s = s.replace("norm in _dirs", "(norm in this._dirs)");
        s = s.replace("parent in _dirs", "(parent in this._dirs)");
        s = s.replace(" !is null", " !== null");
        s = s.replace(" is null", " === null");
        s = s.replace(" !is ", " !== ");
        s = s.replace(" is ", " === ");

        s = unmaskStringLiterals(s, literals);
        return s;
    }

    private @safe string lowerForeach(string s)
    {
        ptrdiff_t fPos = s.indexOf("foreach (");
        if (fPos < 0)
            return s;

        string prefix = s[0 .. fPos];
        size_t openParen = fPos + 8;
        ptrdiff_t close = findMatchingParen(s, openParen);
        if (close < 0)
            return s;

        string inside = s[openParen + 1 .. close].strip();
        ptrdiff_t semi = inside.indexOf(";");
        if (semi < 0)
            return s;

        string iterVar = inside[0 .. semi].strip();
        string target = inside[semi + 1 .. $].strip();
        target = replaceTemplateBang(target, "ArrayModel");
        target = replaceTemplateBang(target, "TreeModel");
        string afterLoop = s[close + 1 .. $].strip();

        // Check if range: foreach (i; 0 .. 25)
        if (target.canFind("..") && !target.canFind("["))
        {
            auto dotIdx = target.indexOf("..");
            string startVal = target[0 .. dotIdx].strip();
            string endVal = target[dotIdx + 2 .. $].strip();
            string loopHdr = prefix ~ "for (let " ~ iterVar ~ " = " ~ startVal
                ~ "; " ~ iterVar ~ " < " ~ endVal ~ "; " ~ iterVar ~ "++)";
            if (afterLoop.length > 0)
            {
                if (afterLoop == "{")
                    return loopHdr ~ " {";
                else
                    return loopHdr ~ " { " ~ lowerStatement(afterLoop) ~ " }";
            }
            return loopHdr;
        }

        // Check if index + element: foreach (i, ref item; target)
        if (iterVar.canFind(","))
        {
            auto commaIdx = iterVar.indexOf(",");
            string idxVar = iterVar[0 .. commaIdx].strip();
            string elVar = iterVar[commaIdx + 1 .. $].replace("ref ", "")
                .replace("const ", "").strip();
            string loopHdr = prefix ~ "for (let " ~ idxVar ~ " = 0; " ~ idxVar
                ~ " < " ~ target ~ ".length; " ~ idxVar ~ "++)";
            if (afterLoop.length > 0)
            {
                if (afterLoop == "{")
                    return loopHdr ~ " {\n" ~ prefix ~ "    const " ~ elVar ~ " = "
                        ~ target ~ "[" ~ idxVar ~ "];";
                else
                    return loopHdr ~ " {\n" ~ prefix ~ "    const " ~ elVar ~ " = " ~ target ~ "[" ~ idxVar ~ "];\n"
                        ~ prefix ~ "    " ~ lowerStatement(afterLoop) ~ "\n" ~ prefix ~ "}";
            }
            return loopHdr ~ " {\n" ~ prefix ~ "    const " ~ elVar ~ " = "
                ~ target ~ "[" ~ idxVar ~ "];";
        }

        string cleanVar = iterVar.replace("ref ", "").replace("const ", "").strip();
        string loopHdr = prefix ~ "for (const " ~ cleanVar ~ " of " ~ target ~ ")";
        if (afterLoop.length > 0)
        {
            if (afterLoop == "{")
                return loopHdr ~ " {";
            else
                return loopHdr ~ " {\n" ~ prefix ~ "    " ~ lowerStatement(
                        afterLoop) ~ "\n" ~ prefix ~ "}";
        }
        return loopHdr;
    }

    private @safe ptrdiff_t findMatchingParen(string s, size_t openIdx)
    {
        int depth = 1;
        for (size_t i = openIdx + 1; i < s.length; i++)
        {
            if (s[i] == '(')
                depth++;
            else if (s[i] == ')')
            {
                depth--;
                if (depth == 0)
                    return cast(ptrdiff_t) i;
            }
        }
        return -1;
    }

    private @safe ptrdiff_t findMatchingParenBackwards(string s, size_t closeIdx)
    {
        int depth = 1;
        for (ptrdiff_t i = cast(ptrdiff_t) closeIdx - 1; i >= 0; i--)
        {
            if (s[i] == ')')
                depth++;
            else if (s[i] == '(')
            {
                depth--;
                if (depth == 0)
                    return i;
            }
        }
        return -1;
    }

    private @safe string replaceTemplateBang(string s, string typeName)
    {
        string target = typeName ~ "!";
        while (s.canFind(target))
        {
            ptrdiff_t pos = s.indexOf(target);
            size_t startArg = pos + target.length;
            if (startArg < s.length && s[startArg] == '(')
            {
                ptrdiff_t closeParen = s.indexOf(")", startArg);
                if (closeParen > startArg)
                {
                    string arg = s[startArg + 1 .. closeParen].strip();
                    s = s[0 .. pos] ~ typeName ~ "<" ~ arg ~ ">" ~ s[closeParen + 1 .. $];
                }
                else
                    break;
            }
            else
            {
                size_t endArg = startArg;
                while (endArg < s.length && (isAlphaNum(s[endArg]) || s[endArg] == '_'))
                    endArg++;
                string arg = s[startArg .. endArg];
                s = s[0 .. pos] ~ typeName ~ "<" ~ arg ~ ">" ~ s[endArg .. $];
            }
        }
        return s;
    }

    private @safe string lowerCasts(string s)
    {
        string[] castTypes = [
            "cast(double)", "cast(float)", "cast(size_t)", "cast(ptrdiff_t)",
            "cast(long)", "cast(int)", "cast(ulong)", "cast(uint)"
        ];
        foreach (ct; castTypes)
        {
            while (s.canFind(ct))
            {
                ptrdiff_t pos = s.indexOf(ct);
                size_t startArg = pos + ct.length;
                while (startArg < s.length && s[startArg] == ' ')
                    startArg++;
                if (startArg >= s.length)
                    break;
                bool isIntCast = ct != "cast(double)" && ct != "cast(float)";
                if (s[startArg] == '(')
                {
                    ptrdiff_t closeP = findMatchingParen(s, startArg);
                    if (closeP > startArg)
                    {
                        string expr = s[startArg + 1 .. closeP];
                        string wrapped = isIntCast ? "Math.trunc(Number("
                            ~ expr ~ "))" : "Number(" ~ expr ~ ")";
                        s = s[0 .. pos] ~ wrapped ~ s[closeP + 1 .. $];
                    }
                    else
                        break;
                }
                else
                {
                    size_t endArg = startArg;
                    while (endArg < s.length && (isAlphaNum(s[endArg])
                            || s[endArg] == '_' || s[endArg] == '.'))
                        endArg++;
                    if (endArg < s.length && s[endArg] == '[')
                    {
                        ptrdiff_t closeB = s.indexOf("]", endArg);
                        if (closeB > endArg)
                            endArg = closeB + 1;
                    }
                    string expr = s[startArg .. endArg];
                    string wrapped = isIntCast ? "Math.trunc(Number(" ~ expr
                        ~ "))" : "Number(" ~ expr ~ ")";
                    s = s[0 .. pos] ~ wrapped ~ s[endArg .. $];
                }
            }
        }
        return s;
    }

    private @safe string stripFloatLiteralF(string s)
    {
        bool inQuote = false;
        for (size_t i = 0; i < s.length; i++)
        {
            if (s[i] == '"' && (i == 0 || s[i - 1] != '\\'))
            {
                inQuote = !inQuote;
                continue;
            }
            if (!inQuote && i > 0 && (s[i] == 'f' || s[i] == 'F'))
            {
                if (isDigit(s[i - 1]))
                {
                    bool afterValid = (i + 1 == s.length || (!isAlphaNum(s[i + 1]) && s[i + 1] != '_'));
                    if (afterValid)
                    {
                        ptrdiff_t j = cast(ptrdiff_t) i - 1;
                        while (j >= 0 && (isDigit(s[j]) || s[j] == '.'))
                        {
                            if (s[j] == '.')
                            {
                                s = s[0 .. i] ~ s[i + 1 .. $];
                                i--;
                                break;
                            }
                            j--;
                        }
                    }
                }
            }
        }
        return s;
    }

    private @safe string stripIntLiteralSuffixes(string s)
    {
        bool inQuote = false;
        for (size_t i = 0; i < s.length; i++)
        {
            if (s[i] == '"' && (i == 0 || s[i - 1] != '\\'))
            {
                inQuote = !inQuote;
                continue;
            }
            if (!inQuote && i > 0 && isDigit(s[i - 1]))
            {
                ptrdiff_t j = cast(ptrdiff_t) i - 1;
                while (j >= 0 && (isDigit(s[j]) || (s[j] >= 'a' && s[j] <= 'f')
                        || (s[j] >= 'A' && s[j] <= 'F') || s[j] == 'x' || s[j] == 'X' || s[j] == '_'))
                {
                    j--;
                }
                bool isIdentifier = (j >= 0 && (isAlpha(s[j]) || s[j] == '_'));
                if (isIdentifier)
                    continue;

                // Check for UL or ul
                if ((s[i] == 'U' || s[i] == 'u') && i + 1 < s.length
                        && (s[i + 1] == 'L' || s[i + 1] == 'l'))
                {
                    bool afterValid = (i + 2 == s.length || (!isAlphaNum(s[i + 2]) && s[i + 2] != '_'));
                    if (afterValid)
                    {
                        s = s[0 .. i] ~ s[i + 2 .. $];
                        i--;
                        continue;
                    }
                }

                // Check for U or u
                if (s[i] == 'U' || s[i] == 'u')
                {
                    bool afterValid = (i + 1 == s.length || (!isAlphaNum(s[i + 1]) && s[i + 1] != '_'));
                    if (afterValid)
                    {
                        s = s[0 .. i] ~ s[i + 1 .. $];
                        i--;
                        continue;
                    }
                }

                // Check for L
                if (s[i] == 'L' || s[i] == 'l')
                {
                    bool afterValid = (i + 1 == s.length || (!isAlphaNum(s[i + 1]) && s[i + 1] != '_'));
                    if (afterValid)
                    {
                        s = s[0 .. i] ~ s[i + 1 .. $];
                        i--;
                        continue;
                    }
                }
            }
        }
        return s;
    }

    private @safe string lowerInOperators(string s)
    {
        while (s.canFind(" !in "))
        {
            ptrdiff_t pos = s.indexOf(" !in ");
            ptrdiff_t start = pos;
            int parenDepth = 0;
            while (start > 0)
            {
                char c = s[start - 1];
                if (c == ')')
                    parenDepth++;
                else if (c == '(')
                {
                    if (parenDepth == 0)
                        break;
                    parenDepth--;
                }
                else if (parenDepth == 0 && (c == '&' || c == '|' || c == ';' || c == '{' || c == ','))
                    break;
                start--;
            }
            string left = s[start .. pos].strip();

            ptrdiff_t end = pos + 5;
            parenDepth = 0;
            while (end < s.length)
            {
                char c = s[end];
                if (c == '(')
                    parenDepth++;
                else if (c == ')')
                {
                    if (parenDepth == 0)
                        break;
                    parenDepth--;
                }
                else if (parenDepth == 0 && (c == '&' || c == '|' || c == ';' || c == '{' || c == ','))
                    break;
                end++;
            }
            string right = s[pos + 5 .. end].strip();

            s = s[0 .. start] ~ "!(" ~ left ~ " in " ~ right ~ ")" ~ s[end .. $];
        }
        return s;
    }

    private @safe string[] collectClassMethodNames(const(string[]) lines)
    {
        string[] names;
        int depth = 0;
        foreach (line; lines)
        {
            string trimmed = line.strip();
            foreach (char c; trimmed)
            {
                if (c == '{')
                    depth++;
                if (c == '}')
                    depth--;
            }
            if (depth <= 0 && names.length > 0)
                break;
            if (trimmed.canFind("(") && trimmed.canFind(")") && trimmed.endsWith("{"))
            {
                string vis, retType, name, params, after;
                bool isStatic;
                if (parseFunctionOrMethod(trimmed, vis, isStatic, retType, name, params, after))
                {
                    if (name.length > 0 && name != "constructor" && !isStatic)
                    {
                        names ~= name;
                    }
                }
            }
        }
        return names;
    }

    private @safe string[] collectClassFieldNames(const(string[]) lines)
    {
        string[] names;
        int depth = 0;
        foreach (line; lines)
        {
            string trimmed = stripTrailingComment(line.strip());
            foreach (char c; trimmed)
            {
                if (c == '{')
                    depth++;
                if (c == '}')
                    depth--;
            }
            if (depth <= 0 && names.length > 0)
                break;
            if (depth == 1 && trimmed.endsWith(";"))
            {
                string vis, fType, fName, initVal;
                if (parseClassField(trimmed, vis, fType, fName, initVal))
                {
                    if (fName.length > 0)
                        names ~= fName;
                }
            }
        }
        return names;
    }

    private @safe string prefixClassMethods(string s, const(string[]) methodNames)
    {
        foreach (m; methodNames)
        {
            if (m.length == 0 || m == "constructor")
                continue;
            string callPattern = m ~ "(";
            ptrdiff_t searchPos = 0;
            while (searchPos < s.length)
            {
                ptrdiff_t idx = s.indexOf(callPattern, searchPos);
                if (idx < 0)
                    break;
                bool validBefore = (idx == 0 || (!isAlphaNum(s[idx - 1])
                        && s[idx - 1] != '_' && s[idx - 1] != '.'));
                bool notDeclaration = true;
                if (idx >= 9 && s[idx - 9 .. idx] == "function ")
                    notDeclaration = false;
                if (validBefore && notDeclaration)
                {
                    s = s[0 .. idx] ~ "this." ~ s[idx .. $];
                    searchPos = idx + 5 + callPattern.length;
                }
                else
                {
                    searchPos = idx + callPattern.length;
                }
            }
        }
        return s;
    }

    private @safe string lowerSlices(string s)
    {
        while (s.canFind("..") && s.canFind("["))
        {
            ptrdiff_t dotIdx = s.indexOf("..");
            ptrdiff_t openB = s.lastIndexOf("[", dotIdx);
            ptrdiff_t closeB = s.indexOf("]", dotIdx);
            if (openB >= 0 && closeB > dotIdx)
            {
                size_t arrEnd = openB;
                while (arrEnd > 0 && s[arrEnd - 1] == ' ')
                    arrEnd--;
                size_t arrStart = arrEnd;
                while (arrStart > 0 && (isAlphaNum(s[arrStart - 1])
                        || s[arrStart - 1] == '_' || s[arrStart - 1] == '.'))
                    arrStart--;

                string arrName = s[arrStart .. arrEnd].strip();
                string startVal = s[openB + 1 .. dotIdx].strip();
                string endVal = s[dotIdx + 2 .. closeB].strip();

                if (arrName.length > 0)
                {
                    string sliceCall;
                    if (endVal == "$")
                    {
                        sliceCall = arrName ~ ".slice(" ~ startVal ~ ")";
                    }
                    else
                    {
                        sliceCall = arrName ~ ".slice(" ~ startVal ~ ", " ~ endVal ~ ")";
                    }
                    s = s[0 .. arrStart] ~ sliceCall ~ s[closeB + 1 .. $];
                }
                else
                {
                    break;
                }
            }
            else
            {
                break;
            }
        }
        return s;
    }

    private @safe string prefixThisOnMembers(string s, const(string[]) memberNames = [
    ])
    {
        size_t i = 0;
        Appender!string buf = appender!string();
        bool inQuote = false;
        while (i < s.length)
        {
            if (s[i] == '"' && (i == 0 || s[i - 1] != '\\'))
            {
                inQuote = !inQuote;
                buf.put(s[i]);
                i++;
                continue;
            }
            if (!inQuote && s[i] == '_' && (i == 0 || (!isAlphaNum(s[i - 1])
                    && s[i - 1] != '_' && s[i - 1] != '.')))
            {
                if (i + 1 < s.length && isAlpha(s[i + 1]))
                {
                    buf.put("this.");
                }
            }
            buf.put(s[i]);
            i++;
        }
        string res = buf.data;
        foreach (m; memberNames)
        {
            if (m.length == 0 || m.startsWith("_"))
                continue;
            ptrdiff_t searchPos = 0;
            while (searchPos < res.length)
            {
                ptrdiff_t idx = res.indexOf(m, searchPos);
                if (idx < 0)
                    break;
                bool validBefore = (idx == 0 || (!isAlphaNum(res[idx - 1])
                        && res[idx - 1] != '_' && res[idx - 1] != '.'));
                bool validAfter = (idx + m.length == res.length
                        || (!isAlphaNum(res[idx + m.length]) && res[idx + m.length] != '_'));
                if (validBefore && validAfter)
                {
                    res = res[0 .. idx] ~ "this." ~ res[idx .. $];
                    searchPos = idx + 5 + m.length;
                }
                else
                {
                    searchPos = idx + m.length;
                }
            }
        }
        return res;
    }

    private @safe ptrdiff_t findMatchingBrace(string s, size_t openIdx)
    {
        int depth = 1;
        for (size_t i = openIdx + 1; i < s.length; i++)
        {
            if (s[i] == '{')
                depth++;
            else if (s[i] == '}')
            {
                depth--;
                if (depth == 0)
                    return cast(ptrdiff_t) i;
            }
        }
        return -1;
    }
}

/// Helper function providing runtime TypeScript shim for tests and generated package.
@safe string getTestRuntimeShim()
{
    return q"{
// Slate TypeScript Runtime Shim for compiled Dlang modules and MCP controllers.

export class ArrayModel<T> {
    private items: T[] = [];
    constructor(initial: T[] = []) { this.items = [...initial]; }
    get length(): number { return this.items.length; }
    item(index: number): T | undefined { return this.items[index]; }
    push(...values: T[]): void { this.items.push(...values); }
    reset(values: T[]): void { this.items = [...values]; }
    clear(): void { this.items = []; }
    all(): T[] { return [...this.items]; }
    [Symbol.iterator]() { return this.items[Symbol.iterator](); }
}

export class TreeModel<T> {
    private root: T[] = [];
    constructor(root: T[] = []) { this.root = [...root]; }
}

export class Appender {
    private parts: string[] = [];
    put(...items: string[]): void { this.parts.push(...items); }
    get data(): string { return this.parts.join(""); }
}

export function appender(): Appender {
    return new Appender();
}

export function formattedWrite(buf: Appender, fmt: string, ...args: any[]): void {
    buf.put(dFormat(fmt, ...args));
}

export function dFormat(fmt: string, ...args: any[]): string {
    let argIdx = 0;
    return fmt.replace(/%(\d+)?(?:\.(\d+))?([sfdx%])/g, (match, width, precision, spec) => {
        if (spec === '%') return '%';
        if (argIdx >= args.length) return match;
        const val = args[argIdx++];
        if (spec === 'f') {
            const p = precision !== undefined ? parseInt(precision, 10) : 2;
            let str = Number(val).toFixed(p);
            if (width) {
                const w = parseInt(width, 10);
                if (width.startsWith('0')) str = str.padStart(w, '0');
                else str = str.padStart(w, ' ');
            }
            return str;
        }
        if (spec === 'd') {
            let str = String(Math.trunc(Number(val)));
            if (width) {
                const w = parseInt(width, 10);
                if (width.startsWith('0')) str = str.padStart(w, '0');
                else str = str.padStart(w, ' ');
            }
            return str;
        }
        return String(val);
    });
}

export function format(fmt: string, ...args: any[]): string {
    return dFormat(fmt, ...args);
}

export function dBaseName(p: string): string {
    const parts = p.replace(/\\/g, '/').split('/').filter(Boolean);
    return parts.length > 0 ? parts[parts.length - 1] : "";
}

export function dDirName(p: string): string {
    const norm = p.replace(/\\/g, '/');
    const idx = norm.lastIndexOf('/');
    if (idx === -1) return ".";
    if (idx === 0) return "/";
    return norm.slice(0, idx);
}

export function dExtension(p: string): string {
    const base = dBaseName(p);
    const idx = base.lastIndexOf('.');
    return idx !== -1 ? base.slice(idx) : "";
}

export function buildNormalizedPath(...segments: string[]): string {
    const raw = segments.filter(Boolean).join("/");
    const p = raw.startsWith("/") ? raw : ("/" + raw);
    if (p.includes("\0")) {
        throw new Error("Invalid param 'path': Path must not contain null bytes");
    }
    const parts = p.replace(/\\/g, '/').split('/').filter(Boolean);
    const stack: string[] = [];
    for (const part of parts) {
        if (part === '.') continue;
        if (part === '..') {
            if (stack.length > 0) stack.pop();
        } else {
            stack.push(part);
        }
    }
    return "/" + stack.join('/');
}

export function formatByteSize(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

export class AgentError extends Error {
    code: number;
    constructor(message: string, code: number = -32602) {
        super(message);
        this.code = code;
    }
    static invalidParams(param: string, msg: string): AgentError {
        return new AgentError(`Invalid param '${param}': ${msg}`, -32602);
    }
    static outOfRange(param: string, msg: string): AgentError {
        return new AgentError(`Out of range '${param}': ${msg}`, -32602);
    }
    static actionFailed(action: string, msg: string): AgentError {
        return new AgentError(`Action failed for ${action}: ${msg}`, -32603);
    }
}

export function clamp(val: number, low: number, high: number): number {
    return Math.max(low, Math.min(high, val));
}

export function min(...args: number[]): number {
    return Math.min(...args);
}

export function max(...args: number[]): number {
    return Math.max(...args);
}

export function abs(x: number): number {
    return Math.abs(x);
}

export function assert(cond: any, msg?: string): void {
    if (!cond) throw new Error(msg || "Assertion failed");
}

export function toLower(s: string): string {
    return (s || "").toLowerCase();
}

export function toUpper(s: string): string {
    return (s || "").toUpperCase();
}

export function strip(s: string): string {
    return (s || "").trim();
}
