{
    "name": "slate",
    "description": "Slate: declarative desktop UI framework on Slint, in DLang. Ports slate-rust against slint-d across layered sub-packages.",
    "authors": ["Slate Contributors"],
    "license": "MIT",
    "homepage": "https://github.com/slate-framework/slate",
    "targetType": "library",
    "sourcePaths": ["source"],
    "importPaths": ["source"],
    "targetName": "slate",
    "subPackages": [
        "./packages/core",
        "./packages/net",
        "./packages/mcp",
        "./packages/ui"
    ],
    "dependencies": {
        "slate:core": "*",
        "slate:net": "*",
        "slate:mcp": "*",
        "slate:ui": "*",
        "slint-d": {"path": "../slint-d"}
    },
    "libs": ["curl", "ssl", "crypto"],
    "lflags-posix": ["-L/home/developer/.local/lib", "-Llib", "-L/usr/local/lib"],
    "systemDependencies": "Requires libcurl >= 8.6 (pkg-config libcurl) with nghttp2 for HTTP/2 and ngtcp2+nghttp3 or OpenSSL 3.2+ for HTTP/3",
    "configurations": [
        {
            "name": "library",
            "targetType": "library"
        },
        {
            "name": "native",
            "targetType": "library",
            "versions": ["SlintNative"],
            "subConfigurations": {
                "slate:ui": "native",
                "slint-d": "native"
            }
        },
        {
            "name": "h3",
            "targetType": "library",
            "versions": ["HaveCurlHttp3"],
            "subConfigurations": {
                "slate:net": "h3"
            }
        },
        {
            "name": "integration",
            "targetType": "library",
            "versions": ["IntegrationTest"],
            "subConfigurations": {
                "slate:net": "integration"
            }
        },
        {
            "name": "debug-http",
            "targetType": "library",
            "versions": ["SlateHttpDebug"],
            "subConfigurations": {
                "slate:net": "debug-http"
            }
        },
        {
            "name": "durl",
            "targetType": "executable",
            "targetName": "durl",
            "targetPath": "bin",
            "mainSourceFile": "packages/net/source/slate/bin/durl.d",
            "versions": ["SlateHttpDebug"]
        }
    ],
    "buildTypes": {
        "unittest": {
            "buildOptions": ["unittests", "debugMode", "debugInfo"]
        }
    }
}
