# Backend environment variables — copy to .env and fill in values.
# All variables here can also be set directly in the environment.

# Application
# APP_NAME=Fullstack Template API
# APP_VERSION=0.1.0
# APP_ENV=dev          # dev | test | staging | prod
# DEBUG=true

# Database
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fullstack_template
# DATABASE_ECHO=false
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# MongoDB (alternative, requires optional-deps "mongodb")
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DB_NAME=fullstack_template

# CORS
# CORS_ORIGINS='["http://localhost:5173"]'

# OpenTelemetry
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=fullstack-template
# OTEL_EXPORTER_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_PROTOCOL=grpc

# Logging
# LOG_LEVEL=INFO       # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=json       # json | text
