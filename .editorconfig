root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,json,yml,yaml,css,html,md}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{d,slint,rs}]
indent_style = space
indent_size = 4

[*.d]
brace_style = otbs
max_line_length = 120
soft_max_line_length = 100
keep_line_breaks = true

[Makefile]
indent_style = tab
