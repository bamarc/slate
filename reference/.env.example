# Example environment file. Copy to `.env` and edit. Never commit `.env`.

# ── Application ─────────────────────────────────────────────
COMPOSE_PROJECT_NAME=${{ values.projectName }}
APP_ENV=dev
DEBUG=false

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=${{ values.projectName | replace('-', '_') }}
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/${{ values.projectName | replace('-', '_') }}

# ── CORS (JSON array string) ────────────────────────────────
CORS_ORIGINS='["http://localhost", "http://localhost:5173"]'

# ── OpenTelemetry ───────────────────────────────────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME=${{ values.projectName }}
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Auth (OAuth2 / OIDC) ────────────────────────────────────
# Turn off to allow anonymous access (dev only). When false, an "anonymous"
# principal with no roles is returned; routes guarded by require_role will 403.
AUTH_REQUIRED=false

# One of: dev | oidc | entra | keycloak | gcloud
AUTH_PROVIDER=dev

# Generic OIDC settings (used by oidc/entra/keycloak/gcloud overrides):
AUTH_AUDIENCE=
AUTH_ISSUER=
AUTH_JWKS_URL=
AUTH_ALGORITHMS='["RS256"]'
AUTH_ROLES_CLAIM=roles

# Optional IdP-role → template-role translation table. JSON object.
# Example: {"Admins":"admin","BasicUsers":"user"}
AUTH_ROLE_MAPPING={}

# Microsoft Entra ID
AUTH_TENANT_ID=

# Keycloak (base URL of the server + realm)
AUTH_KEYCLOAK_URL=
AUTH_KEYCLOAK_REALM=

# Google Cloud Identity Platform / Firebase Auth
AUTH_GCLOUD_PROJECT_ID=

# ── Frontend (Vite) ─────────────────────────────────────────
# Picked up by Vite at build time. Must be prefixed with VITE_ to be exposed.
# Leave empty when served via the compose nginx reverse proxy (it forwards /api
# to the backend). Set to an absolute URL only for standalone Vite dev server.
VITE_API_BASE_URL=
# Dev-only — bearer token used when AUTH_PROVIDER=dev. Format: <sub>:<role>[,<role>...]
VITE_DEV_AUTH_TOKEN=alice:admin

# ── Compose (local stack) ───────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=8080
POSTGRES_PORT=5433
JAEGER_UI_PORT=16686
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
