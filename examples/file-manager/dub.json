{
    "name": "file-manager",
    "description": "Slate example: tabbed dual-pane file manager (tree + location 1 + location 2, single-window drag-and-drop).",
    "license": "MIT",
    "targetType": "executable",
    "mainSourceFile": "source/main.d",
    "sourcePaths": ["source"],
    "importPaths": ["source"],
    "dependencies": {
        "slint-d": {"path": "../../slint-d"},
        "slate": {"path": "../../slate-dlang"}
    },
    "lflags-posix": ["-L../../slate-dlang/lib"],
    "configurations": [
        {
            "name": "application"
        },
        {
            "name": "native",
            "targetType": "executable",
            "subConfigurations": {
                "slate": "native",
                "slint-d": "native"
            }
        }
    ],
    "buildTypes": {
        "unittest": {
            "buildOptions": ["unittests", "debugMode", "debugInfo"]
        }
    }
}
