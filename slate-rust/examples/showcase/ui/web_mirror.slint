import {
    SlateTheme,
    SlateButton,
    SlateButtonVariant,
    SlateButtonSize,
    SlateBadge,
    SlateInput,
    SlateTextArea,
    SlateSwitch,
    SlateCheckbox,
    SlateRadio,
    SlateSlider,
    SlateSegmentedControl,
    SlateMetricCard,
    SlateTable,
    SlateTableRow,
    SlateAlert,
    SlateProgressBar,
    SlateSkeleton,
    SlateTabs,
    SlateAvatar,
    SlateAccordion,
    SlateModal,
    SlateToastHost,
    SlateToastVariant,
    SlatePagination,
    SlateMenubar,
    SlateMenu,
    SlateDrawer,
    SlateWebAppLayout,
    SlateWebCard,
    SlateStatusPage
} from "../../ui/index.slint";
import { DashboardPage, AdminPage } from "pages.slint";
import { ShowcaseGroupLabel, ShowcaseValueRow, ShowcasePerson } from "sections.slint";

export { SlateTheme }

export component WebMirrorWindow inherits Window {
    title: "Fullstack Template — Component Showcase (Web Mirror)";
    min-width: 1040px;
    min-height: 720px;
    preferred-width: 1160px;
    preferred-height: 820px;
    background: SlateTheme.background;
    default-font-family: SlateTheme.font-family;

    // Callbacks to Rust
    callback start-compute();
    callback cancel-compute();
    callback toggle-theme();
    // Index of the clicked user menu entry (0 profile, 1 settings, 2 theme, 3 sign out)
    callback user-menu-selected(int);

    // Navigation and state
    // Top-nav page: 0 = Dashboard, 1 = Admin, 2 = Komponenten (tabbed showcase)
    in-out property <int> active-nav: 2;
    in-out property <bool> user-menu-open: false;
    in-out property <int> active-tab: 0;
    in-out property <bool> modal-open: false;
    in-out property <bool> drawer-open: false;
    in-out property <int> demo-page: 3;
    in-out property <bool> demo-drawer-notify: true;
    in-out property <string> demo-drawer-name: "Alice Müller";
    out property <int> demo-page-first: (root.demo-page - 1) * 8 + 1;
    out property <int> demo-page-last: Math.min(root.demo-page * 8, 78);

    // Fires one toast of each of three variants (used by the render pipeline and demos).
    public function show-demo-toasts() {
        toast-host.show("Changes saved", "Your settings were stored successfully.", SlateToastVariant.success);
        toast-host.show("Sync failed", "Could not reach the database replica.", SlateToastVariant.error);
        toast-host.show("Heads up", "API key expires in 3 days.", SlateToastVariant.warning);
    }

    property <[SlateMenu]> demo-menus: [
        { title: "File", items: [
            { label: "New", shortcut: "Ctrl+N" },
            { label: "Open", shortcut: "Ctrl+O" },
            { label: "Save", shortcut: "Ctrl+S" },
            { separator: true },
            { label: "Exit", shortcut: "Ctrl+Q" },
        ] },
        { title: "Edit", items: [
            { label: "Undo", shortcut: "Ctrl+Z" },
            { label: "Redo", shortcut: "Ctrl+Shift+Z" },
            { separator: true },
            { label: "Cut", shortcut: "Ctrl+X" },
            { label: "Copy", shortcut: "Ctrl+C" },
            { label: "Paste", shortcut: "Ctrl+V" },
        ] },
        { title: "View", items: [
            { label: "Zoom In", shortcut: "Ctrl++" },
            { label: "Zoom Out", shortcut: "Ctrl+-" },
            { separator: true },
            { label: "Toggle Sidebar", shortcut: "Ctrl+B" },
        ] },
        { title: "Help", items: [
            { label: "Docs" },
            { label: "About" },
        ] },
    ];

    // Interactive Demo Properties
    in-out property <string> demo-input-text: "dev@slate.internal";
    in-out property <string> demo-textarea-text: "Declarative, high-performance UI components powered by Slint and Rust.";
    in-out property <bool> demo-switch-1: true;
    in-out property <bool> demo-switch-2: false;
    in-out property <bool> demo-check-1: true;
    in-out property <bool> demo-check-2: false;
    in-out property <bool> demo-check-3: true;
    in-out property <int> demo-radio-selection: 0;
    in-out property <float> demo-slider-val: 68.0;
    in-out property <int> demo-segmented-idx: 1;

    // Async Compute State
    in property <bool> compute-running: false;
    in property <float> compute-progress: 0.0;
    in property <string> compute-status: "Ready for task execution";
    in property <string> compute-result: "No active calculation";

    layout := SlateWebAppLayout {
        active-tab <=> root.active-tab;
        active-nav <=> root.active-nav;
        user-menu-open <=> root.user-menu-open;
        page-title: root.active-nav == 0 ? "Dashboard" : root.active-nav == 1 ? "Admin" : "Component Showcase";
        page-badge: root.active-nav == 2 ? "44+ components" : "";
        toggle-design => { root.toggle-theme(); }
        user-menu-selected(idx) => { root.user-menu-selected(idx); }

        if root.active-nav == 0 : DashboardPage { vertical-stretch: 1; }
        if root.active-nav == 1 : AdminPage { vertical-stretch: 1; }

        // Content Area inside Flickable for smooth vertical scrolling
        if root.active-nav == 2 : Flickable {
            vertical-stretch: 1;
            content-height: content-column.preferred-height + 48px;

            content-column := VerticalLayout {
                spacing: SlateTheme.spacing-lg;
                padding-bottom: SlateTheme.spacing-xl;

                // ==========================================
                // TAB 0: BUTTONS & BADGES
                // ==========================================
                if root.active-tab == 0 : VerticalLayout {
                    spacing: SlateTheme.spacing-lg;

                    SlateWebCard {
                        title: "Button Variants";
                        description: "6 variants: default, secondary, destructive, outline, ghost, link";

                        HorizontalLayout {
                            spacing: SlateTheme.spacing-md;
                            alignment: start;

                            SlateButton { text: "Default"; variant: SlateButtonVariant.primary; }
                            SlateButton { text: "Secondary"; variant: SlateButtonVariant.secondary; }
                            SlateButton { text: "Destructive"; variant: SlateButtonVariant.destructive; }
                            SlateButton { text: "Outline"; variant: SlateButtonVariant.outline; }
                            SlateButton { text: "Ghost"; variant: SlateButtonVariant.ghost; }
                            SlateButton { text: "Link"; variant: SlateButtonVariant.link; }
                        }
                    }

                    SlateWebCard {
                        title: "Button Sizes";
                        description: "4 sizes: sm, default, lg, icon";

                        HorizontalLayout {
                            spacing: SlateTheme.spacing-md;
                            alignment: start;

                            SlateButton { text: "Small"; variant: SlateButtonVariant.secondary; size: SlateButtonSize.sm; }
                            SlateButton { text: "Default"; variant: SlateButtonVariant.primary; size: SlateButtonSize.md; }
                            SlateButton { text: "Large"; variant: SlateButtonVariant.secondary; size: SlateButtonSize.lg; }
                            SlateButton { text: "+"; variant: SlateButtonVariant.outline; size: SlateButtonSize.md; }
                        }
                    }

                    SlateWebCard {
                        title: "Button with Icon & Loading";
                        description: "Buttons with prefix icons and interactive loading spinner indicators";

                        HorizontalLayout {
                            spacing: SlateTheme.spacing-md;
                            alignment: start;

                            SlateButton { text: "Email"; variant: SlateButtonVariant.primary; }
                            SlateButton { text: "Search"; variant: SlateButtonVariant.secondary; }
                            SlateButton { text: "Save Changes"; variant: SlateButtonVariant.success; }
                            SlateButton { text: "Loading..."; variant: SlateButtonVariant.primary; loading: true; }
                            SlateButton { text: "Disabled"; variant: SlateButtonVariant.secondary; enabled: false; }
                        }
                    }

                    SlateWebCard {
                        title: "Badge";
                        description: "4 variants: default, secondary, destructive, outline";

                        HorizontalLayout {
                            spacing: SlateTheme.spacing-md;
                            alignment: start;

                            SlateBadge { text: "Default"; variant: "default"; }
                            SlateBadge { text: "Secondary"; variant: "secondary"; }
                            SlateBadge { text: "Destructive"; variant: "destructive"; }
                            SlateBadge { text: "Outline"; variant: "outline"; }
                            SlateBadge { text: "Success"; variant: "success"; }
                            SlateBadge { text: "Warning"; variant: "warning"; }
                        }
                    }

                    SlateWebCard {
                        title: "Toggle & Segmented Control";
                        description: "Single & multi-state toggle groups for filters and view switching";

                        VerticalLayout {
                            spacing: SlateTheme.spacing-md;

                            HorizontalLayout {
                                spacing: SlateTheme.spacing-sm;
                                alignment: start;

                                SlateButton { text: "B"; variant: SlateButtonVariant.primary; size: SlateButtonSize.sm; }
                                SlateButton { text: "I"; variant: SlateButtonVariant.secondary; size: SlateButtonSize.sm; }
                                SlateButton { text: "U"; variant: SlateButtonVariant.secondary; size: SlateButtonSize.sm; }
                            }

                            SlateSegmentedControl {
                                options: ["Daily", "Weekly", "Monthly", "Quarterly"];
                                selected-index <=> root.demo-segmented-idx;
                            }
                        }
                    }
                }

                // ==========================================
                // TAB 1: FORMS & INPUTS
                // ==========================================
                if root.active-tab == 1 : VerticalLayout {
                    spacing: SlateTheme.spacing-lg;

                    SlateWebCard {
                        title: "Input + Textarea + Label";
                        description: "Standard text fields, labels, placeholders, and multiline editors";

                        VerticalLayout {
                            spacing: SlateTheme.spacing-md;

                            SlateInput {
                                label: "Email Address";
                                placeholder: "name@example.com";
                                text <=> root.demo-input-text;
                            }

                            SlateTextArea {
                                label: "Message";
                                placeholder: "Type your message...";
                                text <=> root.demo-textarea-text;
                            }
                        }
                    }

                    SlateWebCard {
                        title: "Select + Checkbox + Switch + Radio Group";
                        description: "Toggles, checkboxes, switch pills, and radio option sets";

                        VerticalLayout {
                            spacing: SlateTheme.spacing-md;

                            HorizontalLayout {
                                spacing: SlateTheme.spacing-xl;
                                alignment: start;

                                VerticalLayout {
                                    spacing: SlateTheme.spacing-sm;
                                    alignment: start;

                                    ShowcaseGroupLabel { text: "Checkboxes"; }

                                    SlateCheckbox { text: "Accept terms and conditions"; checked <=> root.demo-check-1; }
                                    SlateCheckbox { text: "Subscribe to security advisories"; checked <=> root.demo-check-2; }
                                    SlateCheckbox { text: "Enable automatic cloud sync"; checked <=> root.demo-check-3; }
                                }

                                VerticalLayout {
                                    spacing: SlateTheme.spacing-sm;
                                    alignment: start;

                                    ShowcaseGroupLabel { text: "Switches"; }

                                    SlateSwitch { text: "High Performance Mode"; checked <=> root.demo-switch-1; }
                                    SlateSwitch { text: "Hardware Acceleration"; checked <=> root.demo-switch-2; }
                                }

                                VerticalLayout {
                                    spacing: SlateTheme.spacing-sm;
                                    alignment: start;

                                    ShowcaseGroupLabel { text: "Radio Group"; }

                                    SlateRadio { text: "Default layout"; selected: root.demo-radio-selection == 0; toggled => { root.demo-radio-selection = 0; } }
                                    SlateRadio { text: "Comfortable layout"; selected: root.demo-radio-selection == 1; toggled => { root.demo-radio-selection = 1; } }
                                    SlateRadio { text: "Compact layout"; selected: root.demo-radio-selection == 2; toggled => { root.demo-radio-selection = 2; } }
                                }
                            }
                        }
                    }

                    SlateWebCard {
                        title: "Continuous Slider";
                        description: "Draggable slider track with live value readout";

                        VerticalLayout {
                            spacing: SlateTheme.spacing-sm;

                            ShowcaseValueRow { label: "Volume / Intensity"; value: Math.round(root.demo-slider-val) + "%"; }

                            SlateSlider {
                                minimum: 0.0;
                                maximum: 100.0;
                                value <=> root.demo-slider-val;
                            }
                        }
                    }

                    SlateWebCard {
                        title: "Input OTP (6 Digits)";
                        description: "One-time password verification code cells";

                        HorizontalLayout {
                            spacing: SlateTheme.spacing-sm;
                            alignment: start;

                            for digit in ["4", "8", "2", "9", "1", "5"] : Rectangle {
                                width: 44px;
                                height: 48px;
                                border-radius: SlateTheme.radius-md;
                                border-width: 1px;
                                border-color: SlateTheme.border-subtle;
                                background: SlateTheme.surface-2;

                                Text {
                                    text: digit;
                                    font-size: SlateTheme.font-lg;
                                    font-weight: 700;
                                    color: SlateTheme.text-primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ==========================================
                // TAB 2: DATA DISPLAY
                // ==========================================
                if root.active-tab == 2 : VerticalLayout {
                    spacing: SlateTheme.spacing-lg;

                    SlateWebCard {
                        title: "Card + Avatar + Separator";
                        description: "Identity components with avatars, presence status dots, and pill tags";

                        HorizontalLayout {
                            spacing: SlateTheme.spacing-xl;
                            alignment: start;

                            ShowcasePerson { initials: "AL"; status: "online"; name: "Alice Müller"; email: "alice@example.com"; role: "Admin"; role-variant: "default"; }

                            // Vertical divider line
                            Rectangle { width: 1px; height: 36px; background: SlateTheme.border-subtle; }

                            ShowcasePerson { initials: "BS"; status: "busy"; name: "Bob Schmidt"; email: "bob@example.com"; role: "Editor"; role-variant: "secondary"; }
                        }
                    }

                    SlateWebCard {
                        title: "Table (Standalone)";
                        description: "Data grid with header row, alternating row backgrounds, and status badges";

                        SlateTable {
                            columns: ["Name", "Email", "Status", "Role"];
                            rows: [
                                { id: "1", name: "Alice Müller", category: "alice@example.com", status: "Active", status-variant: "default", value: "Admin" },
                                { id: "2", name: "Bob Schmidt", category: "bob@example.com", status: "Syncing", status-variant: "secondary", value: "Editor" },
                                { id: "3", name: "Carol Weber", category: "carol@example.com", status: "Warning", status-variant: "warning", value: "Viewer" },
                                { id: "4", name: "David Fischer", category: "david@example.com", status: "Deprecated", status-variant: "destructive", value: "Editor" }
                            ];
                        }
                    }

                    SlateWebCard {
                        title: "Accordion & Collapsible";
                        description: "Expandable sections with state chevrons and animated body reveal";

                        VerticalLayout {
                            spacing: SlateTheme.spacing-sm;

                            SlateAccordion {
                                title: "What is the Slate desktop framework?";
                                expanded: true;

                                Text {
                                    text: "Slate is a high-performance desktop framework combining Rust for heavy background compute with Slint for beautiful, native Linux UI integration.";
                                    font-size: SlateTheme.font-sm;
                                    color: SlateTheme.text-secondary;
                                    wrap: word-wrap;
                                }
                            }

                            SlateAccordion {
                                title: "Is it production-ready?";
                                expanded: false;

                                Text {
                                    text: "Yes. It includes unit tests, headless render verification, dark/light theme tokens, and asynchronous background worker integration.";
                                    font-size: SlateTheme.font-sm;
                                    color: SlateTheme.text-secondary;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // ==========================================
                // TAB 3: FEEDBACK
                // ==========================================
                if root.active-tab == 3 : VerticalLayout {
                    spacing: SlateTheme.spacing-lg;

                    SlateWebCard {
                        title: "Alert Variants";
                        description: "4 variants: default, destructive, success, info";

                        VerticalLayout {
                            spacing: SlateTheme.spacing-sm;

                            SlateAlert {
                                variant: "info";
                                title: "Note";
                                message: "System update scheduled tonight at 02:00 UTC. No downtime expected.";
                            }

                            SlateAlert {
                                variant: "destructive";
                                title: "Error";
                                message: "Failed to synchronize with database replica. Retrying in 15 seconds.";
                            }

                            SlateAlert {
                                variant: "success";
                                title: "Success";
                                message: "4,096 records ingested into data warehouse successfully.";
                            }

                            SlateAlert {
                                variant: "warning";
                                title: "Warning";
                                message: "API key expires in 3 days. Please rotate credentials.";
                            }
                        }
                    }

                    SlateWebCard {
                        title: "Toast Notifications";
                        description: "Press a button to pop a toast in the bottom-right corner; it auto-dismisses after 4 seconds";

                        HorizontalLayout {
                            spacing: SlateTheme.spacing-md;
                            alignment: start;

                            SlateButton { text: "Default toast"; variant: SlateButtonVariant.outline; clicked => { toast-host.show("Notification", "This is a default toast message.", SlateToastVariant.default); } }
                            SlateButton { text: "Success"; variant: SlateButtonVariant.secondary; clicked => { toast-host.show("Success", "Operation completed successfully.", SlateToastVariant.success); } }
                            SlateButton { text: "Error"; variant: SlateButtonVariant.destructive; clicked => { toast-host.show("Error", "Something went wrong. Please try again.", SlateToastVariant.error); } }
                            SlateButton { text: "Warning"; variant: SlateButtonVariant.secondary; clicked => { toast-host.show("Warning", "Your session expires in 5 minutes.", SlateToastVariant.warning); } }
                            SlateButton { text: "Info"; variant: SlateButtonVariant.secondary; clicked => { toast-host.show("Info", "A new version is available.", SlateToastVariant.info); } }
                        }
                    }

                    SlateWebCard {
                        title: "Progress";
                        description: "Linear determinate progress indicator";

                        VerticalLayout {
                            spacing: SlateTheme.spacing-sm;

                            ShowcaseValueRow { label: "Sync Progress"; value: "60%"; }

                            SlateProgressBar {
                                progress: 0.60;
                            }
                        }
                    }

                    SlateWebCard {
                        title: "Skeleton Loading Placeholders";
                        description: "Pulsing content skeletons while asynchronous resources load";

                        HorizontalLayout {
                            spacing: SlateTheme.spacing-md;
                            alignment: start;

                            SlateSkeleton {
                                width: 44px;
                                height: 44px;
                                border-radius: 22px;
                            }

                            VerticalLayout {
                                spacing: SlateTheme.spacing-sm;
                                alignment: center;

                                SlateSkeleton { width: 280px; height: 16px; }
                                SlateSkeleton { width: 180px; height: 12px; }
                            }
                        }
                    }
                }

                // ==========================================
                // TAB 4: NAVIGATION
                // ==========================================
                if root.active-tab == 4 : VerticalLayout {
                    spacing: SlateTheme.spacing-lg;

                    SlateWebCard {
                        title: "Breadcrumbs";
                        description: "Hierarchical trail showing navigation context";

                        HorizontalLayout {
                            spacing: SlateTheme.spacing-sm;
                            alignment: start;

                            Text { text: "Home"; font-size: SlateTheme.font-sm; color: SlateTheme.accent-primary; }
                            Text { text: "/"; font-size: SlateTheme.font-sm; color: SlateTheme.text-muted; }
                            Text { text: "Components"; font-size: SlateTheme.font-sm; color: SlateTheme.accent-primary; }
                            Text { text: "/"; font-size: SlateTheme.font-sm; color: SlateTheme.text-muted; }
                            Text { text: "Buttons & Badges"; font-size: SlateTheme.font-sm; font-weight: 600; color: SlateTheme.text-primary; }
                        }
                    }

                    SlateWebCard {
                        title: "Pagination Bar";
                        description: "Page step controls with active page highlights, ellipses and boundary buttons";

                        VerticalLayout {
                            spacing: SlateTheme.spacing-md;

                            SlatePagination {
                                current-page <=> root.demo-page;
                                total-pages: 10;
                            }

                            Text {
                                text: "Page " + root.demo-page + " of 10  ·  Showing items " + root.demo-page-first + "–" + root.demo-page-last + " of 78";
                                font-size: SlateTheme.font-sm;
                                color: SlateTheme.text-secondary;
                            }
                        }
                    }

                    SlateWebCard {
                        title: "Menubar & Action Bar";
                        description: "Top-level application menus with keyboard shortcuts — click a menu, then pick an item";

                        VerticalLayout {
                            spacing: SlateTheme.spacing-md;

                            menubar := SlateMenubar {
                                z: 100;
                                menus: root.demo-menus;
                            }

                            Text {
                                text: menubar.last-action == "" ? "Last action: (none yet)" : "Last action: " + menubar.last-action;
                                font-size: SlateTheme.font-sm;
                                color: SlateTheme.text-secondary;
                            }

                            // Room below so the open dropdown stays inside the scrolled content
                            Rectangle { height: 140px; }
                        }
                    }
                }

                // ==========================================
                // TAB 5: OVERLAYS
                // ==========================================
                if root.active-tab == 5 : VerticalLayout {
                    spacing: SlateTheme.spacing-lg;

                    SlateWebCard {
                        title: "Dialog / Modal Overlay";
                        description: "Modal window overlay with dimmed backdrop and action controls";

                        HorizontalLayout {
                            alignment: start;

                            SlateButton {
                                text: "Launch Confirmation Modal";
                                variant: SlateButtonVariant.primary;
                                clicked => { root.modal-open = true; }
                            }
                        }
                    }

                    SlateWebCard {
                        title: "Drawer & Sheet";
                        description: "Slide-out panel container for contextual actions or inspectors";

                        Rectangle {
                            height: 72px;
                            border-radius: SlateTheme.radius-md;
                            background: SlateTheme.surface-2;
                            border-width: 1px;
                            border-color: SlateTheme.border-subtle;

                            HorizontalLayout {
                                padding: SlateTheme.spacing-md;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "Slide-out Sheet Inspector"; font-size: 14px; font-weight: 600; color: SlateTheme.text-primary; }
                                    Text { text: "Inspect element properties or perform secondary workflows."; font-size: 12px; color: SlateTheme.text-muted; }
                                }

                                SlateButton {
                                    text: "Open drawer";
                                    variant: SlateButtonVariant.outline;
                                    size: SlateButtonSize.sm;
                                    clicked => { root.drawer-open = true; }
                                }
                            }
                        }
                    }
                }

                // ==========================================
                // TAB 6: COMPONENTS (KPIs & COMPUTE ENGINE)
                // ==========================================
                if root.active-tab == 6 : VerticalLayout {
                    spacing: SlateTheme.spacing-lg;

                    SlateWebCard {
                        title: "High-Impact KPI Metric Cards";
                        description: "Live system metrics, delta indicators, and status trends";

                        HorizontalLayout {
                            spacing: SlateTheme.spacing-md;

                            SlateMetricCard {
                                title: "Compute Throughput";
                                value: "148.5 TFLOPS";
                                delta: "+24.8%";
                                delta-positive: true;
                                description: "Hardware accelerated";
                            }

                            SlateMetricCard {
                                title: "Background Tasks";
                                value: "2,420";
                                delta: "+180";
                                delta-positive: true;
                                description: "Threads actively working";
                            }

                            SlateMetricCard {
                                title: "Render Latency";
                                value: "1.42 ms";
                                delta: "-12.4%";
                                delta-positive: true;
                                description: "FemtoVG & Software";
                            }
                        }
                    }

                    SlateWebCard {
                        title: "Multi-threaded Background Calculation Engine";
                        description: "High-performance compute executed on Rust background thread pool without blocking UI";

                        VerticalLayout {
                            spacing: SlateTheme.spacing-md;

                            HorizontalLayout {
                                spacing: SlateTheme.spacing-md;
                                alignment: start;

                                SlateButton {
                                    text: "Start Heavy Calculation";
                                    variant: SlateButtonVariant.primary;
                                    enabled: !root.compute-running;
                                    clicked => { root.start-compute(); }
                                }

                                SlateButton {
                                    text: "Cancel";
                                    variant: SlateButtonVariant.destructive;
                                    enabled: root.compute-running;
                                    clicked => { root.cancel-compute(); }
                                }
                            }

                            if root.compute-running : VerticalLayout {
                                spacing: SlateTheme.spacing-xs;

                                ShowcaseValueRow { label: "Compute Progress"; value: Math.round(root.compute-progress * 100.0) + "%"; font-size: 12px; }

                                SlateProgressBar { progress: root.compute-progress; }
                            }

                            Rectangle {
                                border-radius: SlateTheme.radius-sm;
                                background: SlateTheme.surface-2;
                                border-width: 1px;
                                border-color: SlateTheme.border-subtle;

                                VerticalLayout {
                                    padding: SlateTheme.spacing-md;
                                    spacing: 4px;

                                    Text {
                                        text: "Status: " + root.compute-status;
                                        font-size: SlateTheme.font-sm;
                                        color: SlateTheme.text-primary;
                                    }

                                    Text {
                                        text: "Result: " + root.compute-result;
                                        font-size: SlateTheme.font-sm;
                                        font-weight: 600;
                                        color: SlateTheme.accent-primary;
                                    }
                                }
                            }
                        }
                    }

                    SlateWebCard {
                        title: "System Status & Microservices";
                        description: "Real-time health telemetry across the application infrastructure";

                        SlateStatusPage {
                            title: "Slate Engine Infrastructure";
                            description: "All 4 clusters operational with 99.98% uptime across regions.";
                        }
                    }
                }
            }
        }
    }

    // Modal Confirmation Dialog Overlay
    SlateModal {
        is-open: root.modal-open;
        title: "Confirm Action";
        description: "Are you sure you want to proceed with this operation? This will execute a synchronous job and synchronize changes across all nodes.";
        confirm-text: "Proceed";
        cancel-text: "Cancel";
        confirmed => {
            root.modal-open = false;
        }
        cancelled => {
            root.modal-open = false;
        }
        closed => {
            root.modal-open = false;
        }
    }

    SlateDrawer {
        open <=> root.drawer-open;
        title: "Edit profile";
        description: "Update the display name and notification preferences.";
        panel-width: 380px;

        VerticalLayout {
            spacing: SlateTheme.spacing-md;
            alignment: start;

            SlateInput {
                label: "Display name";
                placeholder: "Your name";
                text <=> root.demo-drawer-name;
            }

            HorizontalLayout {
                alignment: start;
                SlateSwitch {
                    text: "Email notifications";
                    checked <=> root.demo-drawer-notify;
                }
            }

            HorizontalLayout {
                spacing: SlateTheme.spacing-sm;
                alignment: end;

                SlateButton { text: "Cancel"; variant: SlateButtonVariant.outline; clicked => { root.drawer-open = false; } }
                SlateButton { text: "Save"; variant: SlateButtonVariant.primary; clicked => {
                    root.drawer-open = false;
                    toast-host.show("Profile saved", "Changes were applied.", SlateToastVariant.success);
                } }
            }
        }
    }

    // Must be the last child so toasts paint above everything else
    toast-host := SlateToastHost { }
}
