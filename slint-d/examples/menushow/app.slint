import { SlateMenubar, SlateTheme } from "index.slint";

export component MainWindow inherits Window {
    title: "Slate Menus (D)";
    width: 900px;
    height: 640px;
    background: SlateTheme.background;
    default-font-family: "DejaVu Sans";

    VerticalLayout {
        bar := SlateMenubar {
            // File menu starts open so the screenshot shows a dropdown.
            open-menu: 0;
            z: 100;
        }

        Rectangle {
            background: SlateTheme.surface-1;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Slate menus, driven from DLang";
                    font-size: 24px;
                    font-weight: 700;
                    color: SlateTheme.text-primary;
                }
                Text {
                    text: "Last action: " + (bar.last-action == "" ? "—" : bar.last-action);
                    font-size: 15px;
                    color: SlateTheme.text-secondary;
                }
            }
        }
    }
}
